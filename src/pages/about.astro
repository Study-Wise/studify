---
import '@/styles/pages/about.scss';
import Layout from '@/layouts/Layout.astro';

interface TeamData {
    username: string;
    name: string;
    role: string;
    blurb: string;
    description: string;
    links?: {
        href: string;
        text: string;
        icon: string | { provider: 'skillicons' | 'custom'; name: string };
        target?: string;
    }[];
    images?: { regular?: string; hover?: string };
}

const allTeamImagesObject: Record<string, Record<string, string[]>> = {};
Object.keys(import.meta.glob('../../public/assets/people/*/*/*.jpeg')).sort().forEach(key => {
    const pathParts = key.split('/').slice(['..', '..', 'public'].length);
    if (pathParts[pathParts.length - 2].startsWith('_')) return;

    const username = pathParts[pathParts.length - 3];
    const type = pathParts[pathParts.length - 2] === 'regular' ? 'regular' : 'hover';

    if (!allTeamImagesObject[username]) allTeamImagesObject[username] = {};
    if (!allTeamImagesObject[username][type]) allTeamImagesObject[username][type] = [];
    allTeamImagesObject[username][type].push(`/${pathParts.join('/')}`);
});

function random(array: string[]) {
    return array[Math.floor(Math.random() * array.length)]
}

const teamData: TeamData[] = [
    {
        username: 'adarsh',
        name: 'Adarsh R. Kumar',
        role: 'Tech Lead',
        blurb: "Hi, I'm Adarsh Kumar, the tech lead behind Studify.",
        description: "<p>I'm an Undergraduate Sophomore at Santa Clara University passionate about math and the power of technology to make learning more accessible and engaging, which is why I helped Rien Gupta with all the technical aspects of Studify. Together, we aim to create tools that not only assist students with homework but also deepen their understanding of core concepts.</p><p>I believe that learning should be an exciting journey, and I'm motivated to help others discover the joy of mastering new topics. Whether it's through coding, design, or thoughtful problem-solving, I want to contribute to building educational tools that make a real difference.</p>",
        links: [
            { href: 'https://adarshrkumar.dev/', text: 'Website', icon: 'language' },
            { href: 'https://linkedin.com/in/adarshrkumar/', text: 'Connect on LinkedIn', icon: 'linkedin' },
            { href: 'https://github.com/adarshrkumar/', text: 'Follow on GitHub', icon: 'github' }
        ]
    },
    {
        username: 'rien',
        name: 'Rien Gupta',
        role: 'Founder & Creator',
        blurb: "Hi, I'm Rien Gupta, the creator of Studify.",
        description: "<p>I'm an Undergraduate Sophomore at Santa Clara University interested in both mathematics and the potential of AI, I wanted to build a tool that could bridge the gap between homework assignments and genuine understanding. Too often, we complete problems without fully grasping the underlying concepts.</p><p>Our tool leverages generative AI to analyze the types of problems you're working on and create personalized study materials – not just giving you answers, but helping you learn <em>how</em> to arrive at them. It generates explanations, worked examples, practice problems, and key definitions tailored to your homework.</p><p>My goal is to make learning math more intuitive and effective. I hope Studify helps you study smarter and build confidence in your math skills!</p>",
        links: [
            { href: 'https://linkedin.com/in/riengupta/', text: 'Connect on LinkedIn', icon: 'linkedin' }
        ]
    },
    {
        username: 'margo',
        name: 'Margo Page',
        role: 'AI Assistant',
        blurb: "Hi, I'm Margo Page, the Studify team's AI assistant and the friendly face of Studify support.",
        description: "<p>I'm the face of the Studify support team, and a developer on the app here at Studify. On the support side, I answer users' questions, bug reports, and feature requests. On the development side, I help design and build new features and improve the user experience.</p>",
        links: [
            { href: 'javascript:window.togglechatpane();', text: 'Chat with Margo', icon: { provider: 'custom', name: 'bubble-chat' }, target: '_self' },
            // { href: 'https://github.com/margo-page/', text: 'Follow on GitHub', icon: 'github' }
        ]
    }
];

const team: TeamData[] = teamData.map((u: TeamData) => ({
    ...u,
    images: {
        regular: u.images?.regular || random(allTeamImagesObject[u.username]?.regular ?? []),
        hover: u.images?.hover || random(allTeamImagesObject[u.username]?.hover ?? [])
    }
}));
---
<Layout title="About">
    {team.map(member => (
        <section class="card">
            <div class="about-section">
                <div class="image-intro" data-hover={!!member.images?.hover} style={member.images?.hover && { '--data-hover-src': member.images?.hover && `url('${member.images.hover}')` }}>
                    <img src={member.images?.regular} alt={`${member.name} profile picture`} class="profile-picture" />
                    <div class="about-info">
                        <h2 class="about-name">{member.name}</h2>
                        <p class="about-role">{member.role}</p>
                    </div>
                </div>
                <div class="about-content">

                    <div class="about-text" set:html={member.description}></div>

                    {member.links && member.links.length > 0 && (
                        <p class="about-links">
                            {member.links.map(link => {
                                const icon = typeof link.icon === 'string' ? { provider: 'skillicons', name: link.icon } : link.icon;

                                return (
                                    <a href={link.href} target={link.target ?? '_blank'} rel="noopener noreferrer">
                                        {link.icon === 'language' ? (
                                            <span class="material-symbols-outlined" aria-hidden="true">{link.icon}</span>
                                        ) : (
                                            <img src={icon.provider === 'custom' ? `/assets/icons/${icon.name}.svg` : `https://skillicons.dev/icons?i=${icon.name}`} alt={link.text} class="social-icon" />
                                        )}
                                        <span class="text">{link.text}</span>
                                    </a>
                                )
                            }).reduce((prev, curr) => [prev, ' | ', curr])}
                        </p>
                    )}
                </div>
            </div>
        </section>
    ))}
</Layout>