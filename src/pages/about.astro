---
import '@/styles/pages/about.scss';
import Layout from '@/layouts/Layout.astro';

const allTeamImages = import.meta.glob('../../public/assets/people/*/*/*.jpeg');
const allTeamImagesObject: Record<string, Record<string, string[]>> = {};
Object.keys(allTeamImages).sort().forEach(key => {
    const pathParts = key.split('/').slice(['..', '..', 'public'].length);
    const username = pathParts[pathParts.length - 3];
    const type = pathParts[pathParts.length - 2];

    if (!allTeamImagesObject[username]) allTeamImagesObject[username] = {};
    if (!allTeamImagesObject[username][type]) allTeamImagesObject[username][type] = [];
    allTeamImagesObject[username][type].push(`/${pathParts.join('/')}`);
});

function random(array: string[]) {
    return array[Math.floor(Math.random() * array.length)]
}
const regularKey = 'regular';
function getRegularImage(username: string) {
    return random(allTeamImagesObject[username][regularKey])
};
function   getHoverImage(username: string) {
    const hoverKey = random(Object.keys(allTeamImagesObject[username]).filter(key => key !== regularKey && !key.startsWith('_')));
    if (!hoverKey) return undefined;
    return random(allTeamImagesObject[username][  hoverKey])
};

interface TeamData {
    username: string;
    name: string;
    role: string;
    images?: {
        regular?: string;
        hover?: string;
    };
    blurb: string;
    description: string;
    links: { href: string; text: string; icon: string }[];
}

const team: TeamData[] = [
    {
        username: 'adarsh',
        name: 'Adarsh R. Kumar',
        role: 'Tech Lead',
        blurb: "Hi, I'm Adarsh Kumar, the tech lead behind Studify.",
        description: "<p>I'm an Undergraduate Sophomore at Santa Clara University.</p><p>I helped Rien Gupta with all the technical aspects of Studify because I'm passionate about math and the power of technology to make learning more accessible and engaging. Together, we aim to create tools that not only assist students with homework but also deepen their understanding of core concepts.</p><p>I believe that learning should be an exciting journey, and I'm motivated to help others discover the joy of mastering new topics. Whether it's through coding, design, or thoughtful problem-solving, I want to contribute to building educational tools that make a real difference.</p>",
        links: [
            { href: 'https://adarshrkumar.dev/', text: 'Website', icon: 'language' },
            { href: 'https://linkedin.com/in/adarshrkumar/', text: 'Connect on LinkedIn', icon: 'linkedin' },
            { href: 'https://github.com/adarshrkumar/', text: 'Follow on GitHub', icon: 'github' }
        ]
    },
    {
        username: 'rien',
        name: 'Rien Gupta',
        role: 'Founder & Creator',
        blurb: "Hi, I'm Rien Gupta, the creator of Studify.",
        description: "<p>I'm an Undergraduate Sophomore at Santa Clara University</p><p>As a student interested in both mathematics and the potential of AI, I wanted to build a tool that could bridge the gap between homework assignments and genuine understanding. Too often, we complete problems without fully grasping the underlying concepts.</p><p>Our tool leverages generative AI to analyze the types of problems you're working on and create personalized study materials – not just giving you answers, but helping you learn <em>how</em> to arrive at them. It generates explanations, worked examples, practice problems, and key definitions tailored to your homework.</p><p>My goal is to make learning math more intuitive and effective. I hope Studify helps you study smarter and build confidence in your math skills!</p>",
        links: [
            { href: 'https://linkedin.com/in/riengupta/', text: 'Connect on LinkedIn', icon: 'linkedin' }
        ]
    },
    {
        username: 'margo',
        name: 'Margo Page',
        role: 'AI Assistant',
        blurb: "Hi, I'm Margo Page, the Studify team's AI assistant and the friendly face of Studify support.",
        description: "<p>I'm the face of the Studify support team, and a developer on the app here at Studify. On the support side, I answer users' questions, bug reports, and feature requests. On the development side, I help design and build new features and improve the user experience.</p>",
        links: [
            { href: 'https://github.com/margo-page/', text: 'Follow on GitHub', icon: 'github' }
        ]
    }
].map((u: TeamData) => ({
    ...u,
    images: {
        regular: u.images?.regular || getRegularImage(u.username),
        hover: u.images?.hover || getHoverImage(u.username)
    }
}));
---
<Layout title="About">
    {team.map(member => (
        <section class="about-section card">
            {/* <h2>
                <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>&nbsp;About {member.name}
            </h2> */}
            <div class="image-intro" style={{ '--data-hover': member.images?.hover ? 1: 0, '--data-hover-src': `url('${member.images?.hover || ''}')` }}>
                <img src={member.images?.regular} alt={`${member.name} profile picture`} class="profile-picture" />
                <p>{member.blurb}</p>
            </div>
            <div class="about-content">

                <div class="about-text" set:html={member.description}></div>

                {member.links && member.links.length > 0 && (
                    <p class="about-links">
                        {member.links.map(link => (
                            <a href={link.href} target="_blank" rel="noopener noreferrer">
                                {link.icon === 'language' ? (
                                    <span class="material-symbols-outlined" aria-hidden="true">{link.icon}</span>
                                ) : (
                                    <img src={`https://skillicons.dev/icons?i=${link.icon}`} alt={link.text} class="social-icon" />
                                )}
                                <span class="text">{link.text}</span>
                            </a>
                        )).reduce((prev, curr) => [prev, ' | ', curr])}
                    </p>
                )}
            </div>
        </section>
    ))}
</Layout>