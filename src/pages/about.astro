---
import teamData from '@/content/team-members.json' with { type: 'json' };

import '@/styles/pages/about.scss';
import Layout from '@/layouts/Layout.astro';

interface TeamData {
    username: string;
    name: string;
    role: string;
    subrole?: string;
    blurb: string;
    description: string[];
    links?: {
        href: string;
        text: string;
        icon: string | { provider: string; name: string };
        target?: string;
    }[];
    images?: { regular?: string; hover?: string };
}

const allTeamImagesObject: Record<string, Record<string, string[]>> = {};
Object.keys(import.meta.glob('../../public/assets/people/*/*/*.jpeg')).sort().forEach(key => {
    const pathParts = key.split('/').slice(['..', '..', 'public'].length);
    if (pathParts[pathParts.length - 2].startsWith('_')) return;

    const username = pathParts[pathParts.length - 3];
    const type = pathParts[pathParts.length - 2] === 'regular' ? 'regular' : 'hover';

    if (!allTeamImagesObject[username]      ) allTeamImagesObject[username]       = {};
    if (!allTeamImagesObject[username][type]) allTeamImagesObject[username][type] = [];
         allTeamImagesObject[username][type].push(`/${pathParts.join('/')}`);
});

function random(array: string[]) {
    return array[Math.floor(Math.random() * array.length)]
}

const team: TeamData[] = teamData.map((u: TeamData) => ({
    ...u,
    images: {
        regular: u.images?.regular || random(allTeamImagesObject[u.username]?.regular ?? []),
        hover: u.images?.hover || random(allTeamImagesObject[u.username]?.hover ?? [])
    }
}));
---
<Layout title="About">
    {team.map(member => (
        <section class="card">
            <div class="about-section">
                <div class="image-intro" data-hover={!!member.images?.hover ? true : undefined} style={member.images?.hover && { '--data-hover-src': member.images?.hover && `url('${member.images.hover}')` }}>
                    {member.images?.regular && <img src={member.images?.regular} alt={`${member.name} profile picture`} class="profile-picture" />}
                    {(member.name || member.role || member.subrole) && <div class="about-info">
                        {member.name && <h2 class="about-name">{member.name}</h2>}
                        {member.role && <p class="about-role">{member.role}</p>}
                        {member.subrole && <p class="about-subrole">{member.subrole}</p>}
                    </div>}
                </div>
                <div class="about-content">

                    <div class="about-text">
                        {member.blurb && <p set:html={member.blurb} />}
                        {member.description && member.description.length > 0 && member.description.map(p => <p  set:html={p} />)}
                    </div>

                    {member.links && member.links.length > 0 && (
                        <p class="about-links">
                            {member.links.map(link => {
                                const icon = typeof link.icon === 'string' ? { provider: 'skillicons', name: link.icon } : link.icon;

                                return (
                                    <a href={link.href} target={link.target ?? '_blank'} rel="noopener noreferrer">
                                        {link.icon === 'language' ? (
                                            <span class="material-symbols-outlined" aria-hidden="true">{link.icon}</span>
                                        ) : (
                                            <img src={icon.provider === 'custom' ? `/assets/icons/${icon.name}.svg` : `https://skillicons.dev/icons?i=${icon.name}`} alt={link.text} class="social-icon" />
                                        )}
                                        <span class="text">{link.text}</span>
                                    </a>
                                )
                            }).reduce((prev, curr) => [prev, ' | ', curr])}
                        </p>
                    )}
                </div>
            </div>
        </section>
    ))}
</Layout>