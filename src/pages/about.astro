---
import '@/styles/pages/about.scss';
import Layout from '@/layouts/Layout.astro';

const regularMargoImages = import.meta.glob('../../public/assets/people/margo/regular/*.jpeg');
const regularMargoImageArray = Object.keys(regularMargoImages)
    .sort()
    .map(key => `/assets/people/margo/${key.split('/').pop()}`);
const randomRegularMargo = regularMargoImageArray[1 + Math.floor(Math.random() * (regularMargoImageArray.length - 1))];

const playfulMargoImages = import.meta.glob('../../public/assets/people/margo/playful/*.jpeg');
const playfulMargoImageArray = Object.keys(playfulMargoImages)
    .sort()
    .map(key => `/assets/people/margo/${key.split('/').pop()}`);
const randomPlayfulMargo = playfulMargoImageArray[1 + Math.floor(Math.random() * (playfulMargoImageArray.length - 1))];
---
<Layout title="About">
    <section class="about-section card">
        <h2>
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>&nbsp;About Adarsh R. Kumar
        </h2>
        <div class="about-content">
            <div class="image-intro">
                <img src="/assets/people/adarsh.jpeg" alt="Adarsh Kumar profile picture" class="profile-picture" />
                <p>Hi, I'm Adarsh Kumar, I'm an Undergraduate Sophomore at Santa Clara University, and the tech lead behind Studify.</p>
            </div>

            <div class="about-text">
                <p>I helped Rien Gupta with all the technical aspects of Studify because I'm passionate about math and the power of technology to make learning more accessible and engaging. Together, we aim to create tools that not only assist students with homework but also deepen their understanding of core concepts.</p>
                <p>I believe that learning should be an exciting journey, and I'm motivated to help others discover the joy of mastering new topics. Whether it's through coding, design, or thoughtful problem-solving, I want to contribute to building educational tools that make a real difference.</p>
                <p>
                    <a href="https://adarshrkumar.dev/" target="_blank" rel="noopener noreferrer"><span class="material-symbols-outlined" aria-hidden="true">language</span> <span class="text">Website</span></a> |
                    <a href="https://linkedin.com/in/adarshrkumar/" target="_blank" rel="noopener noreferrer"><img src="https://skillicons.dev/icons?i=linkedin" alt="LinkedIn" class="social-icon" /> <span class="text">Connect on LinkedIn</span></a> |
                    <a href="https://github.com/adarshrkumar" target="_blank" rel="noopener noreferrer"><img src="https://skillicons.dev/icons?i=github" alt="GitHub" class="social-icon" /> <span class="text">GitHub</span></a>
                </p>
            </div>
        </div>
    </section>

    <section class="about-section card">
        <h2>
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>&nbsp;About Rien Gupta
        </h2>

        <div class="about-content">
            <div class="image-intro">
                <img src="/assets/people/rien.jpeg" alt="Rien Gupta profile picture" class="profile-picture" />
                <p>Hi, I'm Rien Gupta, I'm also an Undergraduate Sophomore at Santa Clara University, and the creator of Studify.</p>
            </div>

            <div class="about-text">
                <p>As a student interested in both mathematics and the potential of AI, I wanted to build a tool that could bridge the gap between homework assignments and genuine understanding. Too often, we complete problems without fully grasping the underlying concepts.</p>
                <p>Our tool leverages generative AI to analyze the types of problems you're working on and create personalized study materials – not just giving you answers, but helping you learn <em>how</em> to arrive at them. It generates explanations, worked examples, practice problems, and key definitions tailored to your homework.</p>
                <p>My goal is to make learning math more intuitive and effective. I hope Studify helps you study smarter and build confidence in your math skills!</p>
                <p>Feel free to connect with us or provide feedback!</p>
                <p>
                    <a href="https://linkedin.com/in/riengupta/" target="_blank" rel="noopener noreferrer"><img src="https://skillicons.dev/icons?i=linkedin" alt="LinkedIn" class="social-icon" /> <span class="text">Connect on LinkedIn</span></a>{/* | */}
                    {/*<a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer"><img src="https://skillicons.dev/icons?i=github" alt="GitHub" class="social-icon" /> <span class="text">GitHub</span></a><br>*/}
                </p>
            </div>
        </div>
    </section>

    <section class="about-section card">
        <h2>
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>&nbsp;About Margo Page
        </h2>

        <div class="about-content">
            <div class="image-intro" style={{ '--data-hover': 1, '--data-hover-src': `url('${randomPlayfulMargo}')` }}>
                <img src={randomRegularMargo} alt="Margo Page profile picture" class="profile-picture" />
                <p>Hi, I'm Margo Page, the Studify team's AI assistant and the friendly face of Studify support.</p>
            </div>

            <div class="about-text">
                <p>I'm the face of the Studify support team, so I reply to users' support questions, bug reports, and feature requests. I also work on the app itself, helping to design and build new features and improve the user experience.</p>
            </div>
        </div>
    </section>
</Layout>