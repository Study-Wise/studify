---
import '@/styles/pages/404.scss';
import Layout from '@/layouts/Layout.astro';

const currentUrl = Astro.request.url;
---
<Layout title="Page Not Found">
    <div class="error-404">
        <div class="error-404__content card">
            <div class="error-404__icon">
                <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
            </div>
            <h1 class="error-404__title">404</h1>
            <h2 class="error-404__subtitle">Page Not Found</h2>
            <p class="error-404__message">Oops! The page you're looking for doesn't exist or has been moved.</p>
            <div class="error-404__actions">
                <a href="/" class="btn" data-variant="primary">
                    <span class="material-symbols-outlined" aria-hidden="true">home</span>
                    Go Home
                </a>
                <a href="javascript:history.back()" class="btn" data-variant="secondary">
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    Go Back
                </a>
            </div>
        </div>
    </div>
    <script is:inline define:vars={{ currentUrl }}>
        // This avoids unnecessary noise from legitimate 404s (bots, mistyped URLs)
        if (typeof window !== 'undefined' && window.Sentry) {
            window.Sentry.addBreadcrumb({
                category: 'navigation',
                message: `404 page accessed: ${currentUrl}`,
                level: 'info',
                data: {
                    url: currentUrl,
                    referrer: document.referrer || 'none',
                    isInternalReferrer: document.referrer && document.referrer.startsWith(window.location.origin)
                }
            });

            // This helps identify broken internal links without noise from external 404s
            if (document.referrer && document.referrer.startsWith(window.location.origin)) {
                window.Sentry.captureMessage(
                    `Potential broken internal link: ${currentUrl}`,
                    'warning'
                );
            }
        }
    </script>
</Layout>
