---
import Layout from '../../layouts/Layout.astro';

import ChatHeader from '../../components/ChatHeader.astro';
import FancyOutput from '../../components/fancy/Output.astro';
import ChatToolbar from '../../components/ChatToolbar.astro';
import ChatSidebar from '../../components/ChatSidebar.astro';

import MessagesScript from '../../scripts/messages.astro';
import '../../styles/pages/chat.scss';

import { getMessages, getMessagesLength } from '../../lib/threads';
import extract from '../../lib/extractPartsofMessage';
import Footer from '../../components/Footer.astro';
import { getUserRole } from '../../lib/auth-utils';
import { db } from '../../db/initialize';
import { eq } from 'drizzle-orm';
import { threadsTable } from '../../db/schema';

let threadId = Astro.params.id || '';

// Use Clerk authentication
const auth = (Astro.locals as any).auth;
const { userId, sessionClaims } = auth();
const user_email = sessionClaims?.email as string || null;

// Redirect to sign-in if not authenticated
if (!userId) {
    return Astro.redirect("/user/sign-in");
}

// Get user role and check if admin
const userRole = getUserRole(auth);
const isUserAdmin = userRole === 'admin';

// Check thread ownership
let threadOwner: string | null = null;
let isPublicThread = false;
if (threadId) {
    try {
        const threads = await db.select().from(threadsTable).where(eq(threadsTable.id, threadId));
        if (threads.length > 0) {
            threadOwner = threads[0].email;
            isPublicThread = threads[0].isPublic;
            // If unclaimed and user is authenticated, claim ownership
            // TODO: Fix claiming unclaimed threads
            if (!threadOwner && user_email) {
                try {
                    await db.update(threadsTable)
                        .set({ email: user_email, updatedAt: new Date() })
                        .where(eq(threadsTable.id, threadId));
                    threadOwner = user_email;
                } catch (e) {
                    console.error('Error claiming thread ownership:', e);
                }
            }
        }
    } catch (error) {
        console.error('Error fetching thread:', error);
    }
}

// Check if user owns the thread or is admin
const messagesLength = await getMessagesLength(threadId);
const isAuthorized = threadId && messagesLength > 0 && ((threadOwner && threadOwner === user_email) || !threadOwner || isUserAdmin);
const messages = !isAuthorized ? [] : await getMessages(threadId, user_email);
const isPublic = !isAuthorized && isPublicThread;


export const inNav = 'hide';
---
<Layout title="Chat" container={false} isChatArea={true} additionalClasses={['chat-page']} hideCopyright={true}>
    <div id="user-email" data-email={user_email} style="display: none;"></div>
    <header class="chat-header">
        <h2><span class="material-symbols-outlined">chat</span>&nbsp;Chat</h2>
        <ChatHeader pTitle={`${threadId ? 'Chat' : 'New Chat'}`} />
    </header>
    <section class="chat-container">
        <ChatSidebar />
        <section class="chat-section">
            <label class="chat-sidebar-toggle">
                <input type="checkbox" />
                <span class="material-symbols-outlined">chat</span>
            </label>
            <div class="chat-messages">
                {isAuthorized || isPublic ? (
                    messages.map(async message => {
                        const { obj, generatedText: htmlText } = await extract(message.content);
                        var content = htmlText;
                        if (!(message.role === 'assistant' && obj.studyGuide || obj.referenceSheet)) {
                            return <div class={`message ${message.role}`}>
                                <div class={`message-content ${message.role === 'user' ? 'bg-primary' : ''}`} set:html={content} />
                            </div>
                        }

                        if (message.role === 'assistant') {
                            if (obj.studyGuide || obj.referenceSheet) {
                                return <div class={`message ${message.role}`}>
                                    <div class="message-content">
                                        { obj.precedingText && <div class="message-content-inner" set:html={obj.precedingText} /> }
                                        <FancyOutput obj={obj} />
                                        { obj.followingText && <div class="message-content-inner" set:html={obj.followingText} /> }
                                    </div>
                                </div>              
                            }
                        }
                    })
                ) : (
                    <div class="unauthorized-message">
                        <div class="message assistant">
                            <div class="message-content">
                                <div class="unauthorized-content">
                                    <h3>Access Denied</h3>
                                    <p>You don't have permission to view this conversation. This thread belongs to another user.</p>
                                    <a href="/" class="btn-primary">Go Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
            {isAuthorized && <ChatToolbar />}
            <Footer />
        </section>
    </section>
    <script is:inline>
        window.onFancyOutput = () => {
            const allOutputs = document.querySelectorAll('.fancy-output');
            allOutputs.forEach(output => {
                const openBtn = output.querySelector('.buttons .button.open-button');
                if (openBtn) {
                    openBtn.addEventListener('click', () => {
                        if (!output.getAttribute('open')) {
                            output.showModal();
                        }
                        if (output.getAttribute('open')) {
                            output.close();
                        }
                    });
                }
                output.addEventListener('click', (e) => {
                    if (!output.getAttribute('open')) {
                        e.preventDefault();
                        output.showModal();
                    }
                });

            });
        }
        window.addEventListener('load', window.onFancyOutput);
        window.addEventListener('load', () => {
            const chatMessages = document.querySelector('.chat-messages');
            const chatToolbar = document.querySelector('.chat-toolbar');
            
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });

            chatMessages.addEventListener('scroll', () => {
                const scrollPosition = chatMessages.scrollTop;
                const chatMessagesHeight = chatMessages.clientHeight;
                const chatMessagesScrollHeight = chatMessages.scrollHeight;
                const isAtBottom = scrollPosition + chatMessagesHeight >= chatMessagesScrollHeight;

                if (isAtBottom) {
                    chatToolbar.classList.add('at-bottom');
                } else {
                    chatToolbar.classList.remove('at-bottom');
                }
            });
        });
    </script>
    <MessagesScript page="chat" />
</Layout> 