---
import Layout from '../../../../layouts/Layout.astro';
import { getLatestResources } from '../../../../lib/content/latest/resources';
import { checkThreadAccess } from '../../../../lib/auth/checkThreadAccess';
import '../../../../styles/pages/content/resources.scss';
import categories from '../../../../lib/modes';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];
const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const { auth } = Astro.locals;
const { userId } = auth();

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', auth, category, mode, Astro);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!userId && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest resources only if authorized or public
const { content: latestResourcesJSON } = (isAuthorized || isPublic)
    ? await getLatestResources(id || '')
    : { content: null };

// Parse JSON content
let resourcesData = null;
if (latestResourcesJSON) {
    try {
        resourcesData = JSON.parse(latestResourcesJSON);
    } catch (e) {
        console.error('Error parsing resources JSON:', e);
    }
}
---

<Layout title={`Resources | ${modeName} | ${categoryName}`}  container={true}>
    <div class="resources-page">
        {!isAuthorized && !isPublic ? (
            <div class="empty-state">
                <span class="material-symbols-outlined">lock</span>
                <h2>Access Denied</h2>
                <p>You don't have permission to view these resources. This thread belongs to another user.</p>
                <a href="/" class="btn-primary">Go Home</a>
            </div>
        ) : resourcesData ? (
            <div class="content-container">
                <div class="resources-header">
                    <h1 class="resources-title">{resourcesData.topic}</h1>
                    <p class="resources-subtitle">Curated educational resources to enhance your learning</p>
                </div>

                {resourcesData.videos && resourcesData.videos.length > 0 && (
                    <section class="resource-section">
                        <div class="section-header">
                            <span class="material-symbols-outlined">play_circle</span>
                            <h2>Video Tutorials</h2>
                        </div>
                        <div class="resource-grid">
                            {resourcesData.videos.map((resource: any) => (
                                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-card">
                                    <div class="resource-icon video">
                                        <span class="material-symbols-outlined">play_circle</span>
                                    </div>
                                    <div class="resource-content">
                                        <h3 class="resource-title">{resource.title}</h3>
                                        <p class="resource-snippet">{resource.snippet}</p>
                                        <div class="resource-footer">
                                            <span class="resource-source">{resource.source}</span>
                                            <span class="material-symbols-outlined">open_in_new</span>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {resourcesData.articles && resourcesData.articles.length > 0 && (
                    <section class="resource-section">
                        <div class="section-header">
                            <span class="material-symbols-outlined">article</span>
                            <h2>Articles & Guides</h2>
                        </div>
                        <div class="resource-grid">
                            {resourcesData.articles.map((resource: any) => (
                                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-card">
                                    <div class="resource-icon article">
                                        <span class="material-symbols-outlined">article</span>
                                    </div>
                                    <div class="resource-content">
                                        <h3 class="resource-title">{resource.title}</h3>
                                        <p class="resource-snippet">{resource.snippet}</p>
                                        <div class="resource-footer">
                                            <span class="resource-source">{resource.source}</span>
                                            <span class="material-symbols-outlined">open_in_new</span>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {resourcesData.tutorials && resourcesData.tutorials.length > 0 && (
                    <section class="resource-section">
                        <div class="section-header">
                            <span class="material-symbols-outlined">school</span>
                            <h2>Step-by-Step Tutorials</h2>
                        </div>
                        <div class="resource-grid">
                            {resourcesData.tutorials.map((resource: any) => (
                                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-card">
                                    <div class="resource-icon tutorial">
                                        <span class="material-symbols-outlined">school</span>
                                    </div>
                                    <div class="resource-content">
                                        <h3 class="resource-title">{resource.title}</h3>
                                        <p class="resource-snippet">{resource.snippet}</p>
                                        <div class="resource-footer">
                                            <span class="resource-source">{resource.source}</span>
                                            <span class="material-symbols-outlined">open_in_new</span>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )}

                {resourcesData.documentation && resourcesData.documentation.length > 0 && (
                    <section class="resource-section">
                        <div class="section-header">
                            <span class="material-symbols-outlined">menu_book</span>
                            <h2>Documentation & References</h2>
                        </div>
                        <div class="resource-grid">
                            {resourcesData.documentation.map((resource: any) => (
                                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-card">
                                    <div class="resource-icon documentation">
                                        <span class="material-symbols-outlined">menu_book</span>
                                    </div>
                                    <div class="resource-content">
                                        <h3 class="resource-title">{resource.title}</h3>
                                        <p class="resource-snippet">{resource.snippet}</p>
                                        <div class="resource-footer">
                                            <span class="resource-source">{resource.source}</span>
                                            <span class="material-symbols-outlined">open_in_new</span>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        ) : (
            <div class="empty-state">
                <span class="material-symbols-outlined">search</span>
                <h2>No Resources Found</h2>
                <p>There are no resources generated for this conversation yet.</p>
            </div>
        )}
    </div>
</Layout>
