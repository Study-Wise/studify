---
import categories from '@/lib/modes';
import { getThreadAccess } from '@/lib/auth/check-thread-access';
import { getLatestInfographic } from '@/lib/content/latest/infographic';

import ContentActions from '@/components/ContentActions.astro';
import AccessDenied from '@/components/content/AccessDenied.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/globals.scss';
import '@/styles/pages/content/infographic.scss';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const { threadExists } = await getThreadAccess(id || '', Astro.locals.user, category, mode);

if (!threadExists) return new Response(null, { status: 404 });

if (!Astro.locals.user) return Astro.redirect('/user/sign-in');

const infographic = await getLatestInfographic(id || '', Astro.locals.user);

const infographicUrl = infographic?.content?.imageUrl || null;
---
<Layout title={`Infographic | ${modeObj.name} | ${categoryObj.name}`} className="infographic-page content-page">
    {!infographic ? (
        <AccessDenied />
    ) : (
        <>
            <ContentActions threadId={id || ''} hasContent={!!infographicUrl} />
            {infographicUrl ? (
                <div class="content-container">
                    <img src={infographicUrl} alt="Generated Infographic" class="infographic-page__image" />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">image</span>
                    <h2>No Infographic Found</h2>
                    <p>There is no infographic generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
