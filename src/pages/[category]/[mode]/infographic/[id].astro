---
import Layout from '@/layouts/Layout.astro';
import ContentActions from '@/components/ContentActions.astro';
import '@/styles/pages/content/infographic.scss';
import '@/styles/pages/content/globals.scss';

import { getLatestInfographic } from '@/lib/content/latest/infographic';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import categories from '@/lib/modes';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

// Validate category and mode exist
if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const user = Astro.locals.user;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user, category, mode);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!user && !isPublic) {
    return Astro.redirect('/user/sign-in');
}

// Get the infographic only if authorized or public
const infographic = (isAuthorized || isPublic) && id
    ? await getLatestInfographic(id)
    : null;

// Extract URL from uploadthing response
const infographicUrl = infographic?.imageUrl || null;
---

<Layout title={`Infographic | ${modeName} | ${categoryName}`} className="infographic-page content-page">
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this infographic. This thread belongs to another user.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="infographic"
                threadId={id || ''}
                hasContent={!!infographicUrl}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {infographicUrl ? (
                <div class="content-container">
                    <img src={infographicUrl} alt="Generated Infographic" class="infographic-image" />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined">image</span>
                    <h2>No Infographic Found</h2>
                    <p>There is no infographic generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
