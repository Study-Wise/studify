---
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import { checkForOneMessage } from '@/lib/check-for-one-message';
import categories from '@/lib/modes';
import { getMessages, getMessagesLength, getThreadByToken, type Message } from '@/lib/threads';
import { labels } from '@/lib/tools';
import { marked, Marked } from 'marked';

import ChatTitle from '@/components/chat/ChatTitle.astro';
import Header from '@/components/chat/Header.astro';
import LeftSidebar from '@/components/chat/LeftSidebar.astro';
import RightSidebar from '@/components/chat/RightSidebar.astro';
import Toolbar from '@/components/chat/Toolbar.astro';
import Footer from '@/components/Footer.astro';
import Layout from '@/layouts/Layout.astro';
import MessagesScript from '@/scripts/messages.astro';
import StepByStepScript from '@/scripts/step-by-step.astro';
import '@/styles/pages/chat.scss';

let { category, mode, id } = Astro.params || { category: '', mode: '', id: '' };

const categoryObj = categories[category || ''];
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

const user = Astro.locals.user;
const user_email = user?.email || null;

let isAuthorized = id === 'new';
let isPublic = false;

// Admins are authorized to view other users' threads but only the owner can rename them
let isOwner = false;
let isPublicThread = false;

if (id !== 'new') {
    const accessCheck = await checkThreadAccess(id || '', user, category, mode);
    isAuthorized = accessCheck.isAuthorized;
    isPublic = accessCheck.isPublic;
    isOwner = !!user_email && accessCheck.threadOwner === user_email;
    isPublicThread = accessCheck.isPublicThread;

}

// Get thread data to access the title and uploaded files (skip for new chats)
const thread = id !== 'new' ? await getThreadByToken(id ?? '', (isAuthorized || isPublic)) : null;

// Unknown thread IDs pass the access check as unclaimed, so start a fresh chat instead of rendering an empty one
if (id !== 'new' && isAuthorized && !thread) return Astro.redirect(`/${category}/${mode}/chat/new`);

// For new chats, user must be authenticated
if ((id === 'new' && !user) || (!user && !isPublic)) return Astro.redirect(`/user/sign-in?returnBackUrl=${encodeURIComponent(`/${category}/${mode}/chat/${id}`)}`);

const threadTitle = thread?.title || null;
const uploadedFiles = thread?.uploadedFiles || [];

// Get messages only if authorized or public (skip for new chats)
let messages: Message[] = [];
if (id !== 'new') {
    const messagesLength = await getMessagesLength(id || '');
    messages = (isAuthorized || isPublic) && messagesLength > 0 ? await getMessages(id ?? '', (isAuthorized || isPublic)) : [];

    messages = await checkForOneMessage({
        messages,
        threadId: id || '',
        category: category || '',
        mode: mode || '',
        isAuthorized
    });
}

// Pre-process messages to convert markdown to HTML (server-side)
marked.setOptions({ breaks: true, gfm: true });
const userMarked = new Marked({ breaks: true, gfm: true, renderer: { html: ({ text }) => text.replace(/</g, '&lt;') } });
const processedMessages = await Promise.all(
    messages
        .filter(message => message.role !== 'system')
        .map(async message => ({
            role: message.role,
            htmlContent: await (message.role === 'user' ? userMarked : marked).parse(message.content),
            toolCallLog: message.toolCallLog ?? []
        }))
);

// Matches the MathJax delimiters configured in Layout.astro ($…$, $$…$$, \(…\), \[…\])
const mathDelimiterPattern = /\$|\\\(|\\\[/;

export const inNav = 'hide';
---
<Layout title={`${threadTitle || (id === 'new' ? 'New Chat' : 'Chat')} | ${modeName} | ${categoryName}`} container={false} isChatArea={true} className="chat-page" hideCopyright={true} mathjax={true} desmos={modeObj.desmos === true}>
    <header class="chat-header">
        <div class="chat-title-container">
            <ChatTitle title={threadTitle || (id === 'new' ? 'New Chat' : 'Chat')} threadId={id || ''} canRename={isOwner} />
            <nav class="subject-breadcrumb" aria-label="Subject">
                <ol>
                    <li>{categoryName}</li>
                    <li><a href={`/${category}/${mode}`}>{modeName}</a></li>
                </ol>
            </nav>
        </div>
        <Header pTitle={threadTitle || (id === 'new' ? 'New Chat' : 'Chat')} />
    </header>
    <section class="chat-container">
        <LeftSidebar
            isPublic={isPublicThread}
            isAuthorized={isAuthorized}
            threadId={id || ''}
            uploadedFiles={uploadedFiles}
            email={user_email || ''}
            category={category || ''}
            mode={mode || ''}
        />
        <section class="chat-section">
            <div class="chat-messages">
                {isAuthorized && processedMessages.length === 0 ? (
                    <div class="chat-empty-state">
                        {modeObj.icon && <div class="empty-state-icon" aria-hidden="true">{modeObj.icon}</div>}
                        <h3>Let's study {modeName}!</h3>
                        <p>{modeObj.description}. Ask a question below to get started.</p>
                    </div>
                ) : isAuthorized || isPublic ? (
                    processedMessages.map(message => (
                        <>
                            {message.toolCallLog.length > 0 && (
                                <div class="tool-call-log">
                                    {message.toolCallLog.map(entry => (
                                        <div class="tool-call-entry">
                                            <span class="material-symbols-outlined" aria-hidden="true" data-state={entry.status}>
                                                {entry.status === 'success' ? 'check_circle' : 'error'}
                                            </span>
                                            <span class="tool-name">{labels[entry.toolName] ?? entry.toolName}</span>
                                        </div>
                                    ))}
                                </div>
                            )}
                            <div class:list={['message', message.role]}>
                                <div class:list={['message-content', { 'bg-primary': message.role === 'user', 'mathjax-pending': mathDelimiterPattern.test(message.htmlContent) }]} set:html={message.htmlContent} />
                            </div>
                        </>
                    ))
                ) : (
                    <div class="unauthorized-message">
                        <div class="message assistant">
                            <div class="message-content">
                                <div class="unauthorized-content">
                                    <h3>Access Denied</h3>
                                    <p>You don't have permission to view this conversation.</p>
                                    <a href="/" class="btn-primary">Go Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
            {isAuthorized && <Toolbar />}
            <Footer hideCopyright={true} />
        </section>
        <RightSidebar
            threadId={id || ''}
            category={category || ''}
            mode={mode || ''}
            isAuthorized={isAuthorized}
            isPublic={isPublic}
        />
    </section>
    <script is:inline>
        const clientMessages = []
        const classesToIgnore = ['message'];
        const messageEles = document.querySelectorAll('.chat-messages > .message');
        const outputTabs = ['study-guide', 'reference-sheet'];

        globalThis.setTimeout(() => {
            messageEles.forEach(message => {
                const classes = [...message.classList].filter(cls => !classesToIgnore.includes(cls));
                const type = classes.join(',')
                const content = message.querySelector('.message-content').innerHTML.trim();
                const tabShown = outputTabs[0]

                clientMessages.push({
                    type,
                    content,
                    tabShown,
                });
            });
        }, 1000);

        window.addEventListener('load', () => {
            const chatMessages = document.querySelector('.chat-messages');

            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
        });
    </script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/marked@15.0.12/marked.min.js"></script>
    <MessagesScript page="chat" category={category} mode={mode} id={id} />
    <StepByStepScript />
</Layout>
