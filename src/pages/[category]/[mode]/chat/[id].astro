---
import Layout from '../../../../layouts/Layout.astro';

import Header from '../../../../components/chat/Header.astro';
import Toolbar from '../../../../components/chat/Toolbar.astro';
import LeftSidebar from '../../../../components/chat/LeftSidebar.astro';
import RightSidebar from '../../../../components/chat/RightSidebar.astro';

import MessagesScript from '../../../../scripts/messages.astro';
import StepByStepScript from '../../../../scripts/step-by-step.astro';
import '../../../../styles/pages/chat.scss';

import { getMessages, getMessagesLength, getThreadByToken } from '../../../../lib/threads';
import { marked } from 'marked';
import Footer from '../../../../components/Footer.astro';
import { checkThreadAccess } from '../../../../lib/auth/checkThreadAccess';
import { getLatestReferenceSheet } from '../../../../lib/content/latest/reference-sheet';
import { getLatestStudyGuide } from '../../../../lib/content/latest/study-guide';
import { getLatestInfographic } from '../../../../lib/content/latest/infographic';
import { getLatestWebpage } from '../../../../lib/content/latest/webpage';
import { getLatestMindMap } from '../../../../lib/content/latest/mind-map';
import { getLatestResources } from '../../../../lib/content/latest/additional-resources';
import { getLatestFlashcards } from '../../../../lib/content/latest/flashcards';
import { getLatestPracticeQuestions } from '../../../../lib/content/latest/practice-questions';
import { checkForOneMessage } from '../../../../lib/checkForOneMessage';
import categories from '../../../../lib/modes';

let { category, mode, id } = Astro.params || { category: '', mode: '', id: '' };

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];
const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Use Clerk authentication
const { auth } = Astro.locals;
const { userId, sessionClaims } = auth();
const user_email = sessionClaims?.email as string || null;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', auth, category, mode, Astro);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!userId && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get thread data to access the title and uploaded files
const thread = id ? await getThreadByToken(id, user_email) : null;
const threadTitle = thread?.title || null;
const uploadedFiles = (thread?.uploadedFiles as any[]) || [];

// Get messages only if authorized or public
const messagesLength = await getMessagesLength(id || '');
let messages = (isAuthorized || isPublic) && messagesLength > 0 ? await getMessages(id ?? '', user_email) : [];

// Check if there's only one message and generate welcome message if needed
messages = await checkForOneMessage({
    messages,
    threadId: id || '',
    category: category || '',
    mode: mode || '',
    isAuthorized
});

// Check if reference sheet, study guide, infographic, webpage, mind map, additional resources, flashcard, and practice questions exist
let hasReferenceSheet = false;
let hasStudyGuide = false;
let hasInfographic = false;
let hasWebpage = false;
let hasMindMap = false;
let hasAdditionalResources = false;
let hasFlashcard = false;
let hasPracticeQuestions = false;

if ((isAuthorized || isPublic) && id) {
    const referenceSheetResult = await getLatestReferenceSheet(id);
    const studyGuideResult = await getLatestStudyGuide(id);
    const infographic = await getLatestInfographic(id);
    const webpageResult = await getLatestWebpage(id);
    const mindMapResult = await getLatestMindMap(id);
    const additionalResourcesResult = await getLatestResources(id);
    const flashcardResult = await getLatestFlashcards(id);
    const practiceQuestionsResult = await getLatestPracticeQuestions(id);

    hasReferenceSheet = !!referenceSheetResult.content;
    hasStudyGuide = !!studyGuideResult.content;
    hasInfographic = !!infographic;
    hasWebpage = !!webpageResult.content;
    hasMindMap = !!mindMapResult.content;
    hasAdditionalResources = !!additionalResourcesResult.content;
    hasFlashcard = !!flashcardResult.content;
    hasPracticeQuestions = !!practiceQuestionsResult.content;
}


export const inNav = 'hide';
---
<Layout title={`Chat | ${modeName} | ${categoryName}`} container={false} isChatArea={true} className="chat-page" hideCopyright={true}>
    <div id="user-email" data-email={user_email} style="display: none;"></div>
    <header class="chat-header">
        <div class="chat-title-container">
            <h2><span class="material-symbols-outlined">chat</span>&nbsp;{threadTitle || (id ? 'Chat' : 'New Chat')}</h2>
        </div>
        <Header pTitle={threadTitle || (id ? 'Chat' : 'New Chat')} />
    </header>
    <section class="chat-container">
        <LeftSidebar
            isPublic={isPublic}
            isAuthorized={isAuthorized}
            threadId={id || ''}
            uploadedFiles={uploadedFiles}
            email={user_email || ''}
        />
        <section class="chat-section">
            <div class="chat-messages">
                {isAuthorized || isPublic ? (
                    messages
                        .filter(message => message.role !== 'system')
                        .map(async message => {
                        // Convert markdown to HTML
                        marked.setOptions({ breaks: true, gfm: true });
                        const htmlText = await marked.parse(message.content);

                        // Render message
                        return <div class={`message ${message.role}`}>
                            <div class={`message-content${message.role === 'user' ? ' bg-primary' : ''}`} set:html={htmlText} />
                        </div>
                    })
                ) : (
                    <div class="unauthorized-message">
                        <div class="message assistant">
                            <div class="message-content">
                                <div class="unauthorized-content">
                                    <h3>Access Denied</h3>
                                    <p>You don't have permission to view this conversation. This thread belongs to another user.</p>
                                    <a href="/" class="btn-primary">Go Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
            {isAuthorized && <Toolbar />}
            <Footer hideCopyright={true} />
        </section>
        <RightSidebar
            hasReferenceSheet={hasReferenceSheet}
            hasStudyGuide={hasStudyGuide}
            hasInfographic={hasInfographic}
            hasWebpage={hasWebpage}
            hasMindMap={hasMindMap}
            hasAdditionalResources={hasAdditionalResources}
            hasFlashcard={hasFlashcard}
            hasPracticeQuestions={hasPracticeQuestions}
            threadId={id || ''}
            category={category || ''}
            mode={mode || ''}
        />
    </section>
    <script is:inline>
        const messages = []
        const classesToIgnore = ['message'];
        const messageEles = document.querySelectorAll('.chat-messages > .message');
        const outputTabs = ['study-guide', 'reference-sheet'];

        setTimeout(() => {
            messageEles.forEach(message => {
                const classes = [...message.classList].filter(cls => !classesToIgnore.includes(cls));
                const type = classes.join(',')
                const content = message.querySelector('.message-content').innerHTML.trim();
                const tabShown = outputTabs[0]

                messages.push({
                    type,
                    content,
                    tabShown,
                });
            });
        }, 1000);

        window.addEventListener('load', () => {
            const chatMessages = document.querySelector('.chat-messages');

            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
        });
    </script>
    <MessagesScript page="chat" category={category} mode={mode} />
    <StepByStepScript />
</Layout> 