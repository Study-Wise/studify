---
import Layout from '../../../../layouts/Layout.astro';

import Header from '../../../../components/chat/Header.astro';
import FancyOutput from '../../../../components/fancy/Output.astro';
import Toolbar from '../../../../components/chat/Toolbar.astro';
import LeftSidebar from '../../../../components/chat/LeftSidebar.astro';
import RightSidebar from '../../../../components/chat/RightSidebar.astro';

import MessagesScript from '../../../../scripts/messages.astro';
import StepByStepScript from '../../../../scripts/step-by-step.astro';
import '../../../../styles/pages/chat.scss';

import { getMessages, getMessagesLength } from '../../../../lib/threads';
import extract from '../../../../lib/extractPartsofMessage';
import Footer from '../../../../components/Footer.astro';
import { checkThreadAccess } from '../../../../lib/auth/checkThreadAccess';
import { getLatestReferenceSheet } from '../../../../lib/content/getLatestReferenceSheet';
import { getLatestStudyGuide } from '../../../../lib/content/getLatestStudyGuide';
import { getInfographic } from '../../../../lib/content/getInfographic';

let { category, mode, id } = Astro.params || { category: '', mode: '', id: '' };

// Use Clerk authentication
const { auth } = Astro.locals;
const { userId, sessionClaims } = auth();
const user_email = sessionClaims?.email as string || null;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', auth, category, mode, Astro);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!userId && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get messages only if authorized or public
const messagesLength = await getMessagesLength(id || '');
const messages = (isAuthorized || isPublic) && messagesLength > 0 ? await getMessages(id ?? '', user_email) : [];

// Check if reference sheet, study guide, and infographic exist
let hasReferenceSheet = false;
let hasStudyGuide = false;
let hasInfographic = false;

if ((isAuthorized || isPublic) && id) {
    const referenceSheetResult = await getLatestReferenceSheet(id, user_email);
    const studyGuideResult = await getLatestStudyGuide(id, user_email);
    const infographic = await getInfographic(id);

    hasReferenceSheet = !!referenceSheetResult.content;
    hasStudyGuide = !!studyGuideResult.content;
    hasInfographic = !!infographic;
}


export const inNav = 'hide';
---
<Layout title="Chat" container={false} isChatArea={true} additionalClasses={['chat-page']} hideCopyright={true}>
    <div id="user-email" data-email={user_email} style="display: none;"></div>
    <header class="chat-header">
        <div class="chat-title-container">
            <h2><span class="material-symbols-outlined">chat</span>&nbsp;{id ? 'Chat' : 'New Chat'}</h2>
            <button id="share-button" class="share-button" title="Toggle thread visibility">
                <span class="material-symbols-outlined">share</span>
                <span class="share-text">Share</span>
            </button>
        </div>
        <Header pTitle={`${id ? 'Chat' : 'New Chat'}`} />
    </header>
    <section class="chat-container">
        <LeftSidebar />
        <section class="chat-section">
            <div class="chat-messages">
                {isAuthorized || isPublic ? (
                    messages
                        .filter(message => message.role !== 'system')
                        .map(async message => {
                        const { obj, generatedText: htmlText } = await extract(message.content);

                        // For assistant messages with fancy output, don't render as a regular message
                        // The fancy output will be rendered separately in the sidebar
                        if (message.role === 'assistant' && (obj.studyGuide || obj.referenceSheet)) {
                            return null;
                        }

                        // Render as simple message
                        return <div class={`message ${message.role}`}>
                            <div class={`message-content ${message.role === 'user' ? 'bg-primary' : ''}`} set:html={htmlText} />
                        </div>
                    })
                ) : (
                    <div class="unauthorized-message">
                        <div class="message assistant">
                            <div class="message-content">
                                <div class="unauthorized-content">
                                    <h3>Access Denied</h3>
                                    <p>You don't have permission to view this conversation. This thread belongs to another user.</p>
                                    <a href="/" class="btn-primary">Go Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
            {isAuthorized && <Toolbar />}
            <Footer hideCopyright={true} />
        </section>
        <RightSidebar
            hasReferenceSheet={hasReferenceSheet}
            hasStudyGuide={hasStudyGuide}
            hasInfographic={hasInfographic}
            threadId={id || ''}
            category={category || ''}
            mode={mode || ''}
        />
    </section>
    <script is:inline>
        const messages = []
        const classesToIgnore = ['message'];
        const messageEles = document.querySelectorAll('.chat-messages > .message');
        const outputTabs = ['study-guide', 'reference-sheet'];
        
        setTimeout(() => {
            messageEles.forEach(message => {
                const classes = [...message.classList].filter(cls => !classesToIgnore.includes(cls));
                const type = classes.join(',')
                const content = message.querySelector('.message-content').innerHTML.trim();
                const fancyOutput = message.querySelector('.fancy-output');
                const hasFancyOutput = fancyOutput !== null;
                const tabShown = outputTabs[0]
                const tabsAmt = fancyOutput ? fancyOutput.querySelectorAll('.tab-content-container').length : null;

                if (tabsAmt) {
                    fancyOutput.style.setProperty('--tabs-amt', tabsAmt);
                }

                messages.push({
                    type,
                    content,
                    hasFancyOutput,
                    tabShown,
                    tabsAmt,
                });
            });
        }, 1000);

        window.onFancyOutput = () => {
            const allOutputs = document.querySelectorAll('.fancy-output');
            allOutputs.forEach(output => {
                const openBtn = output.querySelector('.buttons .button.open-button');
                if (openBtn) {
                    openBtn.addEventListener('click', () => {
                        const content = output.outerHTML.trim()
                        // const item = messages.filter(m => m.hasFancyOutput).find(m => m.content.trim().replace(' open=""', '') === content.trim().replace(' open=""', ''));
                        if (!output.hasAttribute('open')) {
                            output.showModal();
                        }
                        else if (output.hasAttribute('open')) {
                            output.style.removeProperty('--tab-shown');
                            setTimeout(() => {
                                output.close();
                            });
                        }
                    });
                }
                output.addEventListener('click', (e) => {
                    if (!output.hasAttribute('open')) {
                        e.preventDefault();
                        output.showModal();
                    }
                });

                const tabbBtns = output.querySelectorAll('.tabs > .btn.tab');
                tabbBtns.forEach((btn, index) => {
                    btn.addEventListener('click', () => {
                        if (output.hasAttribute('open')) {
                            output.style.setProperty('--tab-shown', index);
                        }
                    });
                });

            });
        }
        window.addEventListener('load', window.onFancyOutput);
        window.addEventListener('load', () => {
            const chatMessages = document.querySelector('.chat-messages');

            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
        });
    </script>
    <MessagesScript page="chat" category={category} mode={mode} />
    <StepByStepScript />
</Layout> 