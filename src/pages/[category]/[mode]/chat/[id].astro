---
import Layout from '../../../../layouts/Layout.astro';

import Header from '../../../../components/chat/Header.astro';
import FancyOutput from '../../../../components/fancy/Output.astro';
import Toolbar from '../../../../components/chat/Toolbar.astro';
import LeftSidebar from '../../../../components/chat/LeftSidebar.astro';
import RightSidebar from '../../../../components/chat/RightSidebar.astro';

import MessagesScript from '../../../../scripts/messages.astro';
import '../../../../styles/pages/chat.scss';

import { getMessages, getMessagesLength } from '../../../../lib/threads';
import extract from '../../../../lib/extractPartsofMessage';
import Footer from '../../../../components/Footer.astro';
import { getUserRole } from '../../../../lib/auth-utils';
import { db } from '../../../../db/initialize';
import { eq } from 'drizzle-orm';
import { threadsTable } from '../../../../db/schema';

let { category, mode, id } = Astro.params || { category: '', mode: '', id: '' };

// Use Clerk authentication
const { auth } = Astro.locals;
const { userId, sessionClaims } = auth();
const user_email = sessionClaims?.email as string || null;

// Redirect to sign-in if not authenticated
if (!userId) {
    return Astro.redirect("/user/sign-in");
}

// Get user role and check if admin
const userRole = getUserRole(auth);
const isUserAdmin = userRole === 'admin';

// Check thread ownership
let threadOwner: string | null = null;
let isPublicThread = false;
if (id) {
    try {
        const threads = await db.select().from(threadsTable).where(eq(threadsTable.id, id));
        if (threads.length > 0) {
            threadOwner = threads[0].email;
            isPublicThread = threads[0].isPublic;
            // If unclaimed and user is authenticated, claim ownership
            // TODO: Fix claiming unclaimed threads
            if (!threadOwner && user_email) {
                try {
                    await db.update(threadsTable)
                        .set({ email: user_email, updatedAt: new Date() })
                        .where(eq(threadsTable.id, id));
                    threadOwner = user_email;
                } catch (e) {
                    console.error('Error claiming thread ownership:', e);
                }
            }
        }
    } catch (error) {
        console.error('Error fetching thread:', error);
    }
}

// Check if user owns the thread or is admin
const messagesLength = await getMessagesLength(id || '');
const isAuthorized = id && messagesLength > 0 && ((threadOwner && threadOwner === user_email) || !threadOwner || isUserAdmin);
const messages = !isAuthorized ? [] : await getMessages(id, user_email);
const isPublic = !isAuthorized && isPublicThread;


export const inNav = 'hide';
---
<Layout title="Chat" container={false} isChatArea={true} additionalClasses={['chat-page']} hideCopyright={true}>
    <div id="user-email" data-email={user_email} style="display: none;"></div>
    <header class="chat-header">
        <div class="chat-title-container">
            <h2><span class="material-symbols-outlined">chat</span>&nbsp;{id ? 'Chat' : 'New Chat'}</h2>
            <button id="share-button" class="share-button" title="Toggle thread visibility">
                <span class="material-symbols-outlined">share</span>
                <span class="share-text">Share</span>
            </button>
        </div>
        <Header pTitle={`${id ? 'Chat' : 'New Chat'}`} />
    </header>
    <section class="chat-container">
        <LeftSidebar />
        <section class="chat-section">
            <label class="chat-left-sidebar-toggle">
                <input type="checkbox" />
                <span class="material-symbols-outlined">chat</span>
            </label>
            <div class="chat-messages">
                {isAuthorized || isPublic ? (
                    messages.map(async message => {
                        const { obj, generatedText: htmlText } = await extract(message.content);
                        var content = htmlText;
                        if (!(message.role === 'assistant' && obj.studyGuide || obj.referenceSheet)) {
                            return <div class={`message ${message.role}`}>
                                <div class={`message-content ${message.role === 'user' ? 'bg-primary' : ''}`} set:html={content} />
                            </div>
                        }

                        if (message.role === 'assistant') {
                            if (obj.studyGuide || obj.referenceSheet) {
                                return <div class={`message ${message.role}`}>
                                    <div class="message-content">
                                        { obj.precedingText && <div class="message-content-inner" set:html={obj.precedingText} /> }
                                        <FancyOutput obj={obj} />
                                        { obj.followingText && <div class="message-content-inner" set:html={obj.followingText} /> }
                                    </div>
                                </div>              
                            }
                        }
                    })
                ) : (
                    <div class="unauthorized-message">
                        <div class="message assistant">
                            <div class="message-content">
                                <div class="unauthorized-content">
                                    <h3>Access Denied</h3>
                                    <p>You don't have permission to view this conversation. This thread belongs to another user.</p>
                                    <a href="/" class="btn-primary">Go Home</a>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
            {isAuthorized && <Toolbar />}
            <Footer />
        </section>
        <RightSidebar />
    </section>
    <script is:inline>
        const messages = []
        const classesToIgnore = ['message'];
        const messageEles = document.querySelectorAll('.chat-messages > .message');
        const outputTabs = ['study-guide', 'reference-sheet'];
        
        setTimeout(() => {
            messageEles.forEach(message => {
                const classes = [...message.classList].filter(cls => !classesToIgnore.includes(cls));
                const type = classes.join(',')
                const content = message.querySelector('.message-content').innerHTML.trim();
                const fancyOutput = message.querySelector('.fancy-output');
                const hasFancyOutput = fancyOutput !== null;
                const tabShown = outputTabs[0]
                const tabsAmt = fancyOutput ? fancyOutput.querySelectorAll('.tab-content-container').length : null;

                if (tabsAmt) {
                    fancyOutput.style.setProperty('--tabs-amt', tabsAmt);
                }

                messages.push({
                    type,
                    content,
                    hasFancyOutput,
                    tabShown,
                    tabsAmt,
                });
            });
        }, 1000);

        window.onFancyOutput = () => {
            const allOutputs = document.querySelectorAll('.fancy-output');
            allOutputs.forEach(output => {
                const openBtn = output.querySelector('.buttons .button.open-button');
                if (openBtn) {
                    openBtn.addEventListener('click', () => {
                        const content = output.outerHTML.trim()
                        // const item = messages.filter(m => m.hasFancyOutput).find(m => m.content.trim().replace(' open=""', '') === content.trim().replace(' open=""', ''));
                        if (!output.hasAttribute('open')) {
                            output.showModal();
                        }
                        else if (output.hasAttribute('open')) {
                            output.style.removeProperty('--tab-shown');
                            setTimeout(() => {
                                output.close();
                            });
                        }
                    });
                }
                output.addEventListener('click', (e) => {
                    if (!output.hasAttribute('open')) {
                        e.preventDefault();
                        output.showModal();
                    }
                });

                const tabbBtns = output.querySelectorAll('.tabs > .btn.tab');
                tabbBtns.forEach((btn, index) => {
                    btn.addEventListener('click', () => {
                        if (output.hasAttribute('open')) {
                            output.style.setProperty('--tab-shown', index);
                        }
                    });
                });

            });
        }
        window.addEventListener('load', window.onFancyOutput);
        window.addEventListener('load', () => {
            const chatMessages = document.querySelector('.chat-messages');
            const chatToolbar = document.querySelector('.chat-toolbar');

            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });

            chatMessages.addEventListener('scroll', () => {
                const scrollPosition = chatMessages.scrollTop;
                const chatMessagesHeight = chatMessages.clientHeight;
                const chatMessagesScrollHeight = chatMessages.scrollHeight;
                const isAtBottom = scrollPosition + chatMessagesHeight >= chatMessagesScrollHeight;

                if (isAtBottom) {
                    chatToolbar.classList.add('at-bottom');
                } else {
                    chatToolbar.classList.remove('at-bottom');
                }
            });

            // Right sidebar tab switching
            const sidebarTabs = document.querySelectorAll('.sidebar-tab');
            const sidebarContents = document.querySelectorAll('.sidebar-tab-content');

            sidebarTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const targetTab = tab.dataset.tab;

                    // Remove active class from all tabs and contents
                    sidebarTabs.forEach(t => t.classList.remove('active'));
                    sidebarContents.forEach(c => c.classList.remove('active'));

                    // Add active class to clicked tab and corresponding content
                    tab.classList.add('active');
                    const targetContent = document.querySelector(`.sidebar-tab-content[data-content="${targetTab}"]`);
                    if (targetContent) {
                        targetContent.classList.add('active');
                    }
                });
            });
        });
    </script>
    <MessagesScript page="chat" category={category} mode={mode} />
</Layout> 