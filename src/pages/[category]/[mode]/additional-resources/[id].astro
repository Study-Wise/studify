---
import categories from '@/lib/modes';
import { getThreadByToken } from '@/lib/threads';
import type { Resource } from '@/lib/content/generate/additional-resources';
import { getLatestResources } from '@/lib/content/latest/additional-resources';

import ContentActions from '@/components/ContentActions.astro';
import AccessDenied from '@/components/content/AccessDenied.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/additional-resources.scss';
import '@/styles/pages/content/globals.scss';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

if (!await getThreadByToken(id || '', true)) return new Response(null, { status: 404 });

if (!Astro.locals.user) return Astro.redirect('/user/sign-in');

const latestResources = await getLatestResources(id || '', Astro.locals.user);

let resourcesData = null;
if (latestResources?.content) {
    try {
        resourcesData = JSON.parse(latestResources.content);
    } catch (error) {
        console.error('Error parsing resources JSON:', error);
    }
}
---
<Layout title={`Resources | ${modeObj.name} | ${categoryObj.name}`} className="resources-page content-page">
    {!latestResources ? (
        <AccessDenied />
    ) : (
        <>
            <ContentActions threadId={id || ''} hasContent={!!resourcesData} />
            {resourcesData ? (
                <div class="content-container">
                    <div class="resources-page__header">
                        <h1 class="resources-page__title">{resourcesData.topic}</h1>
                        <p class="resources-page__subtitle">Curated educational resources to enhance your learning</p>
                    </div>
                    {resourcesData.simulations && resourcesData.simulations.length > 0 && (
                        <section class="resources-page__section">
                            <div class="resources-page__section-header">
                                <span class="material-symbols-outlined" aria-hidden="true">science</span>
                                <h2>Interactive Simulations</h2>
                            </div>
                            <div class="resources-page__grid">
                                {resourcesData.simulations.map((resource: Resource) => (
                                    <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resources-page__card">
                                        <div class="resources-page__card-icon" data-type="simulation">
                                            <span class="material-symbols-outlined" aria-hidden="true">science</span>
                                        </div>
                                        <div class="resources-page__card-content">
                                            <h3 class="resources-page__card-title">{resource.title}</h3>
                                            <p class="resources-page__card-snippet">{resource.snippet}</p>
                                            <div class="resources-page__card-footer">
                                                <span class="resources-page__card-source">{resource.source}</span>
                                                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    {resourcesData.videos && resourcesData.videos.length > 0 && (
                        <section class="resources-page__section">
                            <div class="resources-page__section-header">
                                <span class="material-symbols-outlined" aria-hidden="true">play_circle</span>
                                <h2>Video Tutorials</h2>
                            </div>
                            <div class="resources-page__grid">
                                {resourcesData.videos.map((resource: Resource) => (
                                    <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resources-page__card">
                                        <div class="resources-page__card-icon" data-type="video">
                                            <span class="material-symbols-outlined" aria-hidden="true">play_circle</span>
                                        </div>
                                        <div class="resources-page__card-content">
                                            <h3 class="resources-page__card-title">{resource.title}</h3>
                                            <p class="resources-page__card-snippet">{resource.snippet}</p>
                                            <div class="resources-page__card-footer">
                                                <span class="resources-page__card-source">{resource.source}</span>
                                                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    {resourcesData.articles && resourcesData.articles.length > 0 && (
                        <section class="resources-page__section">
                            <div class="resources-page__section-header">
                                <span class="material-symbols-outlined" aria-hidden="true">article</span>
                                <h2>Articles & Guides</h2>
                            </div>
                            <div class="resources-page__grid">
                                {resourcesData.articles.map((resource: Resource) => (
                                    <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resources-page__card">
                                        <div class="resources-page__card-icon" data-type="article">
                                            <span class="material-symbols-outlined" aria-hidden="true">article</span>
                                        </div>
                                        <div class="resources-page__card-content">
                                            <h3 class="resources-page__card-title">{resource.title}</h3>
                                            <p class="resources-page__card-snippet">{resource.snippet}</p>
                                            <div class="resources-page__card-footer">
                                                <span class="resources-page__card-source">{resource.source}</span>
                                                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    {resourcesData.tutorials && resourcesData.tutorials.length > 0 && (
                        <section class="resources-page__section">
                            <div class="resources-page__section-header">
                                <span class="material-symbols-outlined" aria-hidden="true">school</span>
                                <h2>Step-by-Step Tutorials</h2>
                            </div>
                            <div class="resources-page__grid">
                                {resourcesData.tutorials.map((resource: Resource) => (
                                    <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resources-page__card">
                                        <div class="resources-page__card-icon" data-type="tutorial">
                                            <span class="material-symbols-outlined" aria-hidden="true">school</span>
                                        </div>
                                        <div class="resources-page__card-content">
                                            <h3 class="resources-page__card-title">{resource.title}</h3>
                                            <p class="resources-page__card-snippet">{resource.snippet}</p>
                                            <div class="resources-page__card-footer">
                                                <span class="resources-page__card-source">{resource.source}</span>
                                                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}

                    {resourcesData.documentation && resourcesData.documentation.length > 0 && (
                        <section class="resources-page__section">
                            <div class="resources-page__section-header">
                                <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                                <h2>Documentation & References</h2>
                            </div>
                            <div class="resources-page__grid">
                                {resourcesData.documentation.map((resource: Resource) => (
                                    <a href={resource.url} target="_blank" rel="noopener noreferrer" class="resources-page__card">
                                        <div class="resources-page__card-icon" data-type="documentation">
                                            <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                                        </div>
                                        <div class="resources-page__card-content">
                                            <h3 class="resources-page__card-title">{resource.title}</h3>
                                            <p class="resources-page__card-snippet">{resource.snippet}</p>
                                            <div class="resources-page__card-footer">
                                                <span class="resources-page__card-source">{resource.source}</span>
                                                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )}
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    <h2>No Resources Found</h2>
                    <p>There are no resources generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
