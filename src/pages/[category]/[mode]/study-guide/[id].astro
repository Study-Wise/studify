---
import { marked } from 'marked';
import categories from '@/lib/modes';
import { getThreadAccess } from '@/lib/auth/check-thread-access';
import { getLatestStudyGuide } from '@/lib/content/latest/study-guide';

import ContentActions from '@/components/ContentActions.astro';
import AccessDenied from '@/components/content/AccessDenied.astro';
import Layout from '@/layouts/Layout.astro';
import StepByStepScript from '@/scripts/step-by-step.astro';
import '@/styles/pages/content/globals.scss';
import '@/styles/pages/content/study-guide.scss';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const { threadExists } = await getThreadAccess(id || '', Astro.locals.user, category, mode);

// A deleted or unknown chat has no materials, so show the 404 page (#344)
if (!threadExists) return new Response(null, { status: 404 });

if (!Astro.locals.user) return Astro.redirect('/user/sign-in');

const latestStudyGuide = await getLatestStudyGuide(id || '', Astro.locals.user);

const parsedContent = latestStudyGuide?.content ? await marked.parse(latestStudyGuide.content) : null;
---
<Layout title={`Study Guide | ${modeObj.name} | ${categoryObj.name}`} className="study-guide-page content-page" mathjax={true} desmos={modeObj.desmos === true}>
    {!latestStudyGuide ? (
        <AccessDenied />
    ) : (
        <>
            <ContentActions threadId={id || ''} hasContent={!!parsedContent} />
            {parsedContent ? (
                <div class="content-container study-guide-content" set:html={parsedContent} />
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                    <h2>No Study Guide Found</h2>
                    <p>There is no study guide generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
    <StepByStepScript />
</Layout>
