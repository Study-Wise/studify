---
import Layout from '@/layouts/Layout.astro';
import ContentActions from '@/components/ContentActions.astro';
import StepByStepScript from '@/scripts/step-by-step.astro';
import '@/styles/pages/content/study-guide.scss';
import '@/styles/pages/content/globals.scss';

import { marked } from 'marked';

import { getLatestStudyGuide } from '@/lib/content/latest/study-guide';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import categories from '@/lib/modes';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

// Validate category and mode exist
if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const user = Astro.locals.user;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user, category, mode);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!user && !isPublic) {
    return Astro.redirect('/user/sign-in');
}

// Get the latest study guide only if authorized or public
const { content: latestStudyGuide } = (isAuthorized || isPublic)
    ? await getLatestStudyGuide(id || '')
    : { content: null };

// Parse markdown to HTML
const parsedContent = latestStudyGuide ? await marked.parse(latestStudyGuide) : null;
---

<Layout title={`Study Guide | ${modeName} | ${categoryName}`} className="study-guide-page content-page">
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this study guide. This thread belongs to another user.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="study-guide"
                threadId={id || ''}
                hasContent={!!parsedContent}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {parsedContent ? (
                <div class="content-container study-guide-content" set:html={parsedContent} />
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
                    <h2>No Study Guide Found</h2>
                    <p>There is no study guide generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
    <StepByStepScript />
</Layout>
