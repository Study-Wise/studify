---
import Layout from '../../../../layouts/Layout.astro';
import { getLatestStudyGuide } from '../../../../lib/content/getLatestStudyGuide';
import { checkThreadAccess } from '../../../../lib/auth/checkThreadAccess';
import StepByStepScript from '../../../../scripts/step-by-step.astro';
import '../../../../styles/pages/study-guide.scss';

const { id } = Astro.params;

// Get user authentication
const { auth } = Astro.locals;
const { userId, sessionClaims } = auth();
const user_email = sessionClaims?.email as string || null;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user_email, auth);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!userId && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest study guide only if authorized or public
const { content: latestStudyGuide, precedingText, followingText } = (isAuthorized || isPublic)
    ? await getLatestStudyGuide(id || '', user_email)
    : { content: null, precedingText: '', followingText: '' };
---

<Layout title="Study Guide" container={true}>
    <div class="study-guide-page">
        {!isAuthorized && !isPublic ? (
            <div class="empty-state">
                <span class="material-symbols-outlined">lock</span>
                <h2>Access Denied</h2>
                <p>You don't have permission to view this study guide. This thread belongs to another user.</p>
                <a href="/" class="btn-primary">Go Home</a>
            </div>
        ) : latestStudyGuide ? (
            <div class="content-container">
                {precedingText && <div class="preceding-text" set:html={precedingText} />}
                <div class="study-guide-content" set:html={latestStudyGuide} />
                {followingText && <div class="following-text" set:html={followingText} />}
            </div>
        ) : (
            <div class="empty-state">
                <span class="material-symbols-outlined">menu_book</span>
                <h2>No Study Guide Found</h2>
                <p>There is no study guide generated for this conversation yet.</p>
            </div>
        )}
    </div>
    <StepByStepScript />
</Layout>
