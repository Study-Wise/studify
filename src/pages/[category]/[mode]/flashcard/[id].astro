---
import Layout from '../../../../layouts/Layout.astro';
import { getLatestFlashcard } from '../../../../lib/content/latest/flashcard';
import { checkThreadAccess } from '../../../../lib/auth/checkThreadAccess';
import { marked } from 'marked';
import '../../../../styles/pages/content/flashcard.scss';

const { category, mode, id } = Astro.params;

// Get user authentication
const { auth } = Astro.locals;
const { userId } = auth();

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', auth, category, mode, Astro);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!userId && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest flashcard only if authorized or public
const { content: latestFlashcard } = (isAuthorized || isPublic)
    ? await getLatestFlashcard(id || '')
    : { content: null };

// Parse markdown to HTML
const parsedContent = latestFlashcard ? await marked.parse(latestFlashcard) : null;
---

<Layout title={`Flashcards | ${mode} | ${category}`}  container={true}>
    <div class="flashcard-page">
        {!isAuthorized && !isPublic ? (
            <div class="empty-state">
                <span class="material-symbols-outlined">lock</span>
                <h2>Access Denied</h2>
                <p>You don't have permission to view these flashcards. This thread belongs to another user.</p>
                <a href="/" class="btn-primary">Go Home</a>
            </div>
        ) : parsedContent ? (
            <div class="content-container">
                <div class="flashcard-content" set:html={parsedContent} />
            </div>
        ) : (
            <div class="empty-state">
                <span class="material-symbols-outlined">style</span>
                <h2>No Flashcards Found</h2>
                <p>There are no flashcards generated for this conversation yet.</p>
            </div>
        )}
    </div>
</Layout>
