---
import { marked } from 'marked';
import categories from '@/lib/modes';
import { getThreadByToken } from '@/lib/threads';
import { getLatestSummary } from '@/lib/content/latest/summary';

import ContentActions from '@/components/ContentActions.astro';
import AccessDenied from '@/components/content/AccessDenied.astro';
import Layout from '@/layouts/Layout.astro';
import SelectableQuestionsScript from '@/scripts/selectable-questions.astro';
import '@/styles/pages/content/globals.scss';
import '@/styles/pages/content/summary.scss';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

// A deleted or unknown chat has no materials, so show the 404 page (#344)
if (!await getThreadByToken(id || '', true)) return new Response(null, { status: 404 });

if (!Astro.locals.user) return Astro.redirect('/user/sign-in');

const latestSummary = await getLatestSummary(id || '', Astro.locals.user);

const parsedContent = latestSummary?.content ? await marked.parse(latestSummary.content) : null;
---
<Layout title={`Chat Summary | ${modeObj.name} | ${categoryObj.name}`} className="summary-page content-page" mathjax={true}>
    {!latestSummary ? (
        <AccessDenied />
    ) : (
        <>
            <ContentActions threadId={id || ''} hasContent={!!parsedContent} />
            {parsedContent ? (
                <div class="content-container summary-page__content" set:html={parsedContent} />
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">summarize</span>
                    <h2>No Summary Found</h2>
                    <p>There is no summary generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
    <SelectableQuestionsScript />
</Layout>
