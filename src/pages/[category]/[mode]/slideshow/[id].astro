---
import categories from '@/lib/modes';
import { getThreadByToken } from '@/lib/threads';
import { getLatestSlideshow } from '@/lib/content/latest/slideshow';

import ContentActions from '@/components/ContentActions.astro';
import AccessDenied from '@/components/content/AccessDenied.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/slideshow.scss';
import '@/styles/pages/content/globals.scss';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

// A deleted or unknown chat has no materials, so show the 404 page (#344)
if (!await getThreadByToken(id || '', true)) return new Response(null, { status: 404 });

if (!Astro.locals.user) return Astro.redirect('/user/sign-in');

const latestSlideshow = await getLatestSlideshow(id || '', Astro.locals.user);
---
<Layout title={`Slideshow | ${modeObj.name} | ${categoryObj.name}`} className="slideshow-page" container={false}>
    {!latestSlideshow ? (
        <AccessDenied />
    ) : (
        <>
            <ContentActions threadId={id || ''} hasContent={!!latestSlideshow.html} />
            {latestSlideshow.html ? (
                <div class="slideshow-page__container">
                    <iframe srcdoc={latestSlideshow.html} title="Generated Slideshow" sandbox="allow-scripts" />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">slideshow</span>
                    <h2>No Slideshow Found</h2>
                    <p>There is no slideshow generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
