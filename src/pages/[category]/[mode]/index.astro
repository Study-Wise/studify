---
import categories from '@/lib/modes';

import Layout from '@/layouts/Layout.astro';
import FancyButton from '@/components/fancy/Button.astro';
import MessagesScript from '@/scripts/messages.astro';
import StepByStepScript from '@/scripts/step-by-step.astro';
import '@/styles/pages/index.scss';
import '@/styles/pages/mode.scss';
import '@/styles/components/step-by-step.scss';

let { category, mode } = Astro.params || { category: '', mode: '' };

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

---
<Layout title={`${modeName} | ${categoryName}`} mathjax={true} desmos={modeObj.desmos === true}>
    {/* Introduction Section */}
    <section class="introduction-section card" aria-labelledby="how-it-works-heading">
        <h2 id="how-it-works-heading">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>&nbsp;How It Works
        </h2>
        <p>
            Welcome to <b>Studify</b>! Turn your {modeName} homework into powerful learning tools.
        </p>
        <ol class="steps-list">
            <li>
                <strong>Paste Your Homework:</strong> Paste your {modeName} homework into the text box below, then click "Generate Study Materials" to start a chat.
            </li>
            <li>
                <strong>Generate Materials:</strong> In the chat page sidebar, choose the study materials you want to generate from your conversation.
            </li>
            <li>
                <strong>Receive AI Insights:</strong> Our AI will analyze your homework and instantly create:
                <ul>
                    <li>
                        A personalized <strong>Study Guide</strong> explaining concepts, showing worked examples, providing practice problems, and defining key terms.
                    </li>
                    <li>
                        A concise <strong>Reference Sheet</strong> with key formulas and definitions for quick review.
                    </li>
                    <li>
                        Visual <strong>Infographics</strong> to help you understand concepts at a glance.
                    </li>
                    <li>
                        Interactive <strong>Flashcards</strong> for effective memorization and review.
                    </li>
                    <li>
                        <strong>Practice Questions</strong> to test your understanding and reinforce learning.
                    </li>
                    <li>
                        Full <strong>Webpages</strong> with comprehensive content on your topics.
                    </li>
                    <li>
                        Visual <strong>Mind Maps</strong> to see how concepts connect and relate.
                    </li>
                    <li>
                        Curated <strong>Learning Resources</strong> including videos, articles, tutorials, and documentation.
                    </li>
                </ul>
            </li>
        </ol>
        <p>Get ready to understand your homework better and study smarter!</p>
    </section>

    {/* Input Homework Section */}
    <section class="input-section card" aria-labelledby="input-heading">
        <h2 id="input-heading">
            <label for="text-paste">
                <span class="material-symbols-outlined" aria-hidden="true">edit</span>&nbsp;Input Homework & Options
            </label>
        </h2>
        <div id="text-input" class="input-area active-input">
            <textarea
                id="text-paste"
                placeholder={`Paste your ${modeName} problems here...
Please note that the AI will not provide the answer for your immediate question`}
                rows="12"
                aria-describedby="upload-note"
                aria-label={`Paste ${modeName} problems here`}
            ></textarea>
        </div>
        <p class="upload-note" id="upload-note">
            <span class="material-symbols-outlined" aria-hidden="true">upload_file</span>
            <span>
                Have your homework as a file? Once your chat starts, you can upload it from the <strong>Uploaded Files</strong> section in the chat sidebar (images, PDF, Word, PowerPoint, Excel and text files, up to 10 MB each).
            </span>
        </p>

        {/* Generate Button and Error Message */}
        <div class="toolbar" role="toolbar" aria-label="Generation controls">
            {/* <ModelSelector /> */}
            <FancyButton className="generate-button" onclick="generateOutput()" variant="primary" icon="manufacturing" aria-describedby="error-message">Generate Study Materials</FancyButton>
        </div>
        <div id="error-message" class="error-box" style="display: none" role="alert"></div>
    </section>
    <MessagesScript page="home" category={category} mode={mode} />
    <StepByStepScript />
</Layout>
