---
import '../../../styles/pages/index.scss';
import '../../../styles/pages/mode.scss';
import '../../../styles/components/step-by-step.scss';

import Layout from '../../../layouts/Layout.astro';
import FancyButton from '../../../components/fancy/Button.astro';
import Button from '../../../components/fancy/Button.astro';
import ModelSelector from '../../../components/ModelSelector.astro';
import MessagesScript from '../../../scripts/messages.astro';
import StepByStepScript from '../../../scripts/step-by-step.astro';

import categories from '../../../lib/modes';

// Use Clerk authentication
const { auth } = Astro.locals;
const { sessionClaims } = auth();
const user_email = sessionClaims?.email as string || null;

let { category, mode } = Astro.params || { category: '', mode: '' };

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

---
<Layout title="Home">
    <div id="user-email" data-email={user_email} style="display: none"></div>
    <!-- Introduction Section -->
    <section class="introduction-section card" aria-labelledby="how-it-works-heading">
        <h2 id="how-it-works-heading">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>&nbsp;How It Works
        </h2>
        <p>
            Welcome to <b>{modeObj?.name || 'Study'}</b>Wise! Turn your {modeObj?.name || ''} homework into powerful learning tools.
        </p>
        <ol class="steps-list">
            <li>
                <strong>Paste Your Homework:</strong> Copy your {modeObj?.name || ''} problems (plain text or simple equations like $f(x)=x^2$ into the text box below.
            </li>
            <li>
                <strong>Generate Materials:</strong> Click the "Generate Study Materials" button.
            </li>
            <li>
                <strong>Receive AI Insights:</strong> Our AI will analyze your problems and instantly create:
                <ul>
                    <li>
                        A personalized <strong>Study Guide</strong> explaining concepts, showing worked examples, providing practice problems, and defining key terms.
                    </li>
                    <li>
                        An <strong>Interactive Example Breakdown</strong> walking you through the steps of a typical problem.
                    </li>
                    <li>
                        A concise <strong>Reference Sheet</strong> with key formulas and definitions for quick review.
                    </li>
                </ul>
            </li>
            <li>
                <strong>Save/Print:</strong> Once generated, click the "Save/Print..." buttons to use your browser's print dialog (choose "Save as PDF").
            </li>
        </ol>
        <p>Get ready to understand your homework better and study smarter!</p>
    </section>

    <!-- Input Homework Section -->
    <section class="input-section card" aria-labelledby="input-heading">
        <h2 id="input-heading">
            <label for="text-paste">
                <span class="material-symbols-outlined" aria-hidden="true">edit</span>&nbsp;Input Homework & Options
            </label>
        </h2>
        <div id="text-input" class="input-area active-input">
            <textarea
                id="text-paste"
                placeholder={`Paste your ${modeObj?.name || ''} problems here... For example:
1. Solve for x: 2x + 5 = 11
2. Evaluate the limit: limit(from x to 0) for [(sin(x))/(x)]
3. Find the integral: integral(x^2 + 3)dx 
Please note that the AI will not provide the answer for your immediate equation`}
                rows="12"
                aria-label={`Paste ${modeObj?.name || ''} problems here`}
            ></textarea>
        </div>

        <!-- Generate Button and Error Message -->
        <div class="toolbar" role="toolbar" aria-label="Generation controls">
            <ModelSelector />
            <FancyButton id="generate-button" onclick="generateOutput()" variant="primary" icon="manufacturing" aria-describedby="error-message">Generate Study Materials</FancyButton>
            <Button id="generate-button-alt" onclick="generateOutput()" variant="primary" icon="manufacturing" style="display:none;" aria-describedby="error-message">Generate Study Materials</Button>
        </div>
        <div id="error-message" class="error-box" style="display: none" role="alert" aria-live="polite"></div>
    </section>
    <MessagesScript page="home" category={category} mode={mode} />
    <StepByStepScript />
</Layout>