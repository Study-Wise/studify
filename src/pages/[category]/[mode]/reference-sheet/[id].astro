---
import Layout from '@/layouts/Layout.astro';
import { getLatestReferenceSheet } from '@/lib/content/latest/reference-sheet';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import StepByStepScript from '@/scripts/step-by-step.astro';
import { marked } from 'marked';
import '@/styles/pages/content/reference-sheet.scss';
import categories from '@/lib/modes';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

// Validate category and mode exist
if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const user = Astro.locals.user;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user, category, mode);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!user && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest reference sheet only if authorized or public
const { content: latestReferenceSheet } = (isAuthorized || isPublic)
    ? await getLatestReferenceSheet(id || '')
    : { content: null };

// Parse markdown to HTML
const parsedContent = latestReferenceSheet ? await marked.parse(latestReferenceSheet) : null;
---

<Layout title={`Reference Sheet | ${modeName} | ${categoryName}`}  container={true}>
    <div class="reference-sheet-page">
        {!isAuthorized && !isPublic ? (
            <div class="empty-state">
                <span class="material-symbols-outlined">lock</span>
                <h2>Access Denied</h2>
                <p>You don't have permission to view this reference sheet. This thread belongs to another user.</p>
                <a href="/" class="btn-primary">Go Home</a>
            </div>
        ) : parsedContent ? (
            <div class="content-container">
                <div class="reference-sheet-content" set:html={parsedContent} />
            </div>
        ) : (
            <div class="empty-state">
                <span class="material-symbols-outlined">description</span>
                <h2>No Reference Sheet Found</h2>
                <p>There is no reference sheet generated for this conversation yet.</p>
            </div>
        )}
    </div>
    <StepByStepScript />
</Layout>
