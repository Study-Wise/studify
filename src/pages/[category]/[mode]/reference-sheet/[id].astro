---
import Layout from '@/layouts/Layout.astro';
import ContentActions from '@/components/ContentActions.astro';
import StepByStepScript from '@/scripts/step-by-step.astro';
import '@/styles/pages/content/reference-sheet.scss';
import '@/styles/pages/content/globals.scss';

import { marked } from 'marked';

import { getLatestReferenceSheet } from '@/lib/content/latest/reference-sheet';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import categories from '@/lib/modes';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

const user = Astro.locals.user;

const { isAuthorized, isPublic, threadExists } = await checkThreadAccess(id || '', user, category, mode);

// A deleted or unknown chat has no materials, so show the 404 page (#344)
if (!threadExists) {
    return new Response(null, { status: 404 });
}

if (!user && !isPublic) {
    return Astro.redirect('/user/sign-in');
}

const { content: latestReferenceSheet } = (isAuthorized || isPublic)
    ? await getLatestReferenceSheet(id || '')
    : { content: null };

const parsedContent = latestReferenceSheet ? await marked.parse(latestReferenceSheet) : null;
---

<Layout title={`Reference Sheet | ${modeName} | ${categoryName}`} className="reference-sheet-page content-page" mathjax={true}>
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this reference sheet.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="reference-sheet"
                threadId={id || ''}
                hasContent={!!parsedContent}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {parsedContent ? (
                <div class="content-container reference-sheet-content" set:html={parsedContent} />
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">description</span>
                    <h2>No Reference Sheet Found</h2>
                    <p>There is no reference sheet generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
    <StepByStepScript />
</Layout>
