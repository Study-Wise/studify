---
import categories from '@/lib/modes';
import { checkThreadAccess } from '@/lib/auth/check-thread-access';
import { getLatestWebpage } from '@/lib/content/latest/webpage';

import ContentActions from '@/components/ContentActions.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/webpage.scss';
import '@/styles/pages/content/globals.scss';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

const user = Astro.locals.user;

const { isAuthorized, isPublic, threadExists } = await checkThreadAccess(id || '', user, category, mode);

if (!threadExists) return new Response(null, { status: 404 });

if (!user && !isPublic) return Astro.redirect('/user/sign-in');

const { content: latestWebpage } = (isAuthorized || isPublic)
    ? await getLatestWebpage(id || '')
    : { content: null };

// Convert to data URL to avoid attribute escaping
let webpageDataUrl = '';
if (latestWebpage) {
    const base64 = Buffer.from(latestWebpage).toString('base64');
    webpageDataUrl = `data:text/html;base64,${base64}`;
}
---

<Layout title={`Webpage | ${modeName} | ${categoryName}`} className="webpage-page content-page" container={false}>
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this webpage.</p>
            <a href="/" class="btn primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="webpage"
                threadId={id || ''}
                hasContent={!!latestWebpage}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {webpageDataUrl ? (
                <div class="content-container webpage-container">
                    <iframe src={webpageDataUrl} title="Generated Webpage" sandbox="allow-scripts" />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">web</span>
                    <h2>No Webpage Found</h2>
                    <p>There is no webpage generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
