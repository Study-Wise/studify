---
import { getLatestWebpage } from '../../../../lib/content/latest/webpage';
import { checkThreadAccess } from '../../../../lib/auth/checkThreadAccess';

const { category, mode, id } = Astro.params;

// Get user authentication
const { auth } = Astro.locals;
const { userId } = auth();

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', auth, category, mode, Astro);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!userId && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest webpage only if authorized or public
const { content: latestWebpage } = (isAuthorized || isPublic)
    ? await getLatestWebpage(id || '')
    : { content: null };

// If authorized but no content, show empty state
// If not authorized and not public, show access denied
const showAccessDenied = !isAuthorized && !isPublic;
const showEmptyState = (isAuthorized || isPublic) && !latestWebpage;
const showContent = (isAuthorized || isPublic) && latestWebpage;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Webpage</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #f5f5f5;
        }

        .error-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem;
            text-align: center;
        }

        .error-container .material-symbols-outlined {
            font-size: 4rem;
            color: #666;
            margin-bottom: 1rem;
        }

        .error-container h2 {
            font-size: 1.5rem;
            color: #333;
            margin-bottom: 0.5rem;
        }

        .error-container p {
            color: #666;
            margin-bottom: 1.5rem;
        }

        .btn-primary {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: background 0.2s;
        }

        .btn-primary:hover {
            background: #0056b3;
        }

        iframe {
            width: 100%;
            height: 100vh;
            border: none;
        }
    </style>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
</head>
<body>
    {showAccessDenied ? (
        <div class="error-container">
            <span class="material-symbols-outlined">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this webpage. This thread belongs to another user.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : showEmptyState ? (
        <div class="error-container">
            <span class="material-symbols-outlined">web</span>
            <h2>No Webpage Found</h2>
            <p>There is no webpage generated for this conversation yet.</p>
        </div>
    ) : showContent ? (
        <iframe srcdoc={latestWebpage} title="Generated Webpage" sandbox="allow-scripts allow-same-origin"></iframe>
    ) : null}
</body>
</html>
