---
import Layout from '@/layouts/Layout.astro';
import ContentActions from '@/components/ContentActions.astro';
import '@/styles/pages/content/webpage.scss';
import '@/styles/pages/content/globals.scss';

import { getLatestWebpage } from '@/lib/content/latest/webpage';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import categories from '@/lib/modes';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

// Validate category and mode exist
if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const user = Astro.locals.user;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user, category, mode);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!user && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest webpage only if authorized or public
const { content: latestWebpage } = (isAuthorized || isPublic)
    ? await getLatestWebpage(id || '')
    : { content: null };
---

<Layout title={`Webpage | ${modeName} | ${categoryName}`} className="webpage-page content-page" container={true}>
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this webpage. This thread belongs to another user.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="webpage"
                threadId={id || ''}
                hasContent={!!latestWebpage}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {latestWebpage ? (
                <div class="content-container webpage-container">
                    <iframe srcdoc={latestWebpage} title="Generated Webpage" sandbox="allow-scripts allow-same-origin" />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined">web</span>
                    <h2>No Webpage Found</h2>
                    <p>There is no webpage generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
