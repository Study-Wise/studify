---
import Layout from '@/layouts/Layout.astro';
import ContentActions from '@/components/ContentActions.astro';
import { getLatestFlashcards } from '@/lib/content/latest/flashcards';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import { marked } from 'marked';
import '@/styles/pages/content/flashcards.scss';
import categories from '@/lib/modes';
import type { FlashcardData } from '@/lib/types';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

// Validate category and mode exist
if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const user = Astro.locals.user;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user, category, mode);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!user && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest flashcards only if authorized or public
const { content: latestFlashcards } = (isAuthorized || isPublic)
    ? await getLatestFlashcards(id || '')
    : { content: null };

// Determine if content is structured (object with text/questions) or legacy (string)
const isStructured = latestFlashcards && typeof latestFlashcards === 'object' && 'text' in latestFlashcards;
const flashcardData = isStructured ? latestFlashcards as FlashcardData : null;

// Parse markdown to HTML for legacy string format
const parsedContent = (!isStructured && typeof latestFlashcards === 'string')
    ? await marked.parse(latestFlashcards)
    : null;

const hasContent = !!(isStructured ? (flashcardData && flashcardData.questions.length > 0) : parsedContent);
---

<Layout title={`Flashcards | ${modeName} | ${categoryName}`} container={true}>
    <div class="flashcard-page">
        {!isAuthorized && !isPublic ? (
            <div class="empty-state">
                <span class="material-symbols-outlined">lock</span>
                <h2>Access Denied</h2>
                <p>You don't have permission to view these flashcards. This thread belongs to another user.</p>
                <a href="/" class="btn-primary">Go Home</a>
            </div>
        ) : (
            <>
                <ContentActions
                    contentType="flashcards"
                    threadId={id || ''}
                    hasContent={hasContent}
                    isAuthorized={isAuthorized}
                    chatUrl={chatUrl}
                />
                {isStructured && flashcardData && flashcardData.questions.length > 0 ? (
                    <div class="content-container quizlet-flashcards">
                        {flashcardData.text && (
                            <div class="flashcard-intro" set:html={marked.parse(flashcardData.text)} />
                        )}
                        <div class="flashcard-deck" data-current="0">
                            <div class="flashcard-progress">
                                <span class="current">1</span> / <span class="total">{flashcardData.questions.length}</span>
                            </div>
                            <div class="flashcard-container">
                                {flashcardData.questions.map((card, index) => (
                                    <div class="flashcard" data-index={index} data-flipped="false">
                                        <div class="flashcard-inner">
                                            <div class="flashcard-front">
                                                <div class="card-label">Question</div>
                                                <div class="card-content" set:html={marked.parse(card.front)} />
                                            </div>
                                            <div class="flashcard-back">
                                                <div class="card-label">Answer</div>
                                                <div class="card-content" set:html={marked.parse(card.back)} />
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                            <div class="flashcard-controls">
                                <button class="control-btn prev" disabled>
                                    <span class="material-symbols-outlined">chevron_left</span>
                                </button>
                                <button class="control-btn flip">
                                    <span class="material-symbols-outlined">flip</span>
                                    Flip
                                </button>
                                <button class="control-btn next">
                                    <span class="material-symbols-outlined">chevron_right</span>
                                </button>
                            </div>
                        </div>
                    </div>
                ) : parsedContent ? (
                    <div class="content-container">
                        <div class="flashcard-content" set:html={parsedContent} />
                    </div>
                ) : (
                    <div class="empty-state">
                        <span class="material-symbols-outlined">style</span>
                        <h2>No Flashcards Found</h2>
                        <p>There are no flashcards generated for this conversation yet.</p>
                    </div>
                )}
            </>
        )}
    </div>
</Layout>

<script>
    function initFlashcards() {
        const deck = document.querySelector('.flashcard-deck') as HTMLElement;
        if (!deck) return;

        const flashcards = deck.querySelectorAll('.flashcard') as NodeListOf<HTMLElement>;
        const prevBtn = deck.querySelector('.prev') as HTMLButtonElement;
        const nextBtn = deck.querySelector('.next') as HTMLButtonElement;
        const flipBtn = deck.querySelector('.flip') as HTMLButtonElement;
        const currentSpan = deck.querySelector('.current') as HTMLElement;

        let currentIndex = 0;

        function updateDisplay() {
            flashcards.forEach((card, i) => {
                card.style.display = i === currentIndex ? 'block' : 'none';
                if (i !== currentIndex) {
                    card.dataset.flipped = 'false';
                }
            });
            currentSpan.textContent = String(currentIndex + 1);
            prevBtn.disabled = currentIndex === 0;
            nextBtn.disabled = currentIndex === flashcards.length - 1;
        }

        function flipCurrent() {
            const current = flashcards[currentIndex];
            current.dataset.flipped = current.dataset.flipped === 'true' ? 'false' : 'true';
        }

        prevBtn?.addEventListener('click', () => {
            if (currentIndex > 0) {
                currentIndex--;
                updateDisplay();
            }
        });

        nextBtn?.addEventListener('click', () => {
            if (currentIndex < flashcards.length - 1) {
                currentIndex++;
                updateDisplay();
            }
        });

        flipBtn?.addEventListener('click', flipCurrent);

        // Click on card to flip
        flashcards.forEach(card => {
            card.addEventListener('click', () => {
                card.dataset.flipped = card.dataset.flipped === 'true' ? 'false' : 'true';
            });
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft' && currentIndex > 0) {
                currentIndex--;
                updateDisplay();
            }
            else if (e.key === 'ArrowRight' && currentIndex < flashcards.length - 1) {
                currentIndex++;
                updateDisplay();
            }
            else if (e.key === ' ' || e.key === 'Enter') {
                e.preventDefault();
                flipCurrent();
            }
        });

        updateDisplay();
    }

    // Initialize on page load
    initFlashcards();

    // Re-initialize on Astro page transitions
    document.addEventListener('astro:page-load', initFlashcards);
</script>
