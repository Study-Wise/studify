---
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import { getLatestFlashcards, type FlashcardData } from '@/lib/content/latest/flashcards';
import categories from '@/lib/modes';
import { Marked, type TokenizerAndRendererExtension } from 'marked';

import ContentActions from '@/components/ContentActions.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/flashcards.scss';
import '@/styles/pages/content/globals.scss';

// Pass $…$ and $$…$$ through untouched so MathJax gets the LaTeX as written.
// Otherwise marked reads backslash escapes like \, as Markdown and drops the backslash.
const mathExtension: TokenizerAndRendererExtension = {
    name: 'math',
    level: 'inline',
    start: (src) => src.indexOf('$'),
    tokenizer: (src) => {
        const match = /^\$\$[\s\S]+?\$\$|^\$[^$\n]+?\$/.exec(src);
        return match ? { type: 'math', raw: match[0] } : undefined;
    },
    renderer: (token) => token.raw.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'),
};
const marked = new Marked({ extensions: [mathExtension] });

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

const user = Astro.locals.user;

const { isAuthorized, isPublic, threadExists } = await checkThreadAccess(id || '', user, category, mode);

// A deleted or unknown chat has no materials, so show the 404 page (#344)
if (!threadExists) { return new Response(null, { status: 404 }); }

if (!user && !isPublic) { return Astro.redirect('/user/sign-in'); }

const { content: latestFlashcards } = (isAuthorized || isPublic)
    ? await getLatestFlashcards(id || '')
    : { content: null };

// Determine if content is structured (object with text/questions) or legacy (string)
const flashcardData: FlashcardData | null = latestFlashcards && typeof latestFlashcards === 'object'
    ? latestFlashcards
    : null;
const isStructured = flashcardData !== null;

// Parse markdown to HTML for legacy string format
const parsedContent = (!isStructured && typeof latestFlashcards === 'string')
    ? await marked.parse(latestFlashcards)
    : null;

const hasContent = !!(isStructured ? (flashcardData && flashcardData.questions.length > 0) : parsedContent);
---

<Layout title={`Flashcards | ${modeName} | ${categoryName}`} className="flashcard-page content-page" mathjax={true}>
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view these flashcards.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="flashcards"
                threadId={id || ''}
                hasContent={hasContent}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {isStructured && flashcardData && flashcardData.questions.length > 0 ? (
                <div class="content-container quizlet-flashcards">
                    {flashcardData.text && (
                        <div class="flashcard-intro" set:html={marked.parse(flashcardData.text)} />
                    )}
                    <div class="flashcard-deck" data-current="0">
                        <div class="flashcard-progress">
                            <span class="current">1</span> / <span class="total">{flashcardData.questions.length}</span>
                        </div>
                        <div class="flashcard-container">
                            {flashcardData.questions.map((card, index) => (
                                <div class="flashcard" data-index={index} data-flipped="false">
                                    <div class="flashcard-inner">
                                        <div class="flashcard-front">
                                            <div class="card-label">Question</div>
                                            <div class="card-content" set:html={marked.parse(card.front)} />
                                        </div>
                                        <div class="flashcard-back">
                                            <div class="card-label">Answer</div>
                                            <div class="card-content" set:html={marked.parse(card.back)} />
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                        <div class="flashcard-controls">
                            <button type="button" class="control-btn prev" aria-label="Previous card" disabled>
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                            </button>
                            <button type="button" class="control-btn flip">
                                <span class="material-symbols-outlined" aria-hidden="true">flip</span>
                                Flip
                            </button>
                            <button type="button" class="control-btn next" aria-label="Next card">
                                <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                            </button>
                        </div>
                    </div>
                </div>
            ) : parsedContent ? (
                <div class="content-container">
                    <div class="flashcard-content" set:html={parsedContent} />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">style</span>
                    <h2>No Flashcards Found</h2>
                    <p>There are no flashcards generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>

<script>
    function initFlashcards() {
        const deck = document.querySelector('.flashcard-deck');
        if (!(deck instanceof window.HTMLElement)) return;

        const flashcards = Array.from(deck.querySelectorAll('.flashcard')).filter((card): card is HTMLElement => card instanceof window.HTMLElement);

        const prevBtn = deck.querySelector<HTMLButtonElement>('.prev');
        const nextBtn = deck.querySelector<HTMLButtonElement>('.next');
        const flipBtn = deck.querySelector<HTMLButtonElement>('.flip');
        const currentSpan = deck.querySelector<HTMLElement>('.current');

        if (!(prevBtn instanceof window.HTMLButtonElement) || !(nextBtn instanceof window.HTMLButtonElement) || !(flipBtn instanceof window.HTMLButtonElement) || !(currentSpan instanceof window.HTMLElement)) return;

        let currentIndex = 0;

        function updateDisplay() {
            flashcards.forEach((card, i) => {
                card.style.display = i === currentIndex ? 'block' : 'none';
                if (i !== currentIndex) {
                    card.dataset.flipped = 'false';
                }
            });
            if (currentSpan) currentSpan.textContent = String(currentIndex + 1);
            if (prevBtn) prevBtn.disabled = currentIndex === 0;
            if (nextBtn) nextBtn.disabled = currentIndex === flashcards.length - 1;
        }

        function flipCurrent() {
            const current = flashcards[currentIndex];
            if (current) current.dataset.flipped = current.dataset.flipped === 'true' ? 'false' : 'true';
        }

        prevBtn?.addEventListener('click', () => {
            if (currentIndex > 0) {
                currentIndex--;
                updateDisplay();
            }
        });

        nextBtn?.addEventListener('click', () => {
            if (currentIndex < flashcards.length - 1) {
                currentIndex++;
                updateDisplay();
            }
        });

        flipBtn?.addEventListener('click', flipCurrent);

        flashcards.forEach(card => {
            card.addEventListener('click', () => {
                card.dataset.flipped = card.dataset.flipped === 'true' ? 'false' : 'true';
            });
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft' && currentIndex > 0) {
                currentIndex--;
                updateDisplay();
            }
            else if (e.key === 'ArrowRight' && currentIndex < flashcards.length - 1) {
                currentIndex++;
                updateDisplay();
            }
            else if (e.key === ' ' || e.key === 'Enter') {
                // Let focused controls handle Enter/Space themselves (activating buttons and links)
                if (e.target instanceof Element && e.target.closest('button, a, input, textarea, select')) return;
                e.preventDefault();
                flipCurrent();
            }
        });

        updateDisplay();
    }

    initFlashcards();

    // Re-initialize on Astro page transitions
    document.addEventListener('astro:page-load', initFlashcards);
</script>
