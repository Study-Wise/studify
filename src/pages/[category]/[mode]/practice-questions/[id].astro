---
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import { getLatestPracticeQuestions } from '@/lib/content/latest/practice-questions';
import categories from '@/lib/modes';
import { marked } from 'marked';

import ContentActions from '@/components/ContentActions.astro';
import Layout from '@/layouts/Layout.astro';
import StepByStepScript from '@/scripts/step-by-step.astro';
import '@/styles/pages/content/globals.scss';
import '@/styles/pages/content/practice-questions.scss';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

const user = Astro.locals.user;

const { isAuthorized, isPublic, threadExists } = await checkThreadAccess(id || '', user, category, mode);

// A deleted or unknown chat has no materials, so show the 404 page (#344)
if (!threadExists) { return new Response(null, { status: 404 }); }

if (!user && !isPublic) { return Astro.redirect('/user/sign-in'); }

const { content: latestPracticeQuestions } = (isAuthorized || isPublic)
    ? await getLatestPracticeQuestions(id || '')
    : { content: null };

const parsedContent = latestPracticeQuestions ? await marked.parse(latestPracticeQuestions) : null;
---

<Layout title={`Practice Questions | ${modeName} | ${categoryName}`} className="practice-questions-page content-page" mathjax={true}>
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view these practice questions.</p>
            <a href="/" class="btn-primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="practice-questions"
                threadId={id || ''}
                hasContent={!!parsedContent}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {parsedContent ? (
                <div class="content-container practice-questions-content" set:html={parsedContent} />
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">quiz</span>
                    <h2>No Practice Questions Found</h2>
                    <p>There are no practice questions generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
    <StepByStepScript />
    <script is:inline>
        // Adds a "Retry wrong ones" button to each quiz, shown once a question has been answered wrongly
        document.querySelectorAll('.practice-questions-content .step-by-step').forEach(section => {
            const retryButton = document.createElement('button');
            retryButton.type = 'button';
            retryButton.className = 'retry-wrong';
            retryButton.textContent = 'Retry wrong ones';
            retryButton.hidden = true;
            section.append(retryButton);

            const getWrongSteps = () => [...section.querySelectorAll('.step')].filter(step => {
                const selected = step.querySelector('.step-question-choice[data-variant="selected"]');
                return selected && selected.dataset.type !== 'correct';
            });

            section.addEventListener('click', () => {
                retryButton.hidden = getWrongSteps().length === 0;
            });

            retryButton.addEventListener('click', () => {
                getWrongSteps().forEach(step => {
                    step.querySelectorAll('.step-question-choice').forEach(choice => {
                        delete choice.dataset.variant;
                        choice.querySelector('.step-question-radio').checked = false;
                    });
                    delete step.querySelector('.step-question-choices').dataset.answered;
                    step.querySelectorAll('.answer-explanation').forEach(explanation => delete explanation.dataset.visible);
                });
                retryButton.hidden = true;
            });
        });
    </script>
</Layout>
