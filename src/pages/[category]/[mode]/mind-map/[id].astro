---
import categories from '@/lib/modes';
import { checkThreadAccess } from '@/lib/auth/check-thread-access';
import { getLatestMindMap } from '@/lib/content/latest/mind-map';

import ContentActions from '@/components/ContentActions.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/globals.scss';
import '@/styles/pages/content/mind-map.scss';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

const user = Astro.locals.user;

const { isAuthorized, isPublic, threadExists } = await checkThreadAccess(id || '', user, category, mode);

if (!threadExists) return new Response(null, { status: 404 });

if (!user && !isPublic) return Astro.redirect('/user/sign-in');

const { content: latestMindMap } = (isAuthorized || isPublic)
    ? await getLatestMindMap(id || '')
    : { content: null };

let mindMapDataUrl = '';
if (latestMindMap) {
    const base64 = Buffer.from(latestMindMap).toString('base64');
    mindMapDataUrl = `data:text/html;base64,${base64}`;
}
---

<Layout title={`Mind Map | ${modeName} | ${categoryName}`} className="mind-map-page content-page" container={false}>
    {!isAuthorized && !isPublic ? (
        <div class="empty-state">
            <span class="material-symbols-outlined" aria-hidden="true">lock</span>
            <h2>Access Denied</h2>
            <p>You don't have permission to view this mind map.</p>
            <a href="/" class="btn primary">Go Home</a>
        </div>
    ) : (
        <>
            <ContentActions
                contentType="mind-map"
                threadId={id || ''}
                hasContent={!!latestMindMap}
                isAuthorized={isAuthorized}
                chatUrl={chatUrl}
            />
            {mindMapDataUrl ? (
                <div class="content-container mind-map-container">
                    <iframe
                        src={mindMapDataUrl}
                        title="Mind Map"
                        class="mind-map-iframe"
                        sandbox="allow-scripts"
                    />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">hub</span>
                    <h2>No Mind Map Found</h2>
                    <p>There is no mind map generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
