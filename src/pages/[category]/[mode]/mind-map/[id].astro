---
import categories from '@/lib/modes';
import { getThreadByToken } from '@/lib/threads';
import { getLatestMindMap } from '@/lib/content/latest/mind-map';

import ContentActions from '@/components/ContentActions.astro';
import AccessDenied from '@/components/content/AccessDenied.astro';
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/content/globals.scss';
import '@/styles/pages/content/mind-map.scss';

const { category, mode, id } = Astro.params;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

if (!categoryObj || !modeObj) return Astro.redirect('/404');

if (!await getThreadByToken(id || '', true)) return new Response(null, { status: 404 });

if (!Astro.locals.user) return Astro.redirect('/user/sign-in');

const latestMindMap = await getLatestMindMap(id || '', Astro.locals.user);

let mindMapDataUrl = '';
if (latestMindMap?.content) {
    const base64 = Buffer.from(latestMindMap.content).toString('base64');
    mindMapDataUrl = `data:text/html;base64,${base64}`;
}
---
<Layout title={`Mind Map | ${modeObj.name} | ${categoryObj.name}`} className="mind-map-page content-page" container={false}>
    {!latestMindMap ? (
        <AccessDenied />
    ) : (
        <>
            <ContentActions threadId={id || ''} hasContent={!!latestMindMap.content} />
            {mindMapDataUrl ? (
                <div class="content-container mind-map-page__container">
                    <iframe src={mindMapDataUrl} title="Mind Map" class="mind-map-page__iframe" sandbox="allow-scripts" />
                </div>
            ) : (
                <div class="empty-state">
                    <span class="material-symbols-outlined" aria-hidden="true">hub</span>
                    <h2>No Mind Map Found</h2>
                    <p>There is no mind map generated for this conversation yet.</p>
                </div>
            )}
        </>
    )}
</Layout>
