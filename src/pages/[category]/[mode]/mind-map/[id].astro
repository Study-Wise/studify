---
import Layout from '@/layouts/Layout.astro';
import ContentActions from '@/components/ContentActions.astro';
import '@/styles/pages/content/mind-map.scss';

import { getLatestMindMap } from '@/lib/content/latest/mind-map';
import { checkThreadAccess } from '@/lib/auth/checkThreadAccess';
import categories from '@/lib/modes';

const { category, mode, id } = Astro.params;
const chatUrl = `/${category}/${mode}/chat/${id}`;

const categoryObj = category ? categories[category] : null;
const modeObj = categoryObj?.modes?.[mode || ''];

// Validate category and mode exist
if (!categoryObj || !modeObj) {
    return Astro.redirect('/404');
}

const categoryName = categoryObj?.name || category;
const modeName = modeObj?.name || mode;

// Get user authentication
const user = Astro.locals.user;

// Check thread access first
const { isAuthorized, isPublic } = await checkThreadAccess(id || '', user, category, mode);

// Redirect to sign-in only if not authenticated AND thread is not public
if (!user && !isPublic) {
    return Astro.redirect("/user/sign-in");
}

// Get the latest mind map only if authorized or public
const { content: latestMindMap } = (isAuthorized || isPublic)
    ? await getLatestMindMap(id || '')
    : { content: null };
---

<Layout title={`Mind Map | ${modeName} | ${categoryName}`}  container={true}>
    <div class="mind-map-page">
        {!isAuthorized && !isPublic ? (
            <div class="empty-state">
                <span class="material-symbols-outlined">lock</span>
                <h2>Access Denied</h2>
                <p>You don't have permission to view this mind map. This thread belongs to another user.</p>
                <a href="/" class="btn-primary">Go Home</a>
            </div>
        ) : (
            <>
                <ContentActions
                    contentType="mind-map"
                    threadId={id || ''}
                    hasContent={!!latestMindMap}
                    isAuthorized={isAuthorized}
                    chatUrl={chatUrl}
                />
                {latestMindMap ? (
                    <div class="content-container mind-map-container">
                        <iframe
                            srcdoc={latestMindMap}
                            title="Mind Map"
                            class="mind-map-iframe"
                            sandbox="allow-scripts allow-same-origin"
                        />
                    </div>
                ) : (
                    <div class="empty-state">
                        <span class="material-symbols-outlined">hub</span>
                        <h2>No Mind Map Found</h2>
                        <p>There is no mind map generated for this conversation yet.</p>
                    </div>
                )}
            </>
        )}
    </div>
</Layout>
