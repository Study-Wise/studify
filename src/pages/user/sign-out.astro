---
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/sign-out.scss';

const user = Astro.locals.user;

// If not signed in, redirect to home
if (!user) {
    return Astro.redirect('/');
}
---

<Layout title="Sign Out">
    <div class="sign-out-container">
        <div class="sign-out-card">
            <span class="material-symbols-outlined sign-out-icon">logout</span>
            <h1>Sign Out</h1>
            <p>Are you sure you want to sign out?</p>

            <div class="button-group">
                <button id="signout-confirm-btn" class="btn btn-primary">
                    <span class="material-symbols-outlined">logout</span>
                    Yes, Sign Out
                </button>

                <a href="/" class="btn btn-secondary">
                    <span class="material-symbols-outlined">close</span>
                    Cancel
                </a>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { authClient } from '@/lib/auth/client';

    const signoutBtn = document.getElementById('signout-confirm-btn');
    signoutBtn?.addEventListener('click', async () => {
        try {
            await authClient.signOut();
            window.location.href = '/';
        } catch (error) {
            console.error('Sign out error:', error);
            alert('Sign out failed. Please try again.');
        }
    });
</script>
