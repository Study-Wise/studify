---
import Layout from '../../layouts/Layout.astro';
import { SignOutButton } from '@clerk/astro/components';
import '../../styles/pages/sign-out.scss';

// Check if user is authenticated
const auth = Astro.locals.auth;
const { userId } = auth();

// If not signed in, redirect to home
if (!userId) {
    return Astro.redirect("/");
}
---

<Layout title="Sign Out">
    <div class="sign-out-container">
        <div class="sign-out-card">
            <span class="material-symbols-outlined sign-out-icon">logout</span>
            <h1>Sign Out</h1>
            <p>Are you sure you want to sign out?</p>

            <div class="button-group">
                <SignOutButton redirectUrl="/">
                    <button class="btn btn-primary">
                        <span class="material-symbols-outlined">logout</span>
                        Yes, Sign Out
                    </button>
                </SignOutButton>

                <a href="/" class="btn btn-secondary">
                    <span class="material-symbols-outlined">close</span>
                    Cancel
                </a>
            </div>
        </div>
    </div>
</Layout>
