---
import Layout from '@/layouts/Layout.astro';
import SignOutScript from '@/scripts/auth/sign-out.astro';
import '@/styles/pages/sign-out.scss';

const user = Astro.locals.user;

if (!user) return Astro.redirect('/');
---

<Layout title="Sign Out">
    <div class="sign-out-container">
        <div class="sign-out-card">
            <span class="material-symbols-outlined sign-out-icon" aria-hidden="true">logout</span>
            <h1>Sign Out</h1>
            <p>Are you sure you want to sign out?</p>

            <div class="button-group">
                <button type="button" id="signout-confirm-btn" class="btn btn-primary">
                    <span class="material-symbols-outlined" aria-hidden="true">logout</span>
                    Yes, Sign Out
                </button>

                <a href="/" class="btn btn-secondary">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                    Cancel
                </a>
            </div>
        </div>
    </div>
</Layout>
<SignOutScript />
