---
import appConfig from '@/lib/app.config';
import { getSafeReturnBackUrl, withReturnBackUrl } from '@/lib/auth/return-url';

import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/auth.scss';
import UserScript from '@/scripts/user.astro';

const redirectUrl = getSafeReturnBackUrl(Astro.url.searchParams.get('returnBackUrl'));

if (Astro.locals.user) return Astro.redirect(redirectUrl);

const callbackURL = `/user/sso-callback?returnBackUrl=${encodeURIComponent(redirectUrl)}`;
---

<Layout title="Sign Up" className="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="auth-title">Sign Up</h1>
            <p class="auth-subtitle">to access {appConfig.name}</p>

            <form id="signup-form" class="auth-form">
                <div class="form-group">
                    <label for="name" class="form-label">Name (optional)</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-input"
                        autocomplete="name"
                    />
                </div>
                <div class="form-group">
                    <label for="email" class="form-label">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-input"
                        required
                        autocomplete="email"
                    />
                </div>
                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-input"
                        required
                        autocomplete="new-password"
                        minlength="8"
                    />
                </div>
                <div id="error-message" class="error-message" style="display: none;"></div>
                <button type="submit" class="auth-button">Sign Up</button>
            </form>

            <div class="auth-divider">
                <span>or</span>
            </div>

            <div class="social-buttons" data-callback-url={callbackURL}>
                <button type="button" class="social-button" data-provider="google">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" fill="#4285F4"/>
                        <path d="M9.003 18c2.43 0 4.467-.806 5.956-2.18L12.05 13.56c-.806.54-1.836.86-3.047.86-2.344 0-4.328-1.584-5.036-3.711H.96v2.332C2.44 15.983 5.485 18 9.003 18z" fill="#34A853"/>
                        <path d="M3.964 10.712c-.18-.54-.282-1.117-.282-1.71 0-.593.102-1.17.282-1.71V4.96H.957C.347 6.175 0 7.55 0 9.002c0 1.452.348 2.827.957 4.042l3.007-2.332z" fill="#FBBC05"/>
                        <path d="M9.003 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.464.891 11.428 0 9.003 0 5.485 0 2.44 2.017.96 4.958L3.967 7.29c.708-2.127 2.692-3.71 5.036-3.71z" fill="#EA4335"/>
                    </svg>
                    Continue with Google
                </button>
                <button type="button" class="social-button" data-provider="github">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M9 0C4.0275 0 0 4.13211 0 9.22807C0 13.3062 2.5785 16.7595 6.15375 17.9841C6.60375 18.0709 6.76875 17.7853 6.76875 17.5403C6.76875 17.3212 6.76125 16.7235 6.7575 15.9289C4.254 16.4686 3.726 14.6604 3.726 14.6604C3.3165 13.5955 2.72475 13.3109 2.72475 13.3109C1.9095 12.7571 2.78775 12.7688 2.78775 12.7688C3.6915 12.8329 4.16625 13.6981 4.16625 13.6981C4.96875 15.0616 6.273 14.6604 6.7875 14.4243C6.8685 13.8317 7.10025 13.4305 7.35675 13.1993C5.35875 12.9661 3.258 12.1845 3.258 8.6763C3.258 7.67658 3.60825 6.85902 4.18425 6.21762C4.083 5.98357 3.77925 5.05064 4.263 3.78925C4.263 3.78925 5.01675 3.54004 6.738 4.71982C7.458 4.51522 8.223 4.41293 8.988 4.40907C9.753 4.41293 10.518 4.51522 11.238 4.71982C12.948 3.54004 13.7017 3.78925 13.7017 3.78925C14.1855 5.05064 13.8818 5.98357 13.7917 6.21762C14.3655 6.85902 14.7157 7.67658 14.7157 8.6763C14.7157 12.1935 12.6105 12.9626 10.608 13.1903C10.923 13.4677 11.2155 14.0279 11.2155 14.8826C11.2155 16.1061 11.2043 17.0922 11.2043 17.5403C11.2043 17.7877 11.3625 18.0764 11.8238 17.9841C15.4162 16.7589 18 13.3062 18 9.22807C18 4.13211 13.9703 0 9 0Z"/>
                    </svg>
                    Continue with GitHub
                </button>
            </div>

            <div class="footer-links">
                <p>Already have an account? <a href={withReturnBackUrl('/user/sign-in', redirectUrl)} class="footer-link">Sign in</a></p>
            </div>
        </div>
    </div>
    <UserScript />
</Layout>

<script>
    import { signUp } from '@/lib/auth/client';
    import { getSafeReturnBackUrl as getClientSafeReturnBackUrl } from '@/lib/auth/return-url';

    const form = document.querySelector('#signup-form');
    if (!(form instanceof window.HTMLFormElement)) throw new Error('Sign-up form was not found.');
    const { showError, hideError } = window.authUtils;

    form?.addEventListener('submit', async e => {
        e.preventDefault();
        hideError();

        const formData = new window.FormData(form);
        const nameValue = formData.get('name');
        const email = formData.get('email');
        const password = formData.get('password');
        const name = typeof nameValue === 'string' ? nameValue : '';
        if (typeof email !== 'string' || typeof password !== 'string') return;

        try {
            const { error } = await signUp.email({
                email,
                password,
                name,
            });

            if (error) {
                showError(error.message || 'Sign up failed. Please try again.');
            }
            else {
                window.location.href = getClientSafeReturnBackUrl(new URLSearchParams(window.location.search).get('returnBackUrl'));
            }
        } catch (error) {
            console.error('Sign up error:', error);
            showError('Sign up failed. Please try again.');
        }
    });
</script>
