---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/auth.scss';

const redirectUrl = Astro.url.searchParams.get('returnBackUrl') || '/';

// Check if user is already authenticated
if (Astro.locals.user) {
    return Astro.redirect(redirectUrl);
}
---

<Layout title="Completing Sign In" className="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="auth-title">Completing authentication...</h1>
            <p class="auth-subtitle">Please wait while we sign you in</p>
            <div class="loading-spinner"></div>
        </div>
    </div>
</Layout>

<script>
    // Neon Auth handles OAuth callback automatically
    // Just wait for session to be established, then redirect
    const redirectUrl = new URLSearchParams(window.location.search).get('returnBackUrl') || '/';

    // Give Neon Auth time to set session cookie
    setTimeout(() => {
        window.location.href = redirectUrl;
    }, 1500);
</script>

<style>
    .loading-spinner {
        width: 40px;
        height: 40px;
        margin: 2rem auto;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #6366f1;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
