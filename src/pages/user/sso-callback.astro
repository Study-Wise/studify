---
import { getSafeReturnBackUrl } from '@/lib/auth/return-url';

import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/auth.scss';

if (Astro.locals.user) return Astro.redirect(getSafeReturnBackUrl(Astro.url.searchParams.get('returnBackUrl')));
---

<Layout title="Completing Sign In" className="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="auth-title">Completing authentication...</h1>
            <p class="auth-subtitle">Please wait while we sign you in</p>
            <div class="loading-spinner"></div>
        </div>
    </div>
</Layout>

<script is:inline define:vars={{ getSafeReturnBackUrl }}>
    async function completeOAuth() {
        const redirectUrl = getSafeReturnBackUrl(new URLSearchParams(window.location.search).get('returnBackUrl'));

        try {
            // Better Auth automatically handles the OAuth callback
            // Just redirect to the intended destination
            // The session is already established via cookies
            window.location.replace(redirectUrl);
        } catch (error) {
            console.error('OAuth callback error:', error);
            setTimeout(() => window.location.replace(redirectUrl), 500);
        }
    }

    completeOAuth();
</script>
