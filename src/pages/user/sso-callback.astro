---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/auth.scss';

const redirectUrl = Astro.url.searchParams.get('returnBackUrl') || '/';

// Check if user is already authenticated
if (Astro.locals.user) {
    return Astro.redirect(redirectUrl);
}
---

<Layout title="Completing Sign In" className="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="auth-title">Completing authentication...</h1>
            <p class="auth-subtitle">Please wait while we sign you in</p>
            <div class="loading-spinner"></div>
        </div>
    </div>
</Layout>

<script>
    import { authClient } from '../../lib/auth-client';

    async function completeOAuth() {
        const redirectUrl = new URLSearchParams(window.location.search).get('returnBackUrl') || '/';
        try {
            // Get session to complete OAuth and update client state
            const session = await authClient.getSession();
            console.log('OAuth session established:', session);

            // Wait for cookies
            await new Promise(resolve => setTimeout(resolve, 200));

            // Force a full page reload to ensure middleware runs
            window.location.replace(redirectUrl);
        } catch (error) {
            console.error('OAuth error:', error);
            // Fallback: try redirecting anyway
            setTimeout(() => window.location.replace(redirectUrl), 500);
        }
    }

    completeOAuth();
</script>

<style>
    .loading-spinner {
        width: 40px;
        height: 40px;
        margin: 2rem auto;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #6366f1;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
