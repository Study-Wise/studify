---
import Layout from '../../layouts/Layout.astro';

import { authClient } from "../../lib/auth-client";
let error = "";
async function handleEmailSignUp(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const email = String(formData.get('email') || '');
    const password = String(formData.get('password') || '');
    const name = String(formData.get('name') || '');
    try {
        await authClient.signUp.email({ email, password, name });
        window.location.href = '/';
    } catch (err) {
        error = (err && (err as any).message) || "Sign up failed";
    }
}
---
<Layout title="Sign Up">
    <h1>Sign Up</h1>
    <form onsubmit="handleEmailSignUp(event)">
        <input name="email" type="email" required />
        <input name="password" type="password" required />
        <button type="submit">Create account</button>
    </form>
    <button onclick="authClient && authClient.signIn && authClient.signIn?.({ provider: 'google' })">
        Continue with Google
    </button>
    <button onclick="authClient && authClient.signIn && authClient.signIn?.({ provider: 'github' })">
        Continue with GitHub
    </button>
    <p>Already have an account? <a href="/user/sign-in">Sign In</a></p>
</Layout>