---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/settings.scss';

import config from '../lib/config';
import { providers } from '../lib/models';

const settings = [
  {
    id: 'provider',
    name: 'AI Provider',
    options: providers,
    default: config.provider,
  }, 
  {
    id: 'model',
    name: 'Model',
    dependencies: ['provider'],
    options: providers[config.provider].models,
    default: config.model,
  }
];
---
<Layout title="Settings">
  <section class="settings-section card">
    <h2><span class="material-symbols-outlined">settings</span>&nbsp;Settings</h2>
    <form id="settings-form" onsubmit="event.preventDefault();">
      {settings.map(setting => (
        <div class="settings-row">
          <label for={setting.id}>{setting.name}:</label>
          {Array.isArray(setting.options) ? (
            <select id={setting.id} name={setting.id} value={setting.default}>
              {setting.options.map(option => (
                <option value={option} selected={option === setting.default}>{option.name || option}</option>
              ))}
            </select>
          ) : typeof setting.options === 'object' ? (
            <select id={setting.id} name={setting.id} value={setting.options[setting.default]}>
              {Object.keys(setting.options).map(option => (
                <option value={option} selected={setting.options[option] === setting.default}>{setting.options[option].name || option}</option>
              ))}
            </select>
          ) : (
            <input type="text" id={setting.id} name={setting.id} value={setting[1]} />
          )}
        </div>
      ))}
    </form>
  </section>
  <script is:inline data-settings={settings && typeof settings === 'object' ? JSON.stringify(settings) : '{}'}>
    const settings = JSON.parse(document.currentScript.dataset.settings);
    document.currentScript.removeAttribute('data-settings');

    // Add change listeners for all settings
    settings.forEach(setting => {
      const el = document.getElementById(setting.id);
      if (el) {
        el.addEventListener('change', function () {
          setSetting(setting.id, this.value);
        });
      }
    });

    function activateDependencies() {
      // Dependency logic (if any)
      settings.forEach(setting => {
        if (setting.dependencies) {
          setting.dependencies.forEach(dependency => {
            const el = document.getElementById(dependency);
            if (el) {
              handleDependentChanges(el, dependency)
            }
          });
        }
      });
    }

    function handleDependentChanges(el, dep) {
      el.addEventListener('change', () => {
        const value = el.value;
        const setting = settings.find(s => s.id === dep);
        const dependentSettings = settings.filter(s => s.dependencies && s.dependencies.includes(dep));
        dependentSettings.forEach(s => {
          const sEl = document.getElementById(s.id);
          const id = `${s.id}s`;
          const options = setting.options[value][id]
          sEl.querySelectorAll('option').forEach(o => o.remove());
          Object.keys(options).forEach(o => {
            const option = document.createElement('option');
            option.value = o;
            option.textContent = options[o].name;
            sEl.appendChild(option);
          });

          setSetting(s.id, Object.keys(options)[0]);
        });
      });
    }

    function setSetting(key, value) {
      let userSettings = {};
      try {
        userSettings = JSON.parse(localStorage.getItem('settings')) || {};
      } catch (e) {
        userSettings = {};
      }
      userSettings[key] = value;
      localStorage.setItem('settings', JSON.stringify(userSettings));
    }

    // Initialize form values from localStorage
    window.addEventListener('DOMContentLoaded', () => {
      let userSettings = {};
      try {
        userSettings = JSON.parse(localStorage.getItem('settings')) || {};
      } catch (e) {}
      const settingIds = settings.map(s => s.id);
      
      activateDependencies()
      for (const setting of settingIds) {
        if (userSettings[setting]) {
          const el = document.getElementById(setting);
          console.log(userSettings[setting])
          if (el) el.value = userSettings[setting];
        }
      }
    });
  </script>
</Layout> 