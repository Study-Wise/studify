---
import Layout from '../layouts/Layout.astro';

import SettingsScript from '../scripts/settings.astro';
import '../styles/pages/settings.scss';

import config from '../lib/config';
import { providers, models } from '../lib/models';
import type { ModelOption, SettingItem, Providers } from '../lib/types';

const typedProviders = providers as Providers;

const settings: SettingItem[] = [
    {
        id: 'model',
        name: 'Model',
        options: models as ModelOption[],
        default: config.model,
    }
];
---
<Layout title="Settings">
    <section class="settings-section card">
        <h2><span class="material-symbols-outlined">settings</span>&nbsp;Settings</h2>
        <form id="settings-form">
            {settings.map(setting => (
                <div class="settings-row">
                <label for={setting.id}>{setting.name}:</label>
                    {Array.isArray(setting.options) ? (
                        <select class="fancy-select" id={setting.id} name={setting.id} value={setting.default}>
                            <selectedcontent />
                            {setting.options.map(option => {
                                const providerKey = Object.keys(typedProviders).find(p =>
                                    Object.keys(typedProviders[p].models).find(m => typedProviders[p].models[m].name === option.name)
                                );
                                const currKey = providerKey
                                    ? Object.keys(typedProviders[providerKey].models).find(m => typedProviders[providerKey].models[m].name === option.name)
                                    : '';
                                return (
                                    <option value={currKey} selected={currKey === setting.default}>
                                        <img
                                            src={`/assets/providers/${providerKey || 'default'}.svg`}
                                            alt={providerKey ? typedProviders[providerKey].name : 'Provider'}
                                        />
                                        {option.name || currKey}
                                    </option>
                                );
                            })}
                        </select>
                    ) : (
                        <input type="text" id={setting.id} name={setting.id} value={setting.default} />
                    )}
                </div>
            ))}
        </form>
    </section>
    <script>
        document.querySelectorAll('select.fancy-select selectedcontent').forEach(sc => sc.outerHTML = `<button>${sc.outerHTML}</button>`)

        // Prevent form submission
        const settingsForm = document.getElementById('settings-form');
        if (settingsForm) {
            settingsForm.addEventListener('submit', (e) => {
                e.preventDefault();
            });
        }
    </script>
    <SettingsScript settings={settings} />
</Layout> 