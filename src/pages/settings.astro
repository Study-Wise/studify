---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/settings.scss';

import { providers } from '../lib/models';

const provider = Object.keys(providers)[0] as keyof typeof providers;

const settings = [
    {
        id: 'provider',
        name: 'AI Provider',
        options: providers,
        default: provider,
    }, 
    {
        id: 'model',
        name: 'Model',
        options: providers[provider].models,
        default: Object.keys(providers[provider].models)[0],
    }
];
---
<Layout title="Settings">
  <section class="settings-section card">
    <h2><span class="material-symbols-outlined">settings</span>&nbsp;Settings</h2>
    <form id="settings-form" onsubmit="event.preventDefault();">
      {settings.map(setting => (
        <div class="settings-row">
          <label for={setting.id}>{setting.name}:</label>
          {Array.isArray(setting.options) ? (
            <select id={setting.id} name={setting.id} onchange={`setSetting('${setting.id}', this.value)`} value={setting.default}>
              {setting.options.map(option => (
                <option value={option} selected={option === setting.default}>{option.name || option}</option>
              ))}
            </select>
          ) : typeof setting.options === 'object' ? (
            <select id={setting.id} name={setting.id} onchange={`setSetting('${setting.id}', this.value)`} value={Object.keys(setting.options)[0]}>
              {Object.entries(setting.options).map(([key, value]) => (
                <option value={key} selected={key === setting.default}>{value.name || key}</option>
              ))}
            </select>
          ) : (
            <input type="text" id={setting.id} name={setting.id} value={setting.default} onchange={`setSetting('${setting.id}', this.value)`} />
          )}
        </div>
      ))}
      <!-- Add more settings as needed -->
    </form>
  </section>
  <script is:inline>
    function setSetting(key, value) {
      let settings = {};
      try {
        settings = JSON.parse(localStorage.getItem('settings')) || {};
      } catch (e) {
        settings = {};
      }
      settings[key] = value;
      localStorage.setItem('settings', JSON.stringify(settings));
    }
    // Optionally, initialize form values from localStorage
    window.addEventListener('DOMContentLoaded', () => {
      let settings = {};
      try {
        settings = JSON.parse(localStorage.getItem('settings')) || {};
      } catch (e) {}
      const settingIds = [
        // Dynamically generated from the settings array
        ...Array.from(document.querySelectorAll('#settings-form [id]')).map(el => el.id)
      ];
      for (const setting of settingIds) {
        if (settings[setting]) {
          const el = document.getElementById(setting);
          if (el) el.value = settings[setting];
        }
      }
    });
  </script>
</Layout> 