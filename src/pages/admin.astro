---
import Layout from '../layouts/Layout.astro';
import { getUserRoleFromUser, getUserMetadataFromUser } from '../lib/auth/utils';
import { clerkClient } from '@clerk/astro/server';
import '../styles/pages/admin.scss';

// Use Clerk authentication
const auth = Astro.locals.auth;
const { userId } = auth();

// Redirect to sign-in if not authenticated
if (!userId) {
    return Astro.redirect("/user/sign-in");
}

// Fetch user and check if admin
const client = clerkClient(Astro);
const user = await client.users.getUser(userId);
const userRole = getUserRoleFromUser(user);
const isUserAdmin = userRole === 'admin';
const userMetadata = getUserMetadataFromUser(user);

// Redirect non-admins away from admin page
if (!isUserAdmin) {
    return Astro.redirect("/");
}
---

<Layout title="Admin Dashboard" className="admin-page">
    <div class="admin-container">
        <h1>Admin Dashboard</h1>
        
        <div class="user-info">
            <h2>Your Account</h2>
            <p><strong>User ID:</strong> {userId}</p>
            <p><strong>Role:</strong> {userRole}</p>
            <p><strong>Promoted At:</strong> {userMetadata.promotedAt || 'Not available'}</p>
        </div>

        <div class="admin-features">
            <h2>Admin Features</h2>
            <div class="feature-grid">
                <div class="feature-card">
                    <h3>User Management</h3>
                    <p>Manage all users in the system</p>
                    <button class="btn">Manage Users</button>
                </div>
                
                <div class="feature-card">
                    <h3>Analytics</h3>
                    <p>View system analytics and reports</p>
                    <button class="btn">View Analytics</button>
                </div>
                
                <div class="feature-card">
                    <h3>System Settings</h3>
                    <p>Configure system-wide settings</p>
                    <button class="btn">Settings</button>
                </div>
                
                <div class="feature-card">
                    <h3>Content Management</h3>
                    <p>Manage quizzes and educational content</p>
                    <button class="btn">Manage Content</button>
                </div>
            </div>
        </div>
    </div>
</Layout>
