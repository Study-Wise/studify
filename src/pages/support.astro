---
import '@/styles/pages/support.scss';
import Layout from '@/layouts/Layout.astro';
---
<Layout title="Support" description="Get help, suggest features, report issues and vote on what we build next." container={false} className="support-page">
    <section class="support-section">
        <div class="support-embed">
            <iframe referrerpolicy="origin" width="100%" frameborder="0" sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-top-navigation allow-top-navigation-by-user-activation allow-modals" allow="fullscreen; clipboard-write" src="https://https://studify.tawk.help/?embed=true"></iframe>
        </div>
    </section>
</Layout>
