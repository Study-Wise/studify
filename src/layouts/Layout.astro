---
import 'dotenv/config';
import '../styles/globals.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OfflineSupport from '../components/OfflineSupport.astro';
import TouchGestures from '../accessibility/TouchGestures.astro';
import KeyboardNavigation from '../accessibility/KeyboardNavigation.astro';
import ThemeSwitcher from '../accessibility/ThemeSwitcher.astro';

import shouldBeMathOnly from '../lib/shouldBeMathOnly';


const sTitle = shouldBeMathOnly ? "MathWise" : "StudyWise";
const lTitle = `${sTitle} - AI${shouldBeMathOnly ? ' Math' : ''} Study Partner`;
const { title, hideCopyright, container, isChatArea } = Astro.props;
var { additionalClasses } = Astro.props;
const noTitle = title === "Home" || title === '' || !title;
const pTitle = noTitle ? lTitle : `${title} | ${sTitle}`;

let mainClasses: string[] = [];
if (container === false) {}
else mainClasses.push('container');

if (!additionalClasses) additionalClasses = [];

additionalClasses.forEach((className: string) => {
    mainClasses.push(className);
});

---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/view-transitions.css" />
        <!-- PWA meta -->
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content={sTitle}>
        <link rel="apple-touch-icon" href="/assets/logos/apple-touch-icon.png">
        <link rel="icon" type="image/png" href="/assets/logos/favicon.png">
        <link rel="manifest" href="/manifest.webmanifest">
        <meta name="theme-color" content="#6366f1" />
        <title>{pTitle}</title>
        <!-- Google Fonts Material Icons -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
        <!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" /> -->
        <!-- MathJax Config & Loader -->
        <script is:inline>
            window.MathJax = {
                tex: {
                    inlineMath: [
                        ["$", "$"],
                        ["\\(", "\\)"],
                    ],
                    displayMath: [
                        ["$$", "$$"],
                        ["\\[", "\\]"],
                    ],
                    processEscapes: true,
                    tags: "ams",
                },
                svg: { fontCache: "global" },
                options: {
                    skipHtmlTags: [
                        "script",
                        "noscript",
                        "style",
                        "textarea",
                        "pre",
                        "code",
                    ],
                    ignoreHtmlClass: "tex2jax_ignore",
                    processHtmlClass: "tex2jax_process",
                },
                startup: {
                    ready: () => {
                        console.log("MathJax loaded.");
                        MathJax.startup.defaultReady();
                    },
                },
            };
        </script>
        <script type="speculationrules">
            {
                "prerender": [
                    {
                        "urls": ["/user/sign-in", "/user/sign-up"],
                        "where": {
                            "selector_matches": ".header-nav .nav-btn"
                        }
                    }
                ]
            }
        </script>
        <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js" id="MathJax-script" async></script>
    </head>
    <body data-hide-copyright={hideCopyright}>
        <OfflineSupport />
        <TouchGestures />
        <KeyboardNavigation />
        <ThemeSwitcher />
        {!isChatArea ? <Header pTitle={pTitle} /> : ''}
        
        <main class={mainClasses.join(' ')} id="main-content">
            <slot />
        </main>

        {!isChatArea ? <Footer hideCopyright={hideCopyright} /> : ''}

        <script is:inline>
            function activateLocalStorageInput(name) {
                const input = document.querySelector(`:is(input, select, textarea)[name="${name}"]`);
                if (input) {
                    input.value = localStorage.getItem(name) || '';
                }
                input.addEventListener('change', e => {
                    localStorage.setItem(name, e.target.value);
                });
            }

            window.cookies = {
                get: cName => {
                    return document.cookie.split('; ').find(row => row.startsWith(`${cName}=`))?.split('=')[1];
                },
                set: (cName, value) => {
                    document.cookie = `${cName}=${value}; path=/`;
                },
                delete: cName => {
                    document.cookie = `${cName}=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT`;
                }
            }
        </script>
        <script src="https://www.desmos.com/api/v1.10/calculator.js?apiKey=dcb31709b452b1cf9dc26972add0fda6"></script>
    </body>
</html>