---
import 'dotenv/config';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import OfflineSupport from '@/components/OfflineSupport.astro';
import InstallPrompt from '@/components/InstallPrompt.astro';
import TouchGestures from '@/accessibility/TouchGestures.astro';
import KeyboardNavigation from '@/accessibility/KeyboardNavigation.astro';
import ThemeSwitcher from '@/accessibility/ThemeSwitcher.astro';
import Dialog from '@/components/Dialog.astro';
import '@/styles/globals.scss';

const sTitle = 'Studify';
const lTitle = `${sTitle} - AI Study Partner`;
const { title, description, hideCopyright, isChatArea } = Astro.props;
var { className, container } = Astro.props;
const isSignedIn = !!Astro.locals.user;
const noTitle = title === 'Home' || title === '' || !title;
const pTitle = noTitle ? lTitle : `${title} | ${sTitle}`;

// Desmos API key (https://www.desmos.com/api). Falls back to the public trial key, which is not for production use.
const desmosApiKey = import.meta.env.DESMOS_API_KEY || process.env.DESMOS_API_KEY || 'dcb31709b452b1cf9dc26972add0fda6';

const canonicalURL = `${new URL(Astro.url.pathname, Astro.site)}${Astro.url.search}`;

container ??= true;
className ??= '';

if (container) className += ' container'
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/view-transitions.css" />

        {/* PWA meta */}
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content={sTitle}>
        {description ? <meta name="description" content={description} /> : ''}
        <link rel="apple-touch-icon" href="/assets/logos/apple-touch-icon.png">
        <link rel="icon" type="image/png" href="/assets/logos/favicon.png">
        <link rel="manifest" href="/manifest.webmanifest">
        <link rel="canonical" href={canonicalURL} />
        <meta name="theme-color" content="#6366f1" />
        <title>{pTitle}</title>

        {/* Google Fonts Material Icons */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
        {/* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" /> */}
        {/* MathJax Config & Loader */}
        <script is:inline>
            window.MathJax = {
                tex: {
                    inlineMath: [
                        ["$", "$"],
                        ["\\(", "\\)"],
                    ],
                    displayMath: [
                        ["$$", "$$"],
                        ["\\[", "\\]"],
                    ],
                    processEscapes: true,
                    tags: "ams",
                },
                svg: { fontCache: "global" },
                options: {
                    skipHtmlTags: [
                        "script",
                        "noscript",
                        "style",
                        "textarea",
                        "pre",
                        "code",
                    ],
                    ignoreHtmlClass: "tex2jax_ignore",
                    processHtmlClass: "tex2jax_process",
                },
                startup: {
                    ready: () => {
                        MathJax.startup.defaultReady();
                    },
                },
            };
        </script>
        {/* Only prerender auth pages for signed-out visitors; signed-in users get redirected away from them */}
        {!isSignedIn && (
            <script is:inline type="speculationrules">
                {
                    "prerender": [
                        {
                            "urls": ["/user/sign-in", "/user/sign-up"]
                        }
                    ]
                }
            </script>
        )}
        <script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js" id="MathJax-script" async></script>
    </head>
    <body data-hide-copyright={hideCopyright}>
        <OfflineSupport />
        <InstallPrompt />
        <TouchGestures />
        <KeyboardNavigation />
        <ThemeSwitcher />
        <Dialog />
        {!isChatArea ? <Header {sTitle} /> : ''}

        <main class={className?.trim()} id="main-content">
            <slot />
        </main>

        {!isChatArea ? <Footer hideCopyright={hideCopyright} /> : ''}

        <script is:inline>
            window.activateLocalStorageInput = function(name) {
                const input = document.querySelector(`:is(input, select, textarea)[name="${name}"]`);
                if (input) {
                    input.value = localStorage.getItem(name) || '';
                }
                input.addEventListener('change', e => {
                    localStorage.setItem(name, e.target.value);
                });
            };

            window.cookies = {
                get: cName => {
                    return document.cookie.split('; ').find(row => row.startsWith(`${cName}=`))?.split('=')[1];
                },
                set: (cName, value) => {
                    document.cookie = `${cName}=${value}; path=/`;
                },
                delete: cName => {
                    document.cookie = `${cName}=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT`;
                }
            }

            // Activate Desmos graphs
            function activateDesmos() {
                const graphs = document.querySelectorAll('.desmos-graph:not([done])');
                graphs.forEach(graph => {
                    if (!graph) {
                        console.warn('Desmos graph element not valid.');
                        return;
                    }
                    if (!window.Desmos) {
                        console.warn('Desmos calculator not loaded.');
                        return;
                    }

                    let LaTeX = graph.getAttribute('latex');
                    if (LaTeX) {
                        try {
                            LaTeX = JSON.parse(LaTeX);
                            const calculator = Desmos.GraphingCalculator(graph, {
                                expressionsCollapsed: true,
                                showResetButtonOnGraphpaper: true,
                            });

                            if (Array.isArray(LaTeX)) {
                                LaTeX.forEach((l, i) => {
                                    if (typeof l === 'string') {
                                        calculator.setExpression({ id: `exp${i + 1}`, latex: l });
                                    }
                                    else {
                                        console.warn(`Desmos expression at index ${i} is not a string:`, l);
                                    }
                                });
                            }

                            const newDefaultState = calculator.getState();
                            calculator.setDefaultState(newDefaultState);
                            graph.setAttribute('done', true);
                        } catch (e) {
                            console.error('Error parsing/setting Desmos graph data:', e);
                            console.error('Problematic LaTeX string:', graph.getAttribute('latex'));
                            graph.innerHTML = `<p><i>Error loading graph. Check console for details.</i><pre>${e}</pre></p>`;
                        }
                    }
                    else {
                        console.warn('Desmos graph "latex" attribute missing or empty.');
                        graph.innerHTML = '<p><i>No graph data provided.</i></p>';
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', activateDesmos);
            }
            else {
                activateDesmos();
            }
        </script>
        <script is:inline src={`https://www.desmos.com/api/v1.10/calculator.js?apiKey=${desmosApiKey}`}></script>
    </body>
</html>