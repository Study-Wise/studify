---
import { labels } from '@/lib/tools';

const { page, category, mode, id } = Astro.props;
---
<script is:inline define:vars={{ page, category, mode, id, toolLabels: labels }}>
    let threadId = 0;
    let userSettings = {};

    let messageInput, sendButton, spinner, errorMessageDiv;

    function loadUserSettings() {
        try {
            userSettings = JSON.parse(localStorage?.getItem('settings') || '{}') || {};
        } catch (_e) {
            userSettings = {};
        }
    }

    async function destroyIdIfEmptyConvo(id = threadId) {
        if (id) threadId = null;
    }

    function getProviderAndTier() {
        const settings = JSON.parse(localStorage.getItem('settings') || '{}');
        return {
            provider: settings.provider || 'openai',
            tier: settings.tier || 'default',
        };
    }

    let state = 'off';
    document.addEventListener('visibilitychange', async () => {
        if (document.visibilityState === 'hidden' && state === 'on') {
            if (threadId) await destroyIdIfEmptyConvo(threadId);
            state = 'on';
        }
    });

    // Adopt a thread created elsewhere on the page (e.g. by a file upload in the sidebar)
    // so the first message is added to it instead of creating a separate thread
    window.addEventListener('thread-created', (event) => {
        const { id: createdId, source } = event.detail || {};
        if (source !== 'messages' && createdId && !threadId) {
            threadId = createdId;
        }
    });

    const API_ENDPOINT = '/api/message/generate';

    let isGenerating = false;
    let isRedirecting = false;

    // Leave the page locked while the browser navigates to the new chat
    function redirectToChat(chatId) {
        isRedirecting = true;
        window.location.href = `/${category}/${mode}/chat/${chatId}`;
    }

    // Unlock the page if Back restores it from the back/forward cache mid-redirect
    window.addEventListener('pageshow', (event) => {
        if (event.persisted && isRedirecting) {
            isRedirecting = false;
            setLoadingState(false);
        }
    });

    function handleEnterKey(event) {
        if (event.key === 'Enter' && !event.shiftKey && event.target.value.trim() !== '') {
            event.preventDefault();
            if (!isGenerating && !sendButton.disabled) generateOutput();
        }
    }

    window.generateOutput = async function generateOutput() {
        if (isRedirecting) return;
        clearError();
        if (!messageInput) {
            displayError('Input field missing!');
            return;
        }
        if (!messageInput.value || !messageInput.value.trim()) {
            displayError('Please paste homework text.');
            messageInput.focus();
            return;
        }

        // The file sidebar may have created this chat's thread (uploading on /chat/new
        // rewrites the URL), so pick up that ID to send messages to the same thread
        if (page === 'chat' && !threadId) {
            threadId = getThreadIdFromUrl();
        }

        const { provider, tier } = getProviderAndTier();
        if (!provider || !tier) {
            displayError('Provider or tier not selected!');
            return;
        }

        const userMessage = messageInput.value;

        // On the chat page the message moves into the conversation, so clear the input.
        // The landing page keeps it until the redirect, so a failed attempt can be retried
        if (page === 'chat') {
            messageInput.value = '';
            messageInput.style.height = 'auto';
        }
        if (sendButton) sendButton.disabled = true;

        if (page === 'chat') {
            document.querySelector('.chat-empty-state')?.remove();
            await addMessage('user', userMessage);
        }

        setLoadingState(true);
        if (page === 'chat') showTypingIndicator();
        try {
            // Visibility chosen in the sidebar, used when this message creates the thread
            const publicToggle = document.getElementById('public-toggle');
            const isPublic = publicToggle ? publicToggle.checked : false;

            const { provider, tier } = getProviderAndTier();
            const response = await fetch(API_ENDPOINT, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                },
                body: JSON.stringify({
                    text: userMessage,
                    provider: provider,
                    tier: tier,
                    id: threadId || null,
                    settings: userSettings || {},
                    isPublic: isPublic,
                    category: category,
                    mode: mode
                }),
            });

            if (!response.ok) {
                let errorMsg = `API Error (${response.status} ${response.statusText})`;
                try {
                    const errorObj = await response.json();
                    if (errorObj?.error) errorMsg = errorObj.error;
                } catch (e) {
                    const rawTxt = await response.text()
                        .catch(() => 'Unreadable error body.');
                    console.error('Error parsing API error:', e, rawTxt);
                }
                throw new Error(errorMsg);
            }

            const contentType = response.headers.get('Content-Type') || '';
            if (contentType.includes('text/event-stream')) {
                await readStream(response);
            }
            else {
                const data = await response.json();
                if (!data?.generatedText && !data?.id) {
                    console.error('Invalid data format:', data);
                    throw new Error('Invalid/empty response from AI.');
                }
                removeTypingIndicator();
                await displayResults(data);
                if (page === 'home') {
                    await showOpenInChatBtn(data.id);
                    threadId = data.id;
                }
            }
        } catch (error) {
            console.error('Full error caught in generateOutput:', error);
            displayError(error.message || 'Unexpected error.');
        } finally {
            removeTypingIndicator();
            if (!isRedirecting) setLoadingState(false);
        }
    }

    // "Studify is thinking…" bubble shown in the message list where the reply will appear
    function showTypingIndicator() {
        const chatMessages = document.querySelector('.chat-messages');
        if (!chatMessages || document.getElementById('typing-indicator')) return;

        const indicator = document.createElement('div');
        indicator.id = 'typing-indicator';
        indicator.className = 'message assistant typing';
        indicator.setAttribute('role', 'status');

        const content = document.createElement('div');
        content.className = 'message-content';

        const dots = document.createElement('div');
        dots.className = 'typing-dots';
        dots.setAttribute('aria-hidden', 'true');
        for (let i = 0; i < 3; i++) dots.appendChild(document.createElement('span'));

        const label = document.createElement('span');
        label.className = 'typing-label';
        label.textContent = 'Studify is thinking…';

        content.appendChild(dots);
        content.appendChild(label);
        indicator.appendChild(content);
        chatMessages.appendChild(indicator);
        chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
    }

    function removeTypingIndicator() {
        document.getElementById('typing-indicator')?.remove();
    }

    function setLoadingState(isLoading) {
        try {
            isGenerating = isLoading;
            if (isLoading) {
                spinner && (spinner.style.display = 'inline-block');
                if (sendButton) sendButton.disabled = true;
                if (messageInput) {
                    if (messageInput.dataset.defaultPlaceholder === undefined) {
                        messageInput.dataset.defaultPlaceholder = messageInput.placeholder;
                    }
                    messageInput.placeholder = 'Waiting for response...';
                }
                const icon = sendButton?.querySelector('i.material-symbols-outlined');
                icon && (icon.style.display = 'none');
                clearError();
            }
            else {
                spinner && (spinner.style.display = 'none');
                if (sendButton) sendButton.disabled = !messageInput?.value?.trim();
                if (messageInput) {
                    messageInput.placeholder = messageInput.dataset.defaultPlaceholder ?? messageInput.placeholder;
                    messageInput.focus();
                }
                const icon = sendButton?.querySelector('i.material-symbols-outlined');
                icon && (icon.style.display = 'inline-block');
            }
        } catch (err) {
            console.error('Error in setLoadingState:', err);
        }
    }

    function clearError() {
        const errorDiv = errorMessageDiv || document.getElementById('error-message');
        if (errorDiv) {
            errorDiv.style.display = 'none';
            errorDiv.textContent = '';
        }
    }

    function displayError(message) {
        try {
            let messageToShow = 'An unknown error occurred.';
            if (typeof message === 'string' && message.trim() !== '') {
                messageToShow = message;
            }
            else if (message instanceof Error && message.message) {
                messageToShow = message.message;
            }
            else if (typeof message === 'object' && message !== null) {
                try {
                    messageToShow = JSON.stringify(message);
                } catch (_e) {
                    messageToShow = '[Complex Error Object]';
                }
            }
            const errorDiv = document.getElementById('error-message');
            if (errorDiv) {
                let showErrorText = '';
                if (!messageToShow.includes(': ')) {
                    showErrorText = 'Error: ';
                }
                errorDiv.textContent = `${showErrorText}${messageToShow}`;
                errorDiv.style.display = 'block';
            }
            else {
                window.showError('Critical error occurred; error display area missing.\nHint: ' + messageToShow);
            }
            const outputSec = document.getElementById('output-section');
            if (outputSec) outputSec.style.display = 'none';
            const guideBtn = document.getElementById('download-guide-pdf');
            if (guideBtn) guideBtn.disabled = true;
            const sheetBtn = document.getElementById('download-sheet-pdf');
            if (sheetBtn) sheetBtn.disabled = true;
        } catch (e) {
            console.error('FATAL ERROR inside displayError function:', e);
            const errorDiv = document.getElementById('error-message');
            if (errorDiv) {
                errorDiv.textContent = 'Error: Critical UI failure during error reporting.';
                errorDiv.style.display = 'block';
            }
            else {
                window.showError('Error: Critical UI failure during error reporting.');
            }
        }
    }

    // Matches the MathJax delimiters configured in Layout.astro ($…$, $$…$$, \(…\), \[…\])
    const mathDelimiterPattern = /\$|\\\(|\\\[/;
    const mathJaxTimeout = 10000;

    // Reject if the promise hasn't settled within ms
    function withTimeout(promise, ms, message) {
        let timer;
        const timeout = new Promise((_, reject) => {
            timer = setTimeout(() => reject(new Error(message)), ms);
        });
        return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
    }

    // Startup rejects for good if the initial typeset fails, but later typesets can still succeed,
    // so only wait for it to finish
    function whenStartupSettled() {
        return window.MathJax.startup.promise.catch(err => console.error('MathJax startup error:', err));
    }

    // MathJax loads async, so wait for its startup (including the initial page typeset) before typesetting
    function whenMathJaxReady() {
        if (window.MathJax?.startup?.promise) return whenStartupSettled();

        const script = document.getElementById('MathJax-script');
        if (!script) return Promise.reject(new Error('MathJax script not found.'));
        // The error event may have fired before these listeners were attached
        if (script.dataset.failed === 'true') return Promise.reject(new Error('MathJax failed to load.'));

        return new Promise((resolve, reject) => {
            script.addEventListener('load', () => resolve(whenStartupSettled()), { once: true });
            script.addEventListener('error', () => reject(new Error('MathJax failed to load.')), { once: true });
        });
    }

    async function typesetMathJax(elements) {
        const validElements = (Array.isArray(elements) || elements instanceof NodeList ? [...elements] : elements ? [elements] : []).filter(el => el != null);
        if (validElements.length === 0) return;

        // Hide messages that contain math until they are typeset so raw LaTeX never shows
        validElements
            .filter(el => mathDelimiterPattern.test(el.textContent || ''))
            .forEach(el => el.classList.add('mathjax-pending'));

        try {
            // Loading, startup and typesetting can each stall on a hung request, so limit the whole wait
            await withTimeout(
                whenMathJaxReady().then(() => window.MathJax.typesetPromise(validElements)),
                mathJaxTimeout,
                'MathJax took too long to typeset.'
            );
        } catch (err) {
            console.error('MathJax typesetting error:', err);
        } finally {
            validElements.forEach(el => el.classList.remove('mathjax-pending'));
        }
    }

    function updateSidebarSection(contentType, url) {
        const section = document.querySelector(`#generate-${contentType}-btn`)?.closest('.sidebar-section');
        if (!section) return;

        const sectionBody = section.querySelector('.section-body');
        if (!sectionBody) return;

        const viewButtonTexts = {
            'study-guide': 'View Full Study Guide',
            'reference-sheet': 'View Full Reference Sheet',
            'infographic': 'View Infographic',
            'flashcards': 'View Flashcards',
            'practice-questions': 'View Practice Questions',
            'webpage': 'View Webpage',
            'mind-map': 'View Mind Map',
            'additional-resources': 'View Resources',
            'summary': 'View Summary',
        };

        const buttonText = viewButtonTexts[contentType] || `View ${contentType}`;

        sectionBody.innerHTML = `
            <a href="${url}" class="view-full-btn" target="_blank">
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                <span>${buttonText}</span>
            </a>
        `;

        const sectionHeader = section.querySelector('.section-header');
        if (sectionHeader && !section.querySelector('.regenerate-btn')) {
            const threadIdAttr = document.querySelector(`[data-thread-id]`)?.getAttribute('data-thread-id') || '';
            const regenerateBtn = document.createElement('button');
            regenerateBtn.type = 'button';
            regenerateBtn.className = 'regenerate-btn';
            regenerateBtn.id = `regenerate-${contentType}-btn`;
            regenerateBtn.title = `Regenerate`;
            regenerateBtn.setAttribute('aria-label', `Regenerate`);
            regenerateBtn.setAttribute('data-thread-id', threadIdAttr);
            regenerateBtn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">refresh</span>';
            sectionHeader.appendChild(regenerateBtn);
        }
    }

    async function executeClientToolCalls(toolCalls) {
        if (!toolCalls || !Array.isArray(toolCalls)) return;

        for (const toolCall of toolCalls) {
            if (toolCall.toolName === 'open-content') {
                const { type, threadId: tid, category: cat, mode: m, url: providedUrl } = toolCall.args;
                const url = providedUrl || (type && tid && cat && m ? `/${cat}/${m}/${type}/${tid}` : null);

                if (url && type) {
                    updateSidebarSection(type, url);
                    // Open in new tab; if popup blocked, sidebar is already updated
                    window.open(url, '_blank');
                }
            }
        }
    }

    // Landing page: wait for the reply to be saved, then open the new chat
    async function readHomeStream(response) {
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const events = buffer.split('\n\n');
            buffer = events.pop() || '';

            for (const event of events) {
                if (!event.startsWith('data: ')) continue;
                let data;
                try {
                    data = JSON.parse(event.slice(6));
                } catch (e) {
                    console.error('Error parsing stream event:', e, event);
                    continue;
                }

                if (data.type === 'error') throw new Error(data.error);
                if (data.type === 'done') {
                    if (!data.id || !category || !mode) throw new Error('Failed to redirect to chat page.');
                    redirectToChat(data.id);
                    return;
                }
            }
        }

        throw new Error('The response ended before the chat was created. Please try again.');
    }

    async function readStream(response) {
        if (page === 'home') {
            await readHomeStream(response);
            return;
        }

        const chatMessages = document.querySelector('.chat-messages');
        if (!chatMessages) return;

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let messageDiv = null;
        let messageContent = null;
        let toolCallLogDiv = null;
        let accumulatedText = '';
        let doneData = null;
        const toolCallMap = new Map();

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffer += decoder.decode(value, { stream: true });
            const events = buffer.split('\n\n');
            buffer = events.pop() || '';

            for (const event of events) {
                if (!event.startsWith('data: ')) continue;
                try {
                    const data = JSON.parse(event.slice(6));

                    if (data.type === 'text') {
                        if (!messageDiv) {
                            removeTypingIndicator();
                            messageDiv = document.createElement('div');
                            messageDiv.className = 'message assistant';
                            messageContent = document.createElement('div');
                            messageContent.className = 'message-content';
                            messageDiv.appendChild(messageContent);
                            chatMessages.appendChild(messageDiv);
                        }
                        accumulatedText += data.text;
                        messageContent.textContent = accumulatedText;
                        chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });

                    }
                    else if (data.type === 'tool-call') {
                        if (!toolCallLogDiv) {
                            toolCallLogDiv = document.createElement('div');
                            toolCallLogDiv.className = 'tool-call-log';
                            // Keep the typing indicator below the tool calls until the reply text arrives
                            chatMessages.insertBefore(toolCallLogDiv, messageDiv || document.getElementById('typing-indicator'));
                        }
                        const entry = document.createElement('div');
                        entry.className = 'tool-call-entry';
                        const icon = document.createElement('span');
                        icon.className = 'material-symbols-outlined';
                        icon.setAttribute('aria-hidden', 'true');
                        icon.dataset.state = 'pending';
                        icon.textContent = 'schedule';
                        const label = document.createElement('span');
                        label.className = 'tool-name';
                        label.textContent = toolLabels[data.toolName] || data.toolName;
                        entry.appendChild(icon);
                        entry.appendChild(label);
                        toolCallLogDiv.appendChild(entry);
                        toolCallMap.set(data.toolCallId, { icon, toolName: data.toolName });
                        chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });

                    }
                    else if (data.type === 'tool-result') {
                        const call = toolCallMap.get(data.toolCallId);
                        if (call) {
                            call.icon.dataset.state = data.status;
                            call.icon.textContent = data.status === 'success' ? 'check_circle' : 'error';
                        }

                    }
                    else if (data.type === 'done') {
                        doneData = data;
                        if (messageContent && data.generatedText) {
                            messageContent.innerHTML = data.generatedText;
                        }

                    }
                    else if (data.type === 'error') {
                        throw new Error(data.error);
                    }
                } catch (e) {
                    console.error('Error parsing stream event:', e, event);
                }
            }
        }

        if (messageContent) {
            await typesetMathJax([messageContent]);
            if (typeof activateDesmos === 'function') {
                try { activateDesmos(); } catch (e) { console.warn('Desmos error:', e); }
            }
            if (typeof window.initializeStepByStep === 'function') {
                try { window.initializeStepByStep(); } catch (e) { console.warn('Step-by-step error:', e); }
            }
        }

        if (doneData) {
            if (doneData.clientToolCalls) await executeClientToolCalls(doneData.clientToolCalls);

            const isNewChat = id === 'new';
            if (doneData.id && !threadId) {
                window.dispatchEvent(new CustomEvent('thread-created', {
                    detail: { id: doneData.id, source: 'messages' }
                }));
            }
            if (isNewChat && doneData.id && category && mode) {
                window.location.href = `/${category}/${mode}/chat/${doneData.id}`;
            }
            else if (doneData.id) {
                threadId = doneData.id;
            }
        }

        chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
    }

    async function displayResults(data) {
        if (!data || typeof data !== 'object') {
            displayError('Invalid AI response received.');
            return;
        }

        if (data.clientToolCalls) {
            await executeClientToolCalls(data.clientToolCalls);
        }

        if (page === 'home' && data.id && category && mode) {
            redirectToChat(data.id);
        }
        else if (page === 'chat') {
            const isNewChat = (id === 'new');

            if (isNewChat && data.id && category && mode) {
                window.location.href = `/${category}/${mode}/chat/${data.id}`;
            }
            else {
                await addMessage('assistant', data);
            }
        }
        else if (page === 'home') {
            displayError('Failed to redirect to chat page.');
        }
    }

    async function addMessage(role, data) {
        if (role === 'assistant') {
            await addAssistantMessage(data);
        }
        else if (role === 'user') {
            createPlainMessage(role, data);
        }
    }

    async function createPlainMessage(role, content) {
        const chatMessages = document.querySelector('.chat-messages');
        if (!chatMessages) {
            console.error('Chat messages container not found');
            return;
        }

        try {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${role}`;

            const messageContent = document.createElement('div');
            messageContent.className = `message-content ${role === 'user' ? 'bg-primary' : ''}`;

            messageContent.innerHTML = new marked.Marked({ breaks: true, gfm: true, renderer: { html: ({ text }) => text.replace(/</g, '&lt;') } }).parse(content);

            messageDiv.appendChild(messageContent);
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });

            await typesetMathJax([messageContent]);

            if (typeof activateDesmos === 'function') {
                try {
                    activateDesmos();
                } catch (e) {
                    console.warn('Error activating Desmos:', e);
                }
            }

            if (typeof window.initializeStepByStep === 'function') {
                try {
                    window.initializeStepByStep();
                } catch (e) {
                    console.warn('Error initializing step-by-step:', e);
                }
            }

            chatMessages.scrollTo({
                top: chatMessages.scrollHeight,
                behavior: 'smooth'
            });

        } catch (err) {
            console.error('ERROR in createPlainMessage:', err);
            displayError(`Failed to render message. ${err.message}`);
        }
    }

    function renderToolCallLog(toolCallLog, container) {
        if (!toolCallLog || toolCallLog.length === 0) return;

        const logDiv = document.createElement('div');
        logDiv.className = 'tool-call-log';

        for (const entry of toolCallLog) {
            const entryDiv = document.createElement('div');
            entryDiv.className = 'tool-call-entry';

            const icon = document.createElement('span');
            icon.className = 'material-symbols-outlined';
            icon.setAttribute('aria-hidden', 'true');
            icon.dataset.state = entry.status;
            icon.textContent = entry.status === 'success' ? 'check_circle' : 'error';

            const label = document.createElement('span');
            label.className = 'tool-name';
            label.textContent = toolLabels[entry.toolName] || entry.toolName;

            entryDiv.appendChild(icon);
            entryDiv.appendChild(label);
            logDiv.appendChild(entryDiv);
        }

        container.appendChild(logDiv);
    }

    async function addAssistantMessage(data) {
        if (!data || typeof data !== 'object') {
            displayError('Invalid AI response received.');
            return;
        }

        const chatMessages = document.querySelector('.chat-messages');
        if (!chatMessages) {
            console.error('Chat messages container not found');
            return;
        }

        try {
            if (data.toolCallLog && data.toolCallLog.length > 0) {
                renderToolCallLog(data.toolCallLog, chatMessages);
            }

            // Skip empty assistant messages (e.g. those that only made tool calls)
            if (!data.generatedText || !data.generatedText.trim()) {
                chatMessages.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
                return;
            }

            const messageDiv = document.createElement('div');
            messageDiv.className = 'message assistant';

            const messageContent = document.createElement('div');
            messageContent.className = 'message-content';

            messageContent.innerHTML = data.generatedText;

            messageDiv.appendChild(messageContent);
            chatMessages.appendChild(messageDiv);

            await typesetMathJax([messageContent]);

            if (typeof activateDesmos === 'function') {
                try {
                    activateDesmos();
                } catch (e) {
                    console.warn('Error activating Desmos:', e);
                }
            }

            if (typeof window.initializeStepByStep === 'function') {
                try {
                    window.initializeStepByStep();
                } catch (e) {
                    console.warn('Error initializing step-by-step:', e);
                }
            }

            chatMessages.scrollTo({
                top: chatMessages.scrollHeight,
                behavior: 'smooth'
            });

        } catch (err) {
            console.error('ERROR in addAssistantMessage:', err);
            displayError(`Failed to render message. ${err.message}`);
        }
    }

    async function showOpenInChatBtn(id) {
        const chatButtonContainer = document.querySelector('.chat-button-container');
        if (chatButtonContainer) {
            const btn = document.createElement('a');
            btn.href = `/chat/${id}`;

            const icon = document.createElement('span');
            icon.classList.add('material-symbols-outlined');
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = 'chat';
            btn.appendChild(icon);

            btn.appendChild(document.createTextNode(' Open in Chat'));
            btn.classList.add('btn', 'bg-primary', 'chat-button');
            chatButtonContainer.appendChild(btn);
        }
    }

    function initializeCommon() {
        loadUserSettings();

        if (!generateOutput || typeof generateOutput !== 'function') {
            displayError('Error: Core function generateOutput failed to initialize.');
        }
    }

    function onDomLoadHome() {
        initializeCommon();

        messageInput = document.getElementById('text-paste');
        sendButton = document.querySelector('.generate-button');
        spinner = sendButton?.querySelector('.spinner');
        errorMessageDiv = document.getElementById('error-message');

        if (messageInput && sendButton) {
            messageInput.addEventListener('keydown', handleEnterKey);
        }
    }

    // Extract thread id from the chat page URL; null for "new" so the API creates a thread
    function getThreadIdFromUrl() {
        let pathSegments = location.pathname;
        if (pathSegments.endsWith('/')) pathSegments = pathSegments.slice(0, -1);
        const idFromUrl = pathSegments.split('/').pop();
        if (idFromUrl && idFromUrl !== 'chat' && idFromUrl !== 'new') return idFromUrl;
        return null;
    }

    function onDomLoadChat() {
        initializeCommon();

        const idFromUrl = getThreadIdFromUrl();
        if (idFromUrl) {
            threadId = idFromUrl;
        }

        sendButton = document.querySelector('.send-button');
        messageInput = document.querySelector('#message-input');

        if (messageInput) {
            messageInput.addEventListener('keydown', handleEnterKey);
            messageInput.addEventListener('input', () => {
                sendButton.disabled = !messageInput.value.trim();
            });
        }

        if (sendButton && messageInput) {
            sendButton.addEventListener('click', () => {
                if (!isGenerating) {
                    generateOutput();
                    messageInput.focus();
                }
            });
        }

        const shareButton = document.getElementById('share-button');
        if (shareButton) {
            shareButton.addEventListener('click', () => {
                shareButton.classList.toggle('active');
                const isActive = shareButton.classList.contains('active');
                const shareText = shareButton.querySelector('.share-text');
                const shareIcon = shareButton.querySelector('.material-symbols-outlined');

                if (shareText) {
                    shareText.textContent = isActive ? 'Shared' : 'Share';
                }
                if (shareIcon) {
                    shareIcon.textContent = isActive ? 'public' : 'share';
                }
            });
        }
    }

    async function initializePage() {
        if (page === 'home') {
            onDomLoadHome();
        }
        else if (page === 'chat') {
            onDomLoadChat();

            const elementsToTypeset = document.querySelectorAll('.chat-messages .message-content');
            await typesetMathJax(elementsToTypeset);
            activateDesmos();
            const chatMessages = document.querySelector('.chat-messages');
            chatMessages?.scrollTo({ top: chatMessages.scrollHeight, behavior: 'instant' });
        }
    }

    document.addEventListener('DOMContentLoaded', initializePage);

    // Also call appropriate handler immediately in case DOM is already loaded
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initializePage();
    }
</script> 