---
// Step-by-step interactive quiz script
---
<script is:inline>
    function initializeStepByStep() {
        const stepByStepSections = document.querySelectorAll('.step-by-step');

        stepByStepSections.forEach(section => {
            const steps = section.querySelectorAll('.step');

            steps.forEach(step => {
                const choices = step.querySelectorAll('.step-question-choice');
                const answerExplanations = step.querySelectorAll('.answer-explanation');

                // Hide explanations initially
                answerExplanations.forEach(exp => {
                    exp.style.display = 'none';
                });

                choices.forEach(choice => {
                    const radio = choice.querySelector('.step-question-radio');

                    choice.addEventListener('click', () => {
                        // Check the radio button
                        if (radio) {
                            radio.checked = true;
                        }

                        // Remove all previous variant selections
                        choices.forEach(c => {
                            delete c.dataset.variant;
                        });

                        // Mark clicked choice as selected
                        choice.dataset.variant = 'selected';

                        // Mark the choices container as answered
                        const choicesContainer = step.querySelector('.step-question-choices');
                        if (choicesContainer) {
                            choicesContainer.dataset.answered = '';
                        }

                        // Show the explanation(s)
                        answerExplanations.forEach(exp => {
                            exp.style.display = 'block';
                        });
                    });
                });
            });
        });
    }

    // Initialize on page load
    window.addEventListener('load', initializeStepByStep);

    // Also expose globally for dynamic content
    window.initializeStepByStep = initializeStepByStep;
</script>
