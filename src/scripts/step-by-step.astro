<script is:inline>
    function initializeStepByStep() {
        document.querySelectorAll('.step-by-step').forEach(section => {
            if (section.querySelector('.retry-wrong')) return;

            const retryButton = document.createElement('button');
            retryButton.type = 'button';
            retryButton.className = 'retry-wrong';
            retryButton.textContent = 'Retry wrong ones';
            section.append(retryButton);

            retryButton.addEventListener('click', () => section.querySelectorAll('.step-question-choice:not([data-type="correct"]) .step-question-radio:checked').forEach(radio => radio.checked = false));
        });
    }

    window.addEventListener('DOMContentLoaded', initializeStepByStep);

    window.initializeStepByStep = initializeStepByStep;
</script>
