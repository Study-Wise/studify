<script is:inline>
    function initializeStepByStep() {
        const stepByStepSections = document.querySelectorAll('.step-by-step');

        stepByStepSections.forEach(section => {
            const steps = section.querySelectorAll('.step');

            steps.forEach(step => {
                // Setting up a step twice would add its listeners and button twice
                if (step.dataset.ready !== undefined) return;
                step.dataset.ready = '';

                const choices = step.querySelectorAll('.step-question-choice');
                const choicesContainer = step.querySelector('.step-question-choices');

                const checkButton = document.createElement('button');
                checkButton.type = 'button';
                checkButton.className = 'check-answer';
                checkButton.textContent = 'Check answer';
                checkButton.disabled = true;
                step.append(checkButton);

                choices.forEach(choice => {
                    const radio = choice.querySelector('.step-question-radio');

                    // Picking an answer only highlights it. Nothing is revealed until the answer is checked
                    choice.addEventListener('click', () => {
                        if (step.dataset.checked !== undefined) return;

                        if (radio) {
                            radio.checked = true;
                        }

                        choices.forEach(c => {
                            delete c.dataset.variant;
                        });

                        choice.dataset.variant = 'picked';
                        checkButton.disabled = false;
                    });
                });

                // Checking reveals only the picked answer and the correct one, with their explanations
                checkButton.addEventListener('click', () => {
                    const picked = step.querySelector('.step-question-choice[data-variant="picked"]');
                    if (!picked) return;

                    picked.dataset.variant = 'selected';
                    step.dataset.checked = '';
                    checkButton.hidden = true;
                    if (choicesContainer) {
                        choicesContainer.dataset.answered = '';
                    }

                    step.querySelectorAll('.answer-explanation').forEach(exp => delete exp.dataset.visible);
                    [picked, step.querySelector('.step-question-choice[data-type="correct"]')].forEach(choice => {
                        const exp = choice?.querySelector('.answer-explanation');
                        if (exp) exp.dataset.visible = '';
                    });
                });
            });

            // Add a "Retry wrong ones" button, shown once a question has been answered wrongly
            if (section.querySelector('.retry-wrong')) return;

            const retryButton = document.createElement('button');
            retryButton.type = 'button';
            retryButton.className = 'retry-wrong';
            retryButton.textContent = 'Retry wrong ones';
            retryButton.hidden = true;
            section.append(retryButton);

            const getWrongSteps = () => [...steps].filter(step => {
                const selected = step.querySelector('.step-question-choice[data-variant="selected"]');
                return selected && selected.dataset.type !== 'correct';
            });

            section.addEventListener('click', () => {
                retryButton.hidden = getWrongSteps().length === 0;
            });

            retryButton.addEventListener('click', () => {
                getWrongSteps().forEach(step => {
                    step.querySelectorAll('.step-question-choice').forEach(choice => {
                        delete choice.dataset.variant;
                        choice.querySelector('.step-question-radio').checked = false;
                    });
                    delete step.querySelector('.step-question-choices').dataset.answered;
                    delete step.dataset.checked;
                    step.querySelectorAll('.answer-explanation').forEach(explanation => delete explanation.dataset.visible);

                    const checkButton = step.querySelector('.check-answer');
                    checkButton.hidden = false;
                    checkButton.disabled = true;
                });
                retryButton.hidden = true;
            });
        });
    }

    window.addEventListener('DOMContentLoaded', initializeStepByStep);

    window.initializeStepByStep = initializeStepByStep;
</script>
