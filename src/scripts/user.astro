<script>
    import { authClient } from '@/lib/auth/client';

    const socialButtonsContainer = document.querySelector('.social-buttons');
    const callbackURL = socialButtonsContainer instanceof window.HTMLElement ? socialButtonsContainer.dataset.callbackUrl || '/user/sso-callback' : '/user/sso-callback';

    // Social sign-in click handlers
    document.querySelectorAll('.social-button[data-provider]').forEach(button => {
        button.addEventListener('click', async e => {
            e.preventDefault();
            if (!(button instanceof window.HTMLElement)) return;
            const provider = button.dataset.provider;
            if (provider !== 'google' && provider !== 'github') return;
            try {
                await authClient.signIn.social({
                    provider,
                    callbackURL,
                });
            } catch (error) {
                console.error(`${provider} sign-in error:`, error);
                window.showError(`${provider} sign-in failed. Please try again.`);
            }
        });
    });
</script>
