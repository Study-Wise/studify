<script>
    import runtimeCaching from '@/lib/cache.config';
    import { authClient } from '@/lib/auth/client';

    const USER_STORAGE_KEYS = ['settings'];

    for (const signoutBtn of document.querySelectorAll<HTMLButtonElement>('#signout-btn, #signout-confirm-btn')) {
        signoutBtn.addEventListener('click', async () => {
            try {
                try {
                    for (const key of USER_STORAGE_KEYS) localStorage.removeItem(key);
                } catch {
                    // localStorage is unavailable, so there is nothing stored to remove
                }

                try {
                    if ('caches' in window) for (const result of await Promise.allSettled(runtimeCaching.map(cacheConfig => window.caches.delete(cacheConfig.options.cacheName)))) if (result.status === 'rejected') console.error('Failed to delete cache:', result.reason);
                } catch (error) {
                    console.error('Cache Storage is unavailable:', error);
                }

                const { error } = await authClient.signOut();
                if (error) throw new Error(error.message || 'Sign out failed');
                window.location.href = '/';
            } catch (error) {
                console.error('Sign out error:', error);
                if (signoutBtn.id === 'signout-confirm-btn') window.showError('Sign out failed. Please try again.');
            }
        });
    }
</script>
