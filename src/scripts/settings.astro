---
const { providers, defaultProvider, defaultTier } = Astro.props;
---
<script is:inline define:vars={{ providers, defaultProvider, defaultTier }}>
    function getSettings() {
        try {
            return JSON.parse(localStorage.getItem('settings')) || {};
        } catch {
            return {};
        }
    }

    function setSetting(key, value) {
        localStorage.setItem('settings', JSON.stringify(Object.assign(getSettings(), { [key]: value })));
    }

    function initializeUI() {
        const userSettings = getSettings();

        document.querySelectorAll('.provider-button').forEach(btn => {
            if (btn.dataset.provider === (userSettings['provider'] || defaultProvider)) btn.classList.add('active');
            else btn.classList.remove('active');
        });

        document.querySelectorAll('.tier-group').forEach(group => {
            group.style.display = 'none';
        });
        document.getElementById(`tiers-${userSettings['provider'] || defaultProvider}`)?.style.setProperty('display', 'flex');

        document.querySelectorAll('.tier-button').forEach(btn => {
            if (btn.dataset.tier === (userSettings['tier'] || defaultTier)) btn.classList.add('active');
            else btn.classList.remove('active');
        });
    }

    document.querySelectorAll('.provider-button').forEach(btn => {
        btn.addEventListener('click', e => {
            e.preventDefault();
            setSetting('provider', btn.dataset.provider);

            document.querySelectorAll('.provider-button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('.tier-group').forEach(group => {
                group.style.display = 'none';
            });
            document.getElementById(`tiers-${btn.dataset.provider}`)?.querySelector('.tier-button')?.click();
        });
    });

    document.querySelectorAll('.tier-button').forEach(btn => {
        btn.addEventListener('click', e => {
            e.preventDefault();
            setSetting('tier', btn.dataset.tier);

            document.querySelectorAll('.tier-button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        });
    });

    document.getElementById('settings-form')?.addEventListener('submit', e => {
        e.preventDefault();
    });

    window.addEventListener('DOMContentLoaded', initializeUI);
    if (document.readyState === 'complete' || document.readyState === 'interactive') initializeUI();
</script>
