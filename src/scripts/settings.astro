---
const { providers, defaultProvider, defaultTier } = Astro.props;
---
<script is:inline define:vars={{ providers, defaultProvider, defaultTier }}>
    function getSettings() {
        try {
            return JSON.parse(localStorage.getItem('settings')) || {};
        } catch (e) {
            return {};
        }
    }

    function setSetting(key, value) {
        const userSettings = getSettings();
        userSettings[key] = value;
        localStorage.setItem('settings', JSON.stringify(userSettings));
    }

    // Initialize provider button states and tier visibility
    function initializeUI() {
        const userSettings = getSettings();
        const currentProvider = userSettings['provider'] || defaultProvider;
        const currentTier = userSettings['tier'] || defaultTier;

        // Set active provider button
        document.querySelectorAll('.provider-button').forEach(btn => {
            const providerKey = btn.dataset.provider;
            if (providerKey === currentProvider) {
                btn.classList.add('active');
            }
            else {
                btn.classList.remove('active');
            }
        });

        // Show only tiers for current provider
        document.querySelectorAll('.tier-group').forEach(group => {
            group.style.display = 'none';
        });
        const currentTierGroup = document.getElementById(`tiers-${currentProvider}`);
        if (currentTierGroup) {
            currentTierGroup.style.display = 'flex';
        }

        // Set active tier button
        document.querySelectorAll('.tier-button').forEach(btn => {
            const tierKey = btn.dataset.tier;
            if (tierKey === currentTier) {
                btn.classList.add('active');
            }
            else {
                btn.classList.remove('active');
            }
        });
    }

    // Handle provider selection
    document.querySelectorAll('.provider-button').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const providerKey = btn.dataset.provider;
            setSetting('provider', providerKey);

            // Update UI: deactivate all providers, activate clicked one
            document.querySelectorAll('.provider-button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Hide all tier groups, show tiers for selected provider
            document.querySelectorAll('.tier-group').forEach(group => {
                group.style.display = 'none';
            });
            const tierGroup = document.getElementById(`tiers-${providerKey}`);
            if (tierGroup) {
                tierGroup.style.display = 'flex';
                // Auto-select first tier
                const firstTierBtn = tierGroup.querySelector('.tier-button');
                if (firstTierBtn) {
                    firstTierBtn.click();
                }
            }
        });
    });

    // Handle tier selection
    document.querySelectorAll('.tier-button').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const tierKey = btn.dataset.tier;
            setSetting('tier', tierKey);

            // Update UI: deactivate all tiers in current group, activate clicked one
            document.querySelectorAll('.tier-button').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        });
    });

    // Prevent form submission
    const settingsForm = document.getElementById('settings-form');
    if (settingsForm) {
        settingsForm.addEventListener('submit', (e) => {
            e.preventDefault();
        });
    }

    // Initialize on DOMContentLoaded
    window.addEventListener('DOMContentLoaded', initializeUI);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initializeUI();
    }
</script>