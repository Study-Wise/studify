---
import '@/styles/accessibility/touch-gestures.scss';
---

<script>
    class TouchGestures {
        startX: number;
        startY: number;
        endX: number;
        endY: number;
        isPulling: boolean;
        pullThreshold: number;
        refreshIndicator: globalThis.HTMLElement | null;

        constructor() {
            this.startX = 0;
            this.startY = 0;
            this.endX = 0;
            this.endY = 0;
            this.isPulling = false;
            this.pullThreshold = 80;
            this.refreshIndicator = null;
            this.init();
        }

        init() {
            // Only initialize on touch-enabled devices
            if (!this.isTouchDevice()) return;

            this.createRefreshIndicator();
            this.setupTouchEvents();
        }

        isTouchDevice() {
            return (
                'ontouchstart' in globalThis ||
                globalThis.navigator.maxTouchPoints > 0 ||
                (window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches)
            );
        }

        createRefreshIndicator() {
            this.refreshIndicator = document.createElement('div');
            this.refreshIndicator.className = 'pull-to-refresh-indicator';
            this.refreshIndicator.innerHTML = `
                <div class="refresh-content">
                    <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
                    <span>Pull to refresh</span>
                </div>
            `;
            document.body.appendChild(this.refreshIndicator);
        }

        setupTouchEvents() {
            document.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: false });
            document.addEventListener('touchmove', (e) => this.handleTouchMove(e), { passive: false });
            document.addEventListener('touchend', () => this.handleTouchEnd(), { passive: false });
        }

        handleTouchStart(e: globalThis.TouchEvent) {
            if (window.scrollY === 0) {
                this.startX = e.touches[0].clientX;
                this.startY = e.touches[0].clientY;
                this.isPulling = true;
            }
        }

        handleTouchMove(e: globalThis.TouchEvent) {
            if (!this.isPulling || window.scrollY > 0) return;

            this.endX = e.touches[0].clientX;
            this.endY = e.touches[0].clientY;

            const deltaY = this.endY - this.startY;

            if (deltaY > 0) {
                e.preventDefault();
                const progress = Math.min(deltaY / this.pullThreshold, 1);
                this.updateRefreshIndicator(progress);
            }
        }

        handleTouchEnd() {
            if (!this.isPulling) return;

            const deltaY = this.endY - this.startY;

            if (deltaY >= this.pullThreshold) {
                this.triggerRefresh();
            }
            else this.hideRefreshIndicator();

            this.isPulling = false;
        }

        updateRefreshIndicator(progress: number) {
            if (!this.refreshIndicator) return;

            const translateY = (progress * 60) - 60;
            this.refreshIndicator.style.translate = `0 ${translateY}px`;
            this.refreshIndicator.style.opacity = progress.toString();

            if (progress >= 1) {
                this.refreshIndicator.querySelector<globalThis.HTMLElement>('.material-symbols-outlined')?.style.setProperty('animation', 'spin 1s linear infinite');
            }
            else {
                this.refreshIndicator.querySelector<globalThis.HTMLElement>('.material-symbols-outlined')?.style.setProperty('animation', 'none');
            }
        }

        hideRefreshIndicator() {
            if (!this.refreshIndicator) return;

            this.refreshIndicator.style.translate = '0 -100%';
            this.refreshIndicator.style.opacity = '0';
            this.refreshIndicator.querySelector<globalThis.HTMLElement>('.material-symbols-outlined')?.style.setProperty('animation', 'none');
        }

        triggerRefresh() {
            if (!this.refreshIndicator) return;

            this.refreshIndicator.innerHTML = `
                <div class="refresh-content">
                    <span class="material-symbols-outlined" aria-hidden="true" style="animation: spin 1s linear infinite;">refresh</span>
                    <span>Refreshing...</span>
                </div>
            `;

            // Simulate refresh
            globalThis.setTimeout(() => {
                globalThis.location.reload();
            }, 1000);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        new TouchGestures();
    });
</script>
