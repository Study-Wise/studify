---
// High contrast mode component for better visibility
import '../styles/accessibility/high-contrast.scss';
---

<div id="contrast-toggle" class="contrast-toggle" aria-label="Toggle high contrast mode" role="button" tabindex="0">
    <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
    <span class="contrast-label">High Contrast</span>
</div>

<script>
    class HighContrastMode {
        isEnabled: boolean;
        storageKey: string;

        constructor() {
            this.isEnabled = false;
            this.storageKey = 'studywise-high-contrast';
            this.init();
        }

        init() {
            // Check for saved preference
            const savedPreference = localStorage.getItem(this.storageKey);
            if (savedPreference === 'true') {
                this.enable();
            }

            // Check for system preference
            if (window.matchMedia && window.matchMedia('(prefers-contrast: high)').matches) {
                this.enable();
            }

            // Setup toggle button
            const toggle = document.getElementById('contrast-toggle');
            if (toggle) {
                toggle.addEventListener('click', () => this.toggle());
                toggle.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.toggle();
                    }
                });
            }

            // Listen for system preference changes
            if (window.matchMedia) {
                const mediaQuery = window.matchMedia('(prefers-contrast: high)');
                mediaQuery.addEventListener('change', (e) => {
                    if (e.matches) {
                        this.enable();
                    } else {
                        this.disable();
                    }
                });
            }

            this.updateToggleState();
        }

        toggle() {
            if (this.isEnabled) {
                this.disable();
            } else {
                this.enable();
            }
        }

        enable() {
            this.isEnabled = true;
            document.body.classList.add('high-contrast');
            localStorage.setItem(this.storageKey, 'true');
            this.updateToggleState();
            this.announceChange('High contrast mode enabled');
        }

        disable() {
            this.isEnabled = false;
            document.body.classList.remove('high-contrast');
            localStorage.setItem(this.storageKey, 'false');
            this.updateToggleState();
            this.announceChange('High contrast mode disabled');
        }

        updateToggleState() {
            const toggle = document.getElementById('contrast-toggle');
            if (toggle) {
                toggle.setAttribute('aria-pressed', this.isEnabled.toString());
                toggle.classList.toggle('active', this.isEnabled);
            }
        }

        announceChange(message: string) {
            // Create or update announcement element
            let announcement = document.getElementById('contrast-announcement');
            if (!announcement) {
                announcement = document.createElement('div');
                announcement.id = 'contrast-announcement';
                announcement.setAttribute('aria-live', 'polite');
                announcement.setAttribute('aria-atomic', 'true');
                announcement.style.cssText = `
                    position: absolute;
                    left: -10000px;
                    width: 1px;
                    height: 1px;
                    overflow: hidden;
                `;
                document.body.appendChild(announcement);
            }
            announcement.textContent = message;
        }
    }

    // Initialize high contrast mode when DOM is loaded
    document.addEventListener('DOMContentLoaded', () => {
        new HighContrastMode();
    });
</script>

