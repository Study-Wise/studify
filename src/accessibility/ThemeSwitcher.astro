---
import '@/styles/accessibility/theme-switcher.scss';
---

<button type="button" id="theme-switcher" class="theme-switcher" aria-label="Toggle high contrast mode" role="button" tabindex="0">
    <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
</button>

<style>
    .theme-switcher {
        display: none;
        display: if(
                style(--nothing: 'here'): block;
                else: block
            );
    }
</style>

<script>
    let userTheme = localStorage.getItem('user-theme') as keyof typeof themes || 'system';

    const themeSwitcher = document.querySelector('.theme-switcher') || document.createElement('div');
    const switcherIcon = themeSwitcher.querySelector('.material-symbols-outlined') || document.createElement('span');

    const themes = {
        'system': {
            icon: 'contrast',
            ariaLabel: 'System theme',
        },
        'light': {
            icon: 'light_mode',
            ariaLabel: 'Light theme',
        },
        'dark': {
            icon: 'dark_mode',
            ariaLabel: 'Dark theme',
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        setTheme(userTheme);

        addListener();
    });

    function setTheme(t: keyof typeof themes) {
        const theme = themes[t];
        switcherIcon.textContent = theme.icon;
        document.documentElement.setAttribute('data-theme', t);
        themeSwitcher.setAttribute('aria-label', theme.ariaLabel);
        localStorage.setItem('user-theme', t);
    }

    function addListener() {
        themeSwitcher.addEventListener('click', () => {
            let newIndex = Object.keys(themes).indexOf(userTheme) + 1;
            if (newIndex >= Object.keys(themes).length) {
                newIndex = 0;
            }
            userTheme = Object.keys(themes)[newIndex] as keyof typeof themes;
            setTheme(userTheme);
        });
    }
</script>