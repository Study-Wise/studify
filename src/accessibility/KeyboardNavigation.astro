---
import '@/styles/accessibility/keyboard-navigation.scss';
---

{/* Skip Links */}
<a href="#main-content" class="skip-link">Skip to main content</a>
<a href="#main-navigation" class="skip-link">Skip to navigation</a>

<script>
    class KeyboardNavigation {
        focusableElements: string;
        skipLinks: HTMLElement[];

        constructor() {
            this.focusableElements = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
            this.skipLinks = [];
            this.init();
        }

        init() {
            this.setupTabNavigation();
        }

        setupTabNavigation() {
            // Enhanced tab navigation for complex components
            document.addEventListener('keydown', e => {
                if (e.key === 'Tab') {
                    this.handleTabNavigation(e);
                }
            });

            // Arrow key navigation for tab lists
            document.addEventListener('keydown', e => {
                const tabList = e.target instanceof window.HTMLElement ? e.target.closest('[role="tablist"]') : null;
                if (tabList && ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) {
                    e.preventDefault();
                    this.handleTabListNavigation(e, tabList);
                }
            });
        }

        handleTabNavigation(e: KeyboardEvent) {
            const focusableElements = this.getFocusableElements();
            const currentIndex = focusableElements.findIndex(element => element === document.activeElement);

            if (e.shiftKey) {
                // Shift + Tab: Move backwards
                if (currentIndex <= 0) {
                    e.preventDefault();
                    focusableElements.at(-1)?.focus();
                }
            }
            else {
                // Tab: Move forwards
                if (currentIndex >= focusableElements.length - 1) {
                    e.preventDefault();
                    focusableElements[0]?.focus();
                }
            }
        }

        handleTabListNavigation(e: KeyboardEvent, tabList: Element) {
            const tabs = Array.from(tabList.querySelectorAll<HTMLElement>('[role="tab"]'));
            const currentIndex = tabs.findIndex(element => element === document.activeElement);

            switch (e.key) {
                case 'ArrowLeft': {
                    const prevIndex = currentIndex > 0 ? currentIndex - 1 : tabs.length - 1;
                    tabs[prevIndex]?.focus();
                    break;
                }
                case 'ArrowRight': {
                    const nextIndex = currentIndex < tabs.length - 1 ? currentIndex + 1 : 0;
                    tabs[nextIndex]?.focus();
                    break;
                }
                case 'Home':
                    tabs[0]?.focus();
                    break;
                case 'End':
                    tabs.at(-1)?.focus();
                    break;
            }
        }

        getFocusableElements() {
            return Array.from(document.querySelectorAll<HTMLElement>(this.focusableElements))
                .filter(element => {
                    return (
                        !element.hasAttribute('disabled') &&
                        !element.hasAttribute('hidden') &&
                        element.offsetParent !== null &&
                        !element.hasAttribute('aria-hidden')
                    );
                });
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        window.keyboardNavigation = new KeyboardNavigation();

        // Enhance form elements
        const formElements = document.querySelectorAll('input, select, textarea');
        formElements.forEach(element => {
            // Add proper labels if missing
            if (!element.getAttribute('aria-label') && !element.getAttribute('aria-labelledby')) {
                const label = document.querySelector(`label[for="${element.id}"]`);
                if (label) {
                    element.setAttribute('aria-labelledby', label.id || `label-${element.id}`);
                    if (!label.id) {
                        label.id = `label-${element.id}`;
                    }
                }
            }

            element.addEventListener('invalid', () => {
                element.setAttribute('aria-invalid', 'true');
            });

            element.addEventListener('input', () => {
                if (
                    (element instanceof window.HTMLInputElement || element instanceof window.HTMLSelectElement || element instanceof window.HTMLTextAreaElement) &&
                    element.checkValidity()
                ) {
                    element.removeAttribute('aria-invalid');
                }
            });
        });
    });
</script>
