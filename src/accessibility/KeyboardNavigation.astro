---
import '@/styles/accessibility/keyboard-navigation.scss';
---

{/* Skip Links */}
<a href="#main-content" class="skip-link">Skip to main content</a>
<a href="#main-navigation" class="skip-link">Skip to navigation</a>

<script>
    class KeyboardNavigation {
        focusableElements: string;
        skipLinks: HTMLElement[];

        constructor() {
            this.focusableElements = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
            this.skipLinks = [];
            this.init();
        }

        init() {
            this.setupTabNavigation();
        }

        setupTabNavigation() {
            // Enhanced tab navigation for complex components
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Tab') {
                    this.handleTabNavigation(e);
                }
            });

            // Arrow key navigation for tab lists
            document.addEventListener('keydown', (e) => {
                const tabList = e.target && (e.target as HTMLElement).closest('[role="tablist"]');
                if (tabList && ['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) {
                    e.preventDefault();
                    this.handleTabListNavigation(e, tabList);
                }
            });
        }

        handleTabNavigation(e: KeyboardEvent) {
            const focusableElements = this.getFocusableElements();
            const currentIndex = focusableElements.indexOf(document.activeElement as Element);

            if (e.shiftKey) {
                // Shift + Tab: Move backwards
                if (currentIndex <= 0) {
                    e.preventDefault();
                    (focusableElements[focusableElements.length - 1] as HTMLElement).focus();
                }
            }
            else {
                // Tab: Move forwards
                if (currentIndex >= focusableElements.length - 1) {
                    e.preventDefault();
                    (focusableElements[0] as HTMLElement).focus();
                }
            }
        }

        handleTabListNavigation(e: KeyboardEvent, tabList: Element) {
            const tabs = Array.from(tabList.querySelectorAll('[role="tab"]'));
            const currentIndex = tabs.indexOf(document.activeElement as Element);

            switch (e.key) {
                case 'ArrowLeft':
                    const prevIndex = currentIndex > 0 ? currentIndex - 1 : tabs.length - 1;
                    (tabs[prevIndex] as HTMLElement).focus();
                    break;
                case 'ArrowRight':
                    const nextIndex = currentIndex < tabs.length - 1 ? currentIndex + 1 : 0;
                    (tabs[nextIndex] as HTMLElement).focus();
                    break;
                case 'Home':
                    (tabs[0] as HTMLElement).focus();
                    break;
                case 'End':
                    (tabs[tabs.length - 1] as HTMLElement).focus();
                    break;
            }
        }

        getFocusableElements() {
            return Array.from(document.querySelectorAll(this.focusableElements))
                .filter((el) => {
                    const htmlEl = el as HTMLElement;
                    return (
                        !el.hasAttribute('disabled') &&
                        !el.hasAttribute('hidden') &&
                        htmlEl.offsetParent !== null &&
                        !el.hasAttribute('aria-hidden')
                    );
                });
        }
    }

    // Initialize keyboard navigation when DOM is loaded
    document.addEventListener('DOMContentLoaded', () => {
        (window as object as { keyboardNavigation: KeyboardNavigation }).keyboardNavigation = new KeyboardNavigation();

        // Enhance form elements
        const formElements = document.querySelectorAll('input, select, textarea');
        formElements.forEach(element => {
            const formEl = element as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
            // Add proper labels if missing
            if (!element.getAttribute('aria-label') && !element.getAttribute('aria-labelledby')) {
                const label = document.querySelector(`label[for="${element.id}"]`);
                if (label) {
                    element.setAttribute('aria-labelledby', label.id || `label-${element.id}`);
                    if (!label.id) {
                        label.id = `label-${element.id}`;
                    }
                }
            }

            // Add error handling
            element.addEventListener('invalid', () => {
                element.setAttribute('aria-invalid', 'true');
            });

            formEl.addEventListener('input', () => {
                if (formEl.checkValidity()) {
                    element.removeAttribute('aria-invalid');
                }
            });
        });
    });
</script>