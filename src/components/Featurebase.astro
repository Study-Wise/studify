---
import { getFeaturebaseJwt } from '@/lib/featurebase';

const featurebaseJwt = getFeaturebaseJwt(Astro.locals.user);
---

{featurebaseJwt && <div data-featurebase-jwt={featurebaseJwt} hidden></div>}

<script>
    import { bootFeaturebase } from '@/lib/featurebase-client';

    bootFeaturebase();
</script>
