---
import appConfig from '@/lib/app.config';

import '@/styles/components/footer.scss';

const copyrightEnd = new Date().getFullYear();

const { hideCopyright = false } = Astro.props;
---

<footer class="footer" role="contentinfo">
    <div class="footer-content">
        {hideCopyright ? '' : <p>© {copyrightEnd === appConfig.copyrightStart ? copyrightEnd : `${appConfig.copyrightStart}-${copyrightEnd}`} {appConfig.name} (formerly {appConfig.formerName}). Powered by AI.</p>}
        <p>
            <small>Disclaimer: AI-generated content may contain inaccuracies. Always verify critical information.</small>
        </p>
    </div>
</footer>