---
import '@/styles/components/footer.scss';

const copyrightStart = 2025;
const copyright = new Date().getFullYear();

const { hideCopyright = false } = Astro.props;
---

<footer class="footer" role="contentinfo">
    <div class="footer-content">
        {hideCopyright ? '' : <p>© {copyright === copyrightStart ? copyright : `${copyrightStart}-${copyright}`} Studify (formerly StudyWise). Powered by AI.</p>}
        <p>
            <small>Disclaimer: AI-generated content may contain inaccuracies. Always verify critical information.</small>
        </p>
    </div>
</footer>