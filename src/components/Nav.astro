---
import { hasIcon,  getIcon } from '../lib/google-icons';
import '../styles/components/nav.scss';
const { pages, pTitle, mode } = Astro.props;
import { UserButton } from '@clerk/astro/components';
---
<!-- Navigation -->
<nav class:list={['header-nav', { 'lite': mode === 'lite' }]} role="navigation" aria-label="Main navigation" id="main-navigation">
    {pages.filter((page: { name: string; path: string; hiddenFromNav: boolean }) => !page.hiddenFromNav).map((page: { name: string; path: string; hiddenFromNav: boolean }) => {
        const hasAnIcon = hasIcon(page.name.toLowerCase().replace(/\s+/g, '_'));
        let icon = '';
        if (hasAnIcon === 'google') {
            icon = <span class="material-symbols-outlined" aria-hidden="true">{getIcon(page.name.toLowerCase().replace(/\s+/g, '_'))}</span>;
        } else if (hasAnIcon === 'custom') {
            icon = <img src={`/assets/icons/${getIcon(page.name.toLowerCase().replace(/\s+/g, '_'))}.svg`} alt={page.name} class="nav-icon" aria-hidden="true" />;
        }
        return <a href={page.path} class:list={['nav-btn', { 'active': pTitle === page.name }]} aria-current={pTitle === page.name ? 'page' : undefined}>
            {icon}
            {page.name}
        </a>
    })}
    <UserButton userProfileUrl="/user/profile" />
</nav>