---
import { generateAvatar } from '@/lib/avatar';

import '../styles/components/character-image.scss';

const { mode, class: className = '', crop } = Astro.props;
---
{mode.character ? (
    <div class="character-image-wrapper" data-crop={crop}>
        {mode.character?.pfp ? (
            <img src={mode.character.pfp} alt={`${mode.character.name} profile picture`} class:list={['character-image', ...className]} />
        ) : (
            <Fragment set:html={generateAvatar({ ...mode.character.appearance, ...mode.character.colors }).replace('<svg ', `<svg class="${className}" `)} />
        )}
    </div>
) : <span class={className}>{mode.icon}</span>}
