---
import { AuthenticateWithRedirectCallback } from '@clerk/astro/components';
import Layout from '../layouts/Layout.astro';
import '../styles/pages/auth.scss';

// Get the redirect URL from query parameters, fallback to home
const redirectUrl = Astro.url.searchParams.get('redirect_url') ||
                    Astro.url.searchParams.get('returnBackUrl') || '/';

// Check if user is already logged in
const { userId } = Astro.locals.auth();

// If user is already authenticated, redirect immediately without rendering
if (userId) {
    return Astro.redirect(redirectUrl);
}

const { page } = Astro.props;
---

<Layout title={page} className="auth-page">
    <div class="auth-container">
        <AuthenticateWithRedirectCallback
            signInForceRedirectUrl={redirectUrl}
            signUpForceRedirectUrl={redirectUrl}
        />
    </div>
</Layout>
