---
import appConfig from '@/lib/app.config';
import getAllSitePages from '@/lib/get-all-site-pages';

import Nav from '@/components/Nav.astro';
import '@/styles/components/header.scss';

const pages = getAllSitePages();

const imgAriaLabel = `${appConfig.name} Homepage`;
const imgAlt= `${appConfig.name} Logo`;
---
<header role="banner">
    {/* Wrap the logo image in an anchor tag */}
    <a href="/" title="Go to Homepage" class="header-logo-link" aria-label={imgAriaLabel}>
        <img src="/assets/logos/logo.png" alt={imgAlt} class="header-logo" />
    </a>

    {/* Container wraps text and nav */}
    <div class="header-content-wrapper">
        <div class="header-text-container">
            <h1><span class="material-symbols-outlined" aria-hidden="true">school</span> {appConfig.name}</h1>
            <p class="tagline">{appConfig.tagline} - By {appConfig.creators}</p>
        </div>
        <Nav pages={pages} />
    </div>
</header>
