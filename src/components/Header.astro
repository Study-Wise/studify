---
import '../styles/components/header.scss';

import { hasIcon } from '../lib/google-icons';

const pages = Object.entries(import.meta.glob('/src/pages/*.astro', { eager: true }))
  .map(([path, mod]) => {
    const fileName = path.split('/').pop();
    if (!fileName) return null;
    const name = fileName.replace('.astro', '');
    let route = '/' + (name === 'index' ? '' : name);
    const modTyped = mod as Record<string, any>;
    let pageTitle = modTyped && modTyped.title ? modTyped.title : (name.charAt(0).toUpperCase() + name.slice(1));
    if (name === 'index') pageTitle = 'Home';
    return { name: pageTitle, path: route };
  })
  .filter((page): page is { name: string; path: string } => !!page)
  .sort((a, b) => (a.name === 'Home' ? -1 : (b.name === 'Home' ? 1 : 0)));
const { pTitle } = Astro.props;
---
<header>
    <!-- Wrap the logo image in an anchor tag -->
    <a href="/" title="Go to Homepage" class="header-logo-link">
      <img src="images/logo.png" alt="M.A.T.H.Wise Logo" class="header-logo" />
    </a>

    <!-- Container wraps text and nav -->
    <div class="container header-content-wrapper">
      <div class="header-text-container">
        <h1><span class="material-symbols-outlined">school</span> M.A.T.H.Wise</h1>
        <p class="tagline">Your AI-Powered Study Partner - By Rien Gupta and Adarsh R. Kumar</p>
      </div>
      <!-- Navigation -->
      <nav class="header-nav">
        {pages.map(page => {
          const hasAnIcon = hasIcon(page.name.toLowerCase().replace(/\s+/g, '_'));
          let icon = '';
          if (hasAnIcon === 'google') {
            icon = <span class="material-symbols-outlined">{page.name.toLowerCase().replace(/\s+/g, '_')}</span>;
          } else if (hasAnIcon === 'custom') {
            icon = <img src={`/assets/icons/${page.name.toLowerCase().replace(/\s+/g, '_')}.svg`} alt={page.name} class="nav-icon" />;
          }
          return <a href={page.path} class={pTitle === page.name ? 'active nav-btn' : 'nav-btn'}>
            {icon}
            {page.name}
          </a>
        })}
      </nav>
    </div>
</header>