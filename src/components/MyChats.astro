---
import categories from '@/lib/modes';
import { getUserThreads } from '@/lib/threads';

import LocalTime from '@/components/LocalTime.astro';
import '@/styles/components/my-chats.scss';

const user = Astro.locals.user;

if (!user) return Astro.redirect('/user/sign-in?redirect=/user/my-chats');

const userEmail = user.email;

const threads = await getUserThreads(userEmail);

const threadsByCategory = threads.reduce<Record<string, Record<string, typeof threads>>>((acc, thread) => {
    const categoryThreads = (acc[thread.category] ??= {});
    (categoryThreads[thread.mode] ??= []).push(thread);
    return acc;
}, {});
---

<div class="my-chats-container">
    {threads.length > 0 && (
        <>
            <div class="chat-search">
                <input type="search" id="chat-search-input" class="chat-search-input" placeholder="Search your chats" aria-label="Search your chats" autocomplete="off" />
                <select id="chat-filter" class="chat-filter" aria-label="Filter chats by subject">
                    <option value="">All subjects</option>
                    {Object.entries(threadsByCategory).map(([categoryKey, threadsByMode]) => categories[categoryKey] && (
                        <optgroup label={categories[categoryKey].name}>
                            <option value={categoryKey}>All {categories[categoryKey].name}</option>
                            {Object.keys(threadsByMode).map((modeKey) => (
                                <option value={`${categoryKey}/${modeKey}`}>{categories[categoryKey].modes[modeKey]?.modeName ?? modeKey}</option>
                            ))}
                        </optgroup>
                    ))}
                </select>
            </div>
            <p class="no-results is-hidden" id="no-results">No chats match your search.</p>
        </>
    )}
    {threads.length === 0 ? (
        <div class="empty-state card">
            <span class="material-symbols-outlined empty-icon" aria-hidden="true">chat_bubble_outline</span>
            <h2>No chats yet</h2>
            <p>Start a conversation in any subject to see it here!</p>
            <a href="/" class="btn primary">Browse Subjects</a>
        </div>
    ) : (
        <div class="threads-container">
            {Object.entries(threadsByCategory).map(([categoryKey, threadsByMode]) => {
                const category = categories[categoryKey];
                if (!category) return null;

                return (
                    <section class="category-section card">
                        <h2 class="category-title">{category.name}</h2>
                        {Object.entries(threadsByMode).map(([modeKey, modeThreads]) => {
                            const mode = category.modes[modeKey];

                            return (
                                <div class="mode-section">
                                    <h3 class="mode-title">{mode ? mode.modeName : modeKey}</h3>
                                    <div class="threads-list">
                                        {modeThreads.map((thread) => {
                                            const displayTitle = thread.title.trim() || (mode ? mode.modeName : thread.mode);
                                            const chatUrl = `/${categoryKey}/${thread.mode}/chat/${thread.id}`;

                                            return (
                                                <div class="thread-row" data-thread-id={thread.id} data-category={categoryKey} data-mode={thread.mode}>
                                                    <a href={chatUrl} class="thread-card">
                                                        <div class="thread-header">
                                                            <div class="thread-info">
                                                                {mode && <span class="mode-icon">{mode.icon}</span>}
                                                                <div class="thread-text">
                                                                    <h3 class="thread-title">{displayTitle}</h3>
                                                                    <p class="thread-mode">
                                                                        {mode ? mode.modeName : thread.mode}
                                                                    </p>
                                                                </div>
                                                            </div>
                                                            <div class="thread-meta">
                                                                <span class="thread-date">
                                                                    <LocalTime date={thread.updatedAt} locale="en-US" options={{ dateStyle: 'medium', timeStyle: 'short' }} />
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </a>
                                                    <button
                                                        type="button"
                                                        class="thread-delete"
                                                        data-thread-id={thread.id}
                                                        data-thread-title={displayTitle}
                                                        title="Delete chat"
                                                        aria-label={`Delete chat: ${displayTitle}`}
                                                    >
                                                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                                    </button>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })}
                    </section>
                );
            })}
        </div>
    )}
</div>

<script is:inline>
    const searchInput = document.getElementById('chat-search-input');
    const filterSelect = document.getElementById('chat-filter');

    function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        const subject = filterSelect.value;

        document.querySelectorAll('.thread-row').forEach(row => {
            const title = row.querySelector('.thread-title').textContent.toLowerCase();
            const matchesSubject = !subject || subject === row.dataset.category || subject === `${row.dataset.category}/${row.dataset.mode}`;
            row.classList.toggle('is-hidden', !(title.includes(query) && matchesSubject));
        });

        // Hide the mode and category sections that have no matching chats left
        document.querySelectorAll('.mode-section, .category-section').forEach(section => {
            section.classList.toggle('is-hidden', !section.querySelector('.thread-row:not(.is-hidden)'));
        });

        document.getElementById('no-results').classList.toggle('is-hidden', Boolean(document.querySelector('.thread-row:not(.is-hidden)')));
    }

    searchInput?.addEventListener('input', applyFilters);
    filterSelect?.addEventListener('change', applyFilters);

    document.querySelector('.my-chats-container')?.addEventListener('click', async e => {
        const deleteButton = e.target.closest('.thread-delete');
        if (!deleteButton) return;

        const threadId = deleteButton.getAttribute('data-thread-id');
        if (!threadId) return;

        const threadTitle = deleteButton.getAttribute('data-thread-title');
        const confirmed = await window.showConfirm(
            'This cannot be undone.',
            { title: `Delete "${threadTitle}"?`, confirmLabel: 'Delete', icon: 'delete' },
        );
        if (!confirmed) return;

        deleteButton.disabled = true;
        const originalContent = deleteButton.innerHTML;
        deleteButton.innerHTML = '<span class="material-symbols-outlined spinning" aria-hidden="true">progress_activity</span>';

        try {
            const response = await fetch('/api/thread/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status !== 'success') throw new Error(data.error || 'Failed to delete chat');

            const row = deleteButton.closest('.thread-row');
            const modeSection = row?.closest('.mode-section');
            const section = row?.closest('.category-section');
            row?.remove();

            // Remove the mode and category sections if they have no chats left
            if (modeSection && !modeSection.querySelector('.thread-row')) modeSection.remove();
            if (section && !section.querySelector('.thread-row')) section.remove();

            // Reload to show the empty state when no chats remain
            if (!document.querySelector('.my-chats-container .thread-row')) {
                window.showSuccessAfterNavigation?.('Chat deleted');
                window.location.reload();
                return;
            }

            window.showSuccess?.('Chat deleted');
        } catch (error) {
            console.error('Error deleting chat:', error);
            window.showError?.(
                error instanceof Error ? error.message : 'Failed to delete chat. Please try again.'
            );
            deleteButton.innerHTML = originalContent;
            deleteButton.disabled = false;
        }
    });
</script>
