---
import '@/styles/components/content-actions.scss';

interface Props {
    contentType: string;
    threadId: string;
    hasContent: boolean;
    isAuthorized: boolean;
    chatUrl: string;
    generateVerb?: string;
    regenerateVerb?: string;
}

const {
    contentType,
    threadId,
    hasContent,
    isAuthorized,
    chatUrl,
    generateVerb = 'Generate',
    regenerateVerb = 'Regenerate',
} = Astro.props;

const contentTypeName = contentType.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
---

<div class="content-actions">
    <a href={chatUrl} class="action-btn secondary">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span>Back to Chat</span>
    </a>

    {isAuthorized && (
        <button
            type="button"
            id={`${contentType}-action-btn`}
            class="action-btn primary"
            data-thread-id={threadId}
            data-content-type={contentType}
            data-has-content={hasContent.toString()}
        >
            <span class="material-symbols-outlined" aria-hidden="true">{hasContent ? 'refresh' : 'auto_awesome'}</span>
            <span>{hasContent ? `${regenerateVerb} ${contentTypeName}` : `${generateVerb} ${contentTypeName}`}</span>
        </button>
    )}
</div>

<script is:inline define:vars={{ contentType, threadId, hasContent, generateVerb, regenerateVerb }}>
    const actionBtn = document.getElementById(`${contentType}-action-btn`);
    const apiEndpoint = `/api/${contentType}/generate`;
    const contentTypeName = contentType.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    const contentClassName = contentType.replace(/-/g, '-') + '-content';

    // Content types that use markdown
    const markdownTypes = ['study-guide', 'reference-sheet', 'flashcards', 'practice-questions'];
    // Content types that use iframes
    const iframeTypes = ['mind-map', 'webpage', 'slideshow'];
    // Content types that use images
    const imageTypes = ['infographic'];

    async function loadMarked() {
        if (window.marked) return window.marked;
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = 'https://cdn.jsdelivr.net/npm/marked/marked.min.js';
            script.onload = () => resolve(window.marked);
            script.onerror = reject;
            document.head.appendChild(script);
        });
    }

    async function updatePageContent(content) {
        const page = document.querySelector(`.${contentType}-page, .${contentType.replace(/-/g, '')}-page`);
        if (!page) return;

        const emptyState = page.querySelector('.empty-state');

        if (markdownTypes.includes(contentType)) {
            const marked = await loadMarked();
            const parsedContent = marked.parse(content);

            let contentContainer = page.querySelector('.content-container');
            let contentDiv = page.querySelector(`.${contentClassName}`);

            if (emptyState && !contentContainer) {
                contentContainer = document.createElement('div');
                contentContainer.className = 'content-container';
                contentDiv = document.createElement('div');
                contentDiv.className = contentClassName;
                contentContainer.appendChild(contentDiv);
                emptyState.replaceWith(contentContainer);
            }

            if (contentDiv) {
                contentDiv.innerHTML = parsedContent;
            }

            // Render any Desmos graphs in the new content
            window.activateDesmos?.();
        }
        else if (iframeTypes.includes(contentType)) {
            let container = page.querySelector(`.${contentType}-container`);
            let iframe = page.querySelector('iframe');

            if (emptyState && !container) {
                container = document.createElement('div');
                container.className = `${contentType}-container`;
                iframe = document.createElement('iframe');
                iframe.title = contentTypeName;
                iframe.className = `${contentType}-iframe`;
                iframe.sandbox = 'allow-scripts allow-same-origin';
                container.appendChild(iframe);
                emptyState.replaceWith(container);
            }

            if (iframe) {
                iframe.srcdoc = content;
            }
        }
        else if (imageTypes.includes(contentType)) {
            // For infographic, content is an object with imageUrl
            const imageUrl = typeof content === 'object' ? content.imageUrl : content;
            let contentContainer = page.querySelector('.content-container');
            let img = page.querySelector('.infographic-image');

            if (emptyState && !contentContainer) {
                contentContainer = document.createElement('div');
                contentContainer.className = 'content-container';
                img = document.createElement('img');
                img.className = 'infographic-image';
                img.alt = 'Generated Infographic';
                contentContainer.appendChild(img);
                emptyState.replaceWith(contentContainer);
            }

            if (img) {
                img.src = imageUrl;
            }
        }
    }

    if (actionBtn) {
        actionBtn.addEventListener('click', async () => {
            const currentHasContent = actionBtn.getAttribute('data-has-content') === 'true';
            const isRegenerate = currentHasContent;

            if (isRegenerate) {
                const confirmMessage = `Are you sure you want to ${regenerateVerb.toLowerCase()} the ${contentTypeName.toLowerCase()}? This will replace the existing one.`;
                if (!confirm(confirmMessage)) return;
            }

            actionBtn.setAttribute('disabled', 'true');
            const originalContent = actionBtn.innerHTML;
            const loadingText = `${(isRegenerate ? regenerateVerb : generateVerb).replace(/^(\w+?)e?\b/, '$1ing')}…`;
            actionBtn.innerHTML = `<span class="material-symbols-outlined spinning" aria-hidden="true">progress_activity</span><span>${loadingText}</span>`;

            try {
                const response = await fetch(apiEndpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ threadId }),
                });

                const data = response.headers.get('Content-Type')?.includes('application/json') ? await response.json() : null;

                if (!response.ok || !data) {
                    throw new Error(data?.error || `Failed to generate ${contentTypeName.toLowerCase()} (server error ${response.status}). Please try again.`);
                }

                if (data.status === 'success') {
                    const content = data.content || data.infographic;
                    if (content) {
                        await updatePageContent(content);
                    }

                    actionBtn.setAttribute('data-has-content', 'true');
                    actionBtn.innerHTML = `<span class="material-symbols-outlined" aria-hidden="true">refresh</span><span>${regenerateVerb} ${contentTypeName}</span>`;
                    actionBtn.removeAttribute('disabled');
                }
                else {
                    throw new Error(data.error || `Failed to generate ${contentTypeName.toLowerCase()}`);
                }
            } catch (error) {
                console.error(`Error generating ${contentTypeName.toLowerCase()}:`, error);
                window.showError?.(error instanceof Error ? error.message : `Failed to generate ${contentTypeName.toLowerCase()}. Please try again.`);

                actionBtn.removeAttribute('disabled');
                actionBtn.innerHTML = originalContent;
            }
        });
    }
</script>
