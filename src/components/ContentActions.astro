---
import '@/styles/components/content-actions.scss';

const {
    threadId,
    hasContent,
    isAuthorized,
    generateVerb = 'Generate',
    regenerateVerb = 'Regenerate',
} = Astro.props;

const { category, mode } = Astro.params;
const contentType = Astro.routePattern.split('/')[3];
const chatUrl = `/${category}/${mode}/chat/${threadId}`;

const contentTypeName = contentType.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
---
<div class="content-actions">
    <a href={chatUrl} class="content-actions__button" data-variant="secondary">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        <span>Back to Chat</span>
    </a>
    {isAuthorized && (
        <button type="button" id={`${contentType}-action-btn`} class="content-actions__button" data-variant="primary" data-thread-id={threadId} data-content-type={contentType} data-has-content={hasContent.toString()}>
            <span class="material-symbols-outlined" aria-hidden="true">{hasContent ? 'refresh' : 'auto_awesome'}</span>
            <span>{hasContent ? `${regenerateVerb} ${contentTypeName}` : `${generateVerb} ${contentTypeName}`}</span>
        </button>
    )}
</div>

<script is:inline define:vars={{ contentType, contentTypeName, threadId, generateVerb, regenerateVerb }}>
    const actionBtn = document.getElementById(`${contentType}-action-btn`);

    if (actionBtn) {
        actionBtn.addEventListener('click', async () => {
            const isRegenerate = actionBtn.getAttribute('data-has-content') === 'true';

            let userPrompt = '';
            if (isRegenerate) {
                const confirmMessage = `Are you sure you want to ${regenerateVerb.toLowerCase()} the ${contentTypeName.toLowerCase()}? This will replace the existing one.`;
                const answer = await window.showPrompt(confirmMessage, { title: `${regenerateVerb} ${contentTypeName}?`, confirmLabel: regenerateVerb, icon: 'refresh', inputLabel: 'What should change? (optional)', placeholder: 'For example: make it shorter, or add more examples', maxLength: 500 });
                if (answer === null) return;
                userPrompt = answer;
            }

            actionBtn.setAttribute('disabled', 'true');
            const originalContent = actionBtn.innerHTML;
            const loadingText = `${(isRegenerate ? regenerateVerb : generateVerb).replace(/^(\w+?)e?\b/, '$1ing')}…`;
            actionBtn.innerHTML = `<span class="material-symbols-outlined content-actions__spinner" aria-hidden="true">progress_activity</span><span>${loadingText}</span>`;

            const startedAt = Date.now();
            const timerLabel = actionBtn.lastElementChild;
            const timer = window.setInterval(() => {
                const seconds = Math.floor((Date.now() - startedAt) / 1000);
                timerLabel.textContent = `${loadingText} ${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
            }, 1000);

            try {
                const response = await fetch(`/api/${contentType}/generate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ threadId, userPrompt }),
                });

                const data = response.headers.get('Content-Type')?.includes('application/json') ? await response.json() : null;

                if (!response.ok || !data) throw new Error(data?.error || `Failed to generate ${contentTypeName.toLowerCase()} (server error ${response.status}). Please try again.`);

                if (data.status !== 'success') throw new Error(data.error || `Failed to generate ${contentTypeName.toLowerCase()}`);

                window.location.reload();
            } catch (error) {
                console.error(`Error generating ${contentTypeName.toLowerCase()}:`, error);
                window.showError?.(error instanceof Error ? error.message : `Failed to generate ${contentTypeName.toLowerCase()}. Please try again.`);

                actionBtn.removeAttribute('disabled');
                actionBtn.innerHTML = originalContent;
            } finally {
                window.clearInterval(timer);
            }
        });
    }
</script>
