---
// import '../styles/pages/settings.scss';
import SettingsScript from '../scripts/settings.astro';

import { models, providers } from '../lib/models';
import config from '../lib/config';

interface ModelOption {
    name: string;
}

const selectorSettings: {
    id: string;
    name: string;
    options: ModelOption[];
    default: string;
} = {
    id: 'model',
    name: 'Model',
    options: models as ModelOption[],
    default: '',
};

if (selectorSettings.options.length > 0 && selectorSettings.options[0].name !== 'Select A Model') {
    selectorSettings.options.unshift({ name: 'Select A Model' });
}
providers['studywise'] = {
    name: 'MW',
    models: {
        '': { name: 'Select A Model' },
    },
}


---
<div class="model-selector">
    <label for={selectorSettings.id}>{selectorSettings.name}:</label>
    {Array.isArray(selectorSettings.options) ? (
        <select class="fancy-select" id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.default}>
            {/* <selectedcontent /> */}
            {selectorSettings.options.map(option => {
                const providerKey = option.name === 'Select A Model' ? 'studywise' : Object.keys(providers).find(p => {
                    const provider = providers[p as keyof typeof providers];
                    return Object.keys(provider.models).find(m => (provider.models as { [key: string]: { name: string } })[m].name === option.name);
                });
                const currKey = providerKey && providerKey in providers
                    ? Object.keys(providers[providerKey as keyof typeof providers].models).find(m => (providers[providerKey as keyof typeof providers].models as { [key: string]: { name: string } })[m].name === option.name)
                    : '';
                
                return (
                    <option value={currKey} selected={currKey === selectorSettings.default} disabled={option.name === 'Select A Model'}>
                        {option.name === 'Select A Model'
                            ? ''
                            : <img src={`/assets/providers/${providerKey || 'default'}.svg`} alt={providerKey && providers[providerKey as keyof typeof providers]?.name ? providers[providerKey as keyof typeof providers].name : 'Provider'} />}
                        {option.name || currKey}
                    </option>
                );
            })}
        </select>
    ) : typeof selectorSettings.options === 'object' ? (
        <select id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.options[selectorSettings.default]}>
            {Object.keys(selectorSettings.options).map(option => (
                <option value={option} selected={option === selectorSettings.default}>{(selectorSettings.options as unknown as { [key: string]: { name: string } })[option].name || option}</option>
            ))}
        </select>
    ) : (
        <input type="text" id={selectorSettings.id} name={selectorSettings.id} value={Array.isArray(selectorSettings) ? selectorSettings[1] : ''} />
    )}
</div>
<script>
    document.querySelectorAll('select.fancy-select selectedcontent').forEach(sc => sc.outerHTML = `<button>${sc.outerHTML}</button>`)
</script>
<script is:inline>
    window.addEventListener('DOMContentLoaded', () => window.activateLocalStorageInput('model'));
</script>