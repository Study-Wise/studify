---
import { getSelectableProviders } from '@/lib/models';

const selectableProviders = getSelectableProviders();

// Build a flat list of tier options from all providers
const tierOptions = [] as Array<{ key: string; provider: string; tierKey: string; name: string }>;
for (const [providerKey, provider] of Object.entries(selectableProviders)) {
    for (const [tierKey, tierOption] of Object.entries(provider.tiers)) {
        if (tierOption.selectableInUI !== false) {
            tierOptions.push({
                key: `${providerKey}/${tierKey}`,
                provider: providerKey,
                tierKey: tierKey,
                name: tierOption.name
            });
        }
    }
}

export interface SelectorSettings {
    id: string;
    name: string;
    options: Array<{ key: string; provider: string; tierKey: string; name: string }>;
    default: string;
}

const selectorSettings: SelectorSettings = {
    id: 'tier-selector',
    name: 'Model Tier',
    options: tierOptions,
    default: ''
};
---

<div class="model-selector">
    <label for={selectorSettings.id}>{selectorSettings.name}:</label>
    <select class="fancy-select" id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.default}>
        <option value="" disabled>Select A Tier</option>
        {selectorSettings.options.map(option => (
            <option value={option.key}>
                {selectableProviders[option.provider]?.name || 'Unknown'} - {option.name}
            </option>
        ))}
    </select>
</div>

<script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
        const selector = document.getElementById('tier-selector');
        if (!selector) return;

        function getSettings() {
            try {
                return JSON.parse(localStorage.getItem('settings') || '{}');
            } catch (e) {
                return {};
            }
        }

        function setSetting(key, value) {
            const userSettings = getSettings();
            userSettings[key] = value;
            localStorage.setItem('settings', JSON.stringify(userSettings));
        }

        const userSettings = getSettings();
        const provider = userSettings['provider'] || 'openai';
        const tier = userSettings['tier'] || 'default';
        selector.value = `${provider}/${tier}`;

        selector.addEventListener('change', (e) => {
            const value = e.target.value;
            if (!value) return;
            const [providerKey, tierKey] = value.split('/');
            setSetting('provider', providerKey);
            setSetting('tier', tierKey);
        });
    });
</script>