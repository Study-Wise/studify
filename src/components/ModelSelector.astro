---
// import '../styles/pages/settings.scss';
import SettingsScript from '../scripts/settings.astro';

import { models, providers } from '../lib/models';
import config from '../lib/config';

const selectorSettings = {
    id: 'model',
    name: 'Model',
    options: models,
    default: '',
}

if (selectorSettings.options.length > 0 && selectorSettings.options[0].name !== 'Select A Model') {
    selectorSettings.options.unshift({ name: 'Select A Model' });
}
providers['mathwise'] = {
    name: 'MW',
    models: {
        '': { name: 'Select A Model' },
    },
}


---
<div class="model-selector">
    <label for={selectorSettings.id}>{selectorSettings.name}:</label>
    {Array.isArray(selectorSettings.options) ? (
        <select class="fancy-select" id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.default}>
            {/* <selectedcontent /> */}
            {selectorSettings.options.map(option => {
                const providerKey = option.name === 'Select A Model' ? 'mathwise' : Object.keys(providers).find(p =>
                    Object.keys(providers[p].models).find(m => providers[p].models[m].name === option.name)
                );
                const currKey = providerKey
                    ? Object.keys(providers[providerKey].models).find(m => providers[providerKey].models[m].name === option.name)
                    : '';
                
                return (
                    <option value={currKey} selected={currKey === selectorSettings.default} disabled={option.name === 'Select A Model'}>
                        {option.name === 'Select A Model' ? '' : <img src={`/images/providers/${providerKey || 'default'}.svg`} alt={providerKey ? providers[providerKey].name : 'Provider'} />}
                        {option.name || currKey}
                    </option>
                );
            })}
        </select>
    ) : typeof selectorSettings.options === 'object' ? (
        <select id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.options[selectorSettings.default]}>
            {Object.keys(selectorSettings.options).map(option => (
                <option value={option} selected={selectorSettings.options[option] === selectorSettings.default}>{selectorSettings.options[option].name || option}</option>
            ))}
        </select>
    ) : (
        <input type="text" id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings[1]} />
    )}
</div>
<script>
    document.querySelectorAll('select.fancy-select selectedcontent').forEach(sc => sc.outerHTML = `<button>${sc.outerHTML}</button>`)
</script>
<script is:inline>
  // Add change listeners for all settings
  settings.forEach(setting => {
    const el = document.getElementById(setting.id);
    if (el) {
      el.addEventListener('change', function () {
        setSetting(setting.id, this.value);
      });
    }
  });

  function activateDependencies() {
    // Dependency logic (if any)
    settings.forEach(setting => {
      if (setting.dependencies) {
        setting.dependencies.forEach(dependency => {
          const el = document.getElementById(dependency);
          if (el) {
            handleDependentChanges(el, dependency)
          }
        });
      }
    });
  }

  function handleDependentChanges(el, dep) {
    el.addEventListener('change', () => {
      dependentChangeActions(el, dep);
    });
  }

  function dependentChangeActions(el, dep) {
    const value = el.value;
      const setting = settings.find(s => s.id === dep);
      const dependentSettings = settings.filter(s => s.dependencies && s.dependencies.includes(dep));
      dependentSettings.forEach(s => {
        const sEl = document.getElementById(s.id);
        const id = `${s.id}s`;
        console.log(setting.options)
        const options = setting.options[value][id]
        sEl.querySelectorAll('option').forEach(o => o.remove());
        Object.keys(options).forEach(o => {
          const option = document.createElement('option');
          option.value = o;
          option.textContent = options[o].name;
          sEl.appendChild(option);
        });

      setSetting(s.id, Object.keys(options)[0]);
    });
  }

  function setSetting(key, value) {
    let userSettings = {};
    try {
      userSettings = JSON.parse(localStorage.getItem('settings')) || {};
    } catch (e) {
      userSettings = {};
    }
    userSettings[key] = value;
    localStorage.setItem('settings', JSON.stringify(userSettings));
  }

  // Initialize form values from localStorage
  window.addEventListener('DOMContentLoaded', () => {
    let userSettings = {};
    try {
      userSettings = JSON.parse(localStorage.getItem('settings')) || {};
    } catch (e) {}
    const settingIds = settings.map(s => s.id);
    
    activateDependencies()
    for (const settingId of settingIds) {
      if (userSettings[settingId]) {
        const el = document.getElementById(settingId);
        console.log(userSettings[settingId])

        if (el) el.value = userSettings[setting];
      }
    }
    settings.forEach(setting => {
      if (setting.dependencies) {
        setting.dependencies.forEach(dependency => {
          const elem = document.getElementById(dependency);
          if (elem) {
            dependentChangeActions(elem, dependency)
          }
        });
      }
    });
  });
</script>