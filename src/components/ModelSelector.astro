---
// import '../styles/pages/settings.scss';

import { models, providers } from '../lib/models';
import type { ModelOption, Providers, SelectorSettings } from '../lib/types';

// Filter out models that are not selectable in UI
const selectableModels = models.filter((model: any) => model.selectableInUI !== false);

const selectorSettings: SelectorSettings = {
    id: 'model',
    name: 'Model',
    options: selectableModels as ModelOption[],
    default: '',
};

if (Array.isArray(selectorSettings.options) && selectorSettings.options.length > 0 && selectorSettings.options[0].name !== 'Select A Model') {
    selectorSettings.options.unshift({ name: 'Select A Model' });
}
(providers as Providers)['studywise'] = {
    name: 'MW',
    models: {
        '': { name: 'Select A Model' },
    },
}

const modelOptionRecord = selectorSettings.options as Record<string, ModelOption>;


---
<div class="model-selector">
    <label for={selectorSettings.id}>{selectorSettings.name}:</label>
    {Array.isArray(selectorSettings.options) ? (
        <select class="fancy-select" id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.default}>
            {/* <selectedcontent /> */}
            {selectorSettings.options.map(option => {
                const providerKey = option.name === 'Select A Model' ? 'studywise' : Object.keys(providers).find(p =>
                    Object.keys((providers as Providers)[p].models).find(m => (providers as Providers)[p].models[m].name === option.name)
                );
                const currKey = providerKey
                    ? Object.keys((providers as Providers)[providerKey].models).find(m => (providers as Providers)[providerKey].models[m].name === option.name)
                    : '';
                
                return (
                    <option value={currKey} selected={currKey === selectorSettings.default} disabled={option.name === 'Select A Model'}>
                        {option.name === 'Select A Model' ? '' : <img src={`/assets/providers/${providerKey || 'default'}.svg`} alt={providerKey ? (providers as Providers)[providerKey].name : 'Provider'} />}
                        {option.name || currKey}
                    </option>
                );
            })}
        </select>
    ) : typeof selectorSettings.options === 'object' ? (
        <>
            <select id={selectorSettings.id} name={selectorSettings.id} value={selectorSettings.options[selectorSettings.default]?.name}>
                {Object.keys(selectorSettings.options).map(option => (
                    <option value={option} selected={option === selectorSettings.default}>{modelOptionRecord[option].name || option}</option>
                ))}
            </select>
        </>
    ) : (
        <input type="text" id={selectorSettings.id} name={selectorSettings.id} value={modelOptionRecord[selectorSettings.default]?.name} />
    )}
</div>
<script>
    document.querySelectorAll('select.fancy-select selectedcontent').forEach(sc => sc.outerHTML = `<button>${sc.outerHTML}</button>`)
</script>
<script is:inline>
    window.addEventListener('DOMContentLoaded', () => window.activateLocalStorageInput('model'));
</script>