---
import hmacSHA256 from 'crypto-js/hmac-sha256';
import Hex from 'crypto-js/enc-hex';

const secretKey = import.meta.env.TAWK_SECRET_KEY;

const user = Astro.locals.user;

/**
 * Using Crypto JS for the encryption
 * @param {string} userId
 */
function hashInBase64(userId: string) {
    var hash = hmacSHA256(userId, secretKey);

    return Hex.stringify(hash);
}

const hashedUserId = hashInBase64(user.id);
---
<!--Start of Tawk.to Script-->
<script is:inline define:vars={{ user, hashedUserId }}>
    var Tawk_API = Tawk_API||{}, Tawk_LoadStart = new Date();

    Tawk_API.visitor = {
        name: user.name || undefined,
        email: user.email || undefined,
        id: user.id || undefined,
        role: user.role || undefined,
        hash: hashedUserId || undefined
    };

    (function() {
        var s1 = document.createElement("script"), s0 = document.getElementsByTagName("script")[0];
        s1.async = true;
        s1.src = 'https://embed.tawk.to/6acfb523ac672c34c482efdc/1k4tln55a';
        s1.charset = 'UTF-8';
        s1.setAttribute('crossorigin','*');
        s0.parentNode.insertBefore(s1,s0);
    })();
</script>
<!--End of Tawk.to Script-->