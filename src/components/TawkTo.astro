---
import { createHmac } from 'node:crypto';

const secretKey = import.meta.env.TAWK_SECRET_KEY || process.env.TAWK_SECRET_KEY;

// Tawk.to's login API expects a hex encoded HMAC-SHA256 of the user ID.
// Keep the secret on the server, and do not send visitor details without a hash.
if (Astro.locals.user && secretKey) {
    Astro.locals.user.hash = createHmac('sha256', secretKey).update(Astro.locals.user.id).digest('hex');
    Astro.locals.user.emailHash = createHmac('sha256', secretKey).update(Astro.locals.user.email).digest('hex');
}
---
<!--Start of Tawk.to Script-->
<script is:inline define:vars={{ user: Astro.locals.user || null }}>
    /* global user */
    var Tawk_API = window.Tawk_API = window.Tawk_API || {};

    if (user && user.hash) {
        console.info('Tawk.to: authenticated login configured');
        Tawk_API.onBeforeLoad = function() {
            console.info('Tawk.to: API ready; authenticating visitor');
            Tawk_API.login({
                hash: user.hash,
                userId: user.id,
                name: user.name || undefined,
                email: user.email || undefined,
                role: user.role || undefined,
                profileImage: user.image || undefined
            }, function(error) {
                if (error) console.error('Tawk.to login failed:', error);
                else {
                    console.info('Tawk.to login succeeded');
                    Tawk_API.setAttributes({
                        name: user.name || undefined,
                        email: user.email || undefined,
                        userId: user.id,
                        hash: user.emailHash,
                        role: user.role || undefined,
                        profileImage: user.image || undefined
                    }, function(attributeError) {
                        if (attributeError) console.error('Tawk.to setAttributes failed:', attributeError);
                        else console.info('Tawk.to attributes set');
                    });
                }
            });
        };
    }
    else if (user) console.error('Tawk.to: authenticated login skipped because no hash was generated');
    window.Tawk_LoadStart = new Date();

    (function() {
        var s1 = document.createElement('script'), s0 = document.querySelector('script');
        s1.async = true;
        s1.src = 'https://embed.tawk.to/6acfb523ac672c34c482efdc/1k4tln55a';
        s1.setAttribute('crossorigin','*');
        s1.onload = function() {
            console.info('Tawk.to: embed script loaded');
        };
        s1.onerror = function(error) {
            console.error('Tawk.to: embed script failed to load', error);
        };
        s0.parentNode.insertBefore(s1, s0);
    })();

    window.Tawk_API = Tawk_API;

    window.togglechatpane = function() {
        if (window.Tawk_API && typeof window.Tawk_API.maximize === 'function') window.Tawk_API.toggle();
        else console.warn('Tawk.to API not ready yet; cannot toggle chat pane');
    };
</script>
<!--End of Tawk.to Script-->
