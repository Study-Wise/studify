---
import '@/styles/components/user-button.scss';
import SignOutScript from '@/scripts/auth/sign-out.astro';
---

{Astro.locals.user ? (
    <div class="user-button-container">
        <button type="button" class="user-button nav-btn" id="user-menu-trigger" aria-label="User menu">
            <span class="material-symbols-outlined" aria-hidden="true">account_circle</span>
            <span class="user-name">{Astro.locals.user.name || Astro.locals.user.email}</span>
        </button>
        <div class="user-menu" id="user-menu" hidden>
            <a href="/user/profile" class="user-menu-item">Profile</a>
            <button type="button" id="signout-btn" class="user-menu-item signout">Sign Out</button>
        </div>
    </div>
) : (
    <a href="/user/sign-in" class="nav-btn">
        <span class="material-symbols-outlined" aria-hidden="true">login</span>
        Sign In
    </a>
)}

<script>
    const menuTrigger = document.getElementById('user-menu-trigger');
    const menu = document.getElementById('user-menu');

    menuTrigger?.addEventListener('click', e => {
        e.stopPropagation();
        menu?.toggleAttribute('hidden');
    });

    // Close menu when clicking outside
    document.addEventListener('click', () => {
        if (menu && !menu.hasAttribute('hidden')) menu.setAttribute('hidden', '');
    });

    // Prevent menu from closing when clicking inside it
    menu?.addEventListener('click', e => {
        e.stopPropagation();
    });
</script>

<SignOutScript />
