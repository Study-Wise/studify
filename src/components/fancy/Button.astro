---
const { element = 'button', variant = 'primary', icon = '', className = '', mode = 'full', type = element === 'button' ? 'button' : undefined, ...props } = Astro.props;
---
{(() => {
    const Element = element;
    return (
        <Element type={type} tabindex="0" class:list={['btn', className]} data-bg={variant} data-mode={mode} {...props}>
            {icon && <span class="material-symbols-outlined" aria-hidden="true">{icon}</span>}
            {mode === 'tab' ? <span class="btn__text"><slot /></span> : <slot />}
            <span class="btn__spinner" style="display: none"></span>
        </Element>
    );
})()}