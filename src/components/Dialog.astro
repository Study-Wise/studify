---
import '@/styles/components/modal.scss';
---

<script>
    type ModalType = 'info' | 'error' | 'warning' | 'success';

    type ModalContent = {
        title: string;
        message: string;
        type?: ModalType;
        icon?: string;
        buttons?: { label: string; variant?: 'primary' | 'secondary'; onClick?: () => void | boolean }[];
    };

    type Modal = {
        element: globalThis.HTMLDialogElement;
        open(): void;
        close(): void;
        setContent(content: ModalContent): void;
    };

    const defaultIcons: Record<ModalType, string> = {
        info: 'info',
        error: 'error',
        warning: 'warning',
        success: 'check_circle',
    };

    const defaultButtons: ModalContent['buttons'] = [{ label: 'OK', variant: 'primary' }];
    let modalCount = 0;

    function createModal(options: ModalContent & { display?: 'modal' | 'toast'; duration?: number; onClose?: () => void }): Modal {
        const { display = 'modal', duration = 5000 } = options;
        const isToast = display === 'toast';
        const titleId = `modal-title-${++modalCount}`;
        const element = document.createElement('dialog');
        element.className = isToast ? 'modal modal-toast' : 'modal';
        element.setAttribute('aria-labelledby', titleId);
        if (isToast) {
            element.setAttribute('role', 'status');
            element.setAttribute('aria-live', 'polite');
        }

        const content = document.createElement('div');
        const header = document.createElement('div');
        header.className = 'modal-header';
        const icon = document.createElement('span');
        icon.className = 'material-symbols-outlined modal-icon';
        icon.setAttribute('aria-hidden', 'true');
        const title = document.createElement('h2');
        title.className = 'modal-title';
        title.id = titleId;
        header.append(icon, title);

        if (isToast) {
            const closeButton = document.createElement('button');
            closeButton.type = 'button';
            closeButton.className = 'modal-close';
            closeButton.setAttribute('aria-label', 'Dismiss');
            const closeIcon = document.createElement('span');
            closeIcon.className = 'material-symbols-outlined';
            closeIcon.setAttribute('aria-hidden', 'true');
            closeIcon.textContent = 'close';
            closeButton.append(closeIcon);
            closeButton.addEventListener('click', () => element.close());
            header.append(closeButton);
        }

        const body = document.createElement('div');
        body.className = 'modal-body';
        const message = document.createElement('p');
        message.className = 'modal-message';
        body.append(message);
        const footer = document.createElement('div');
        footer.className = 'modal-footer';
        content.append(header, body, footer);
        element.append(content);

        let toastRegion = document.querySelector<globalThis.HTMLElement>('.toast-region');
        if (isToast && !toastRegion) {
            toastRegion = document.createElement('div');
            toastRegion.className = 'toast-region';
            document.body.append(toastRegion);
        }
        (isToast ? toastRegion! : document.body).append(element);

        function focusPrimaryButton() {
            footer.querySelector<globalThis.HTMLButtonElement>('.modal-button-primary')?.focus();
        }

        function setContent({ title: titleText, message: messageText, type = 'info', icon: iconName, buttons = (isToast ? [] : defaultButtons ?? []) }: ModalContent) {
            content.className = `modal-content modal-${type}`;
            icon.textContent = iconName ?? defaultIcons[type];
            title.textContent = titleText;
            message.textContent = messageText;
            footer.replaceChildren(...buttons.map(({ label, variant = 'primary', onClick }) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = `modal-button modal-button-${variant}`;
                button.textContent = label;
                button.addEventListener('click', () => {
                    if (onClick?.() !== false) element.close();
                });
                return button;
            }));
            footer.hidden = buttons.length === 0;
            if (element.open && !isToast) focusPrimaryButton();
        }

        let dismissTimer: ReturnType<typeof globalThis.setTimeout> | undefined;
        function stopDismissTimer() {
            globalThis.clearTimeout(dismissTimer);
            dismissTimer = undefined;
        }
        function startDismissTimer() {
            stopDismissTimer();
            if (isToast && duration > 0 && element.open && !element.matches(':hover, :focus-within')) {
                dismissTimer = globalThis.setTimeout(() => element.close(), duration);
            }
        }

        if (isToast) {
            element.addEventListener('mouseenter', stopDismissTimer);
            element.addEventListener('focusin', stopDismissTimer);
            element.addEventListener('mouseleave', startDismissTimer);
            element.addEventListener('focusout', (event) => {
                if (!(event.relatedTarget instanceof globalThis.Node && element.contains(event.relatedTarget))) startDismissTimer();
            });
        }
        else {
            element.addEventListener('click', (event) => {
                if (event.target === element) element.close();
            });
        }
        element.addEventListener('close', stopDismissTimer);
        if (options.onClose) element.addEventListener('close', options.onClose);
        setContent(options);

        return {
            element,
            open() {
                if (isToast) {
                    if (!element.open) {
                        const previous = document.activeElement;
                        element.show();
                        if (previous instanceof globalThis.HTMLElement && previous !== document.body) previous.focus({ preventScroll: true });
                        if (element.contains(document.activeElement) && document.activeElement instanceof globalThis.HTMLElement) document.activeElement.blur();
                    }
                    startDismissTimer();
                    return;
                }
                if (!element.open) element.showModal();
                focusPrimaryButton();
            },
            close() {
                element.close();
            },
            setContent,
        };
    }

    interface DialogEntry {
        message: string;
        title: string;
        icon?: string;
        type: ModalType;
    }

    // Messages waiting for the error currently on screen to be dismissed
    const pendingErrors: DialogEntry[] = [];
    let pendingNotice: DialogEntry | null = null;
    // Success messages waiting for the error on screen to be dismissed, since a toast would be hidden under the error dialog's backdrop
    const pendingToasts: string[] = [];
    let current: DialogEntry | null = null;
    let modal: Modal | null = null;

    function getModal() {
        modal ??= createModal({
            title: '',
            message: '',
            // Once a message is dismissed, show the next one that was waiting
            onClose: showNextDialog,
        });
        return modal;
    }

    // Label the button "Next" while more messages are waiting
    function toModalContent(entry: DialogEntry): ModalContent {
        const waiting = pendingErrors.length + (pendingNotice ? 1 : 0);
        return {
            ...entry,
            buttons: [{ label: waiting > 0 ? `Next (${waiting} more)` : 'OK' }],
        };
    }

    function renderDialog(entry: DialogEntry) {
        current = entry;
        const appModal = getModal();
        appModal.setContent(toModalContent(entry));
        appModal.open();
    }

    // Show the next waiting message, errors first
    function showNextDialog() {
        current = null;
        const next = pendingErrors.shift() ?? pendingNotice;
        if (next === pendingNotice) pendingNotice = null;
        if (next) {
            renderDialog(next);
        }
        else {
            pendingToasts.splice(0).forEach((message) => showToast(message, { title: 'Success', type: 'success' }));
        }
    }

    // Show a dialog with a message
    function showDialog(message: string, options: { title?: string; icon?: string; type?: ModalType } = {}) {
        const { title = 'Alert', icon, type = 'info' } = options;
        const entry: DialogEntry = { message, title, icon, type };

        // An error on screen must never be overwritten, so anything thatarrives while one is showing waits its turn. Every error is kept; only the latest non-error message is kept, since those are transient status updates.
        if (current?.type === 'error') {
            if (type === 'error') pendingErrors.push(entry);
            else pendingNotice = entry;
            getModal().setContent(toModalContent(current));
            return;
        }

        renderDialog(entry);
    }

    // Show a non-blocking toast that closes itself and keeps focus where the user is
    function showToast(message: string, options: { title?: string; icon?: string; type?: ModalType } = {}) {
        const { title = 'Notice', icon, type = 'info' } = options;
        const toast = createModal({
            display: 'toast',
            title,
            message,
            icon,
            type,
            // Each toast is single-use, so drop it from the page once it closes
            onClose: () => toast.element.remove(),
        });
        toast.open();
    }

    // Show a success message as a non-blocking toast. It never replaces an error dialog; while one is showing, the toast waits for it to close.
    function showSuccessToast(message: string) {
        // A success message ends whatever was in progress, so a status update on screen or waiting (e.g. "Uploading...") is no longer needed. Errors are kept.
        pendingNotice = null;
        if (current && current.type !== 'error') {
            getModal().close();
        }
        else if (current) {
            // Drop the waiting status update from the "Next" count
            getModal().setContent(toModalContent(current));
            pendingToasts.push(message);
            return;
        }

        showToast(message, { title: 'Success', type: 'success' });
    }

    // Success message carried across a navigation, shown once the next page loads
    const pendingSuccessKey = 'pending-success-toast';

    // Show a success toast on the next page the user lands on, for actions that navigate away right after succeeding (e.g. deleting a chat)
    function showSuccessAfterNavigation(message: string) {
        try {
            globalThis.sessionStorage.setItem(pendingSuccessKey, message);
        } catch {
            // Storage unavailable (e.g. blocked site data), so show it now instead
            showSuccessToast(message);
        }
    }

    try {
        const pendingSuccess = globalThis.sessionStorage.getItem(pendingSuccessKey);
        if (pendingSuccess) {
            globalThis.sessionStorage.removeItem(pendingSuccessKey);
            showSuccessToast(pendingSuccess);
        }
    } catch {
        // Storage unavailable, so nothing can be waiting
    }

    function showError(message: string) {
        showDialog(message, { title: 'Error', type: 'error' });
    }

    function showWarning(message: string) {
        showDialog(message, { title: 'Warning', type: 'warning' });
    }

    function showInfo(message: string) {
        showDialog(message, { title: 'Information', type: 'info' });
    }

    function showConfirm(
        message: string,
        options: { title?: string; confirmLabel?: string; cancelLabel?: string; icon?: string; type?: ModalType } = {},
    ): Promise<boolean> {
        const { title = 'Are you sure?', confirmLabel = 'Confirm', cancelLabel = 'Cancel', icon, type = 'warning' } = options;

        return new Promise((resolve) => {
            let confirmed = false;
            const confirmModal = createModal({
                title,
                message,
                icon,
                type,
                buttons: [
                    { label: cancelLabel, variant: 'secondary' },
                    {
                        label: confirmLabel,
                        onClick: () => {
                            confirmed = true;
                        },
                    },
                ],
                onClose: () => {
                    confirmModal.element.remove();
                    resolve(confirmed);
                },
            });
            confirmModal.open();
        });
    }

    function showPrompt(
        message: string,
        options: {
            title?: string;
            confirmLabel?: string;
            cancelLabel?: string;
            icon?: string;
            type?: ModalType;
            inputLabel?: string;
            placeholder?: string;
            maxLength?: number;
        } = {},
    ): Promise<string | null> {
        const { title = 'Are you sure?', confirmLabel = 'Confirm', cancelLabel = 'Cancel', icon, type = 'warning', inputLabel = 'Details (optional)', placeholder, maxLength } = options;

        return new Promise((resolve) => {
            let answer: string | null = null;
            const input = document.createElement('textarea');
            const promptModal = createModal({
                title,
                message,
                icon,
                type,
                buttons: [
                    { label: cancelLabel, variant: 'secondary' },
                    {
                        label: confirmLabel,
                        onClick: () => {
                            answer = input.value.trim();
                        },
                    },
                ],
                onClose: () => {
                    promptModal.element.remove();
                    resolve(answer);
                },
            });

            const inputId = `${promptModal.element.getAttribute('aria-labelledby')}-input`;
            const label = document.createElement('label');
            label.className = 'modal-input-label';
            label.htmlFor = inputId;
            label.textContent = inputLabel;
            input.id = inputId;
            input.className = 'modal-input';
            input.rows = 3;
            if (placeholder) input.placeholder = placeholder;
            if (maxLength) input.maxLength = maxLength;
            promptModal.element.querySelector('.modal-body')?.append(label, input);

            promptModal.open();
            input.focus();
        });
    }

    // Make functions available globally, including to is:inline scripts
    window.showDialog = showDialog;
    window.showToast = showToast;
    window.showError = showError;
    window.showWarning = showWarning;
    window.showSuccess = showSuccessToast;
    window.showSuccessAfterNavigation = showSuccessAfterNavigation;
    window.showInfo = showInfo;
    window.showConfirm = showConfirm;
    window.showPrompt = showPrompt;
</script>
