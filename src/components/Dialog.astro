---
import '@/styles/components/dialog.scss';
---
<script>
    type DialogType = 'info' | 'error' | 'warning' | 'success';

    type DialogContent = {
        title: string;
        message: string;
        type?: DialogType;
        icon?: string;
        buttons?: { label: string; variant?: 'primary' | 'secondary'; onClick?: () => void | boolean }[];
    };

    type Dialog = {
        element: HTMLDialogElement;
        open(): void;
        close(): void;
        setContent(content: DialogContent): void;
    };

    const defaultIcons: Record<DialogType, string> = {
        info: 'info',
        error: 'error',
        warning: 'warning',
        success: 'check_circle',
    };

    const defaultButtons: DialogContent['buttons'] = [{ label: 'OK', variant: 'primary' }];
    let dialogCount = 0;

    function createDialog(options: DialogContent & { display?: 'dialog' | 'toast'; duration?: number; onClose?: () => void }): Dialog {
        const { display = 'dialog', duration = 5000 } = options;
        const isToast = display === 'toast';
        const titleId = `dialog-title-${++dialogCount}`;
        const element = document.createElement('dialog');
        element.className = 'dialog';
        element.dataset.display = display;
        element.setAttribute('aria-labelledby', titleId);
        if (isToast) {
            element.setAttribute('role', 'status');
            element.setAttribute('aria-live', 'polite');
        }

        const content = document.createElement('div');
        const header = document.createElement('div');
        header.className = 'dialog__header';
        const icon = document.createElement('span');
        icon.className = 'material-symbols-outlined dialog__icon';
        icon.setAttribute('aria-hidden', 'true');
        const title = document.createElement('h2');
        title.className = 'dialog__title';
        title.id = titleId;
        header.append(icon, title);

        if (isToast) {
            const closeButton = document.createElement('button');
            closeButton.type = 'button';
            closeButton.className = 'dialog__close';
            closeButton.setAttribute('aria-label', 'Dismiss');
            const closeIcon = document.createElement('span');
            closeIcon.className = 'material-symbols-outlined';
            closeIcon.setAttribute('aria-hidden', 'true');
            closeIcon.textContent = 'close';
            closeButton.append(closeIcon);
            closeButton.addEventListener('click', () => element.close());
            header.append(closeButton);
        }

        const body = document.createElement('div');
        body.className = 'dialog__body';
        const message = document.createElement('p');
        message.className = 'dialog__message';
        body.append(message);
        const footer = document.createElement('div');
        footer.className = 'dialog__footer';
        content.className = 'dialog__content';
        content.append(header, body, footer);
        element.append(content);

        let toastRegion = document.querySelector<HTMLElement>('.toast-region');
        if (isToast && !toastRegion) {
            toastRegion = document.createElement('div');
            toastRegion.className = 'toast-region';
            document.body.append(toastRegion);
        }
        (isToast ? toastRegion! : document.body).append(element);

        function focusPrimaryButton() {
            footer.querySelector<HTMLButtonElement>('.dialog__button[data-variant="primary"]')?.focus();
        }

        function setContent({ title: titleText, message: messageText, type = 'info', icon: iconName, buttons = (isToast ? [] : defaultButtons ?? []) }: DialogContent) {
            content.dataset.type = type;
            icon.textContent = iconName ?? defaultIcons[type];
            title.textContent = titleText;
            message.textContent = messageText;
            footer.replaceChildren(...buttons.map(({ label, variant = 'primary', onClick }) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'dialog__button';
                button.dataset.variant = variant;
                button.textContent = label;
                button.addEventListener('click', () => {
                    if (onClick?.() !== false) element.close();
                });
                return button;
            }));
            footer.hidden = buttons.length === 0;
            if (element.open && !isToast) focusPrimaryButton();
        }

        let dismissTimer: ReturnType<typeof setTimeout> | undefined;
        function stopDismissTimer() {
            clearTimeout(dismissTimer);
            dismissTimer = undefined;
        }
        function startDismissTimer() {
            stopDismissTimer();
            if (isToast && duration > 0 && element.open && !element.matches(':hover, :focus-within')) dismissTimer = setTimeout(() => element.close(), duration);
        }

        if (isToast) {
            element.addEventListener('mouseenter', stopDismissTimer);
            element.addEventListener('focusin', stopDismissTimer);
            element.addEventListener('mouseleave', startDismissTimer);
            element.addEventListener('focusout', e => {
                if (!(e.relatedTarget instanceof Node && element.contains(e.relatedTarget))) startDismissTimer();
            });
        }
        else {
            element.addEventListener('click', e => {
                if (e.target === element) element.close();
            });
        }
        element.addEventListener('close', stopDismissTimer);
        if (options.onClose) element.addEventListener('close', options.onClose);
        setContent(options);

        return {
            element,
            open() {
                if (isToast) {
                    if (!element.open) {
                        const previous = document.activeElement;
                        element.show();
                        if (previous instanceof HTMLElement &&previous !== document.body) previous.focus({ preventScroll: true });
                        if (element.contains(document.activeElement) && document.activeElement instanceof HTMLElement) document.activeElement.blur();
                    }
                    startDismissTimer();
                    return;
                }
                if (!element.open) element.showModal();
                focusPrimaryButton();
            },
            close() {
                element.close();
            },
            setContent,
        };
    }

    interface DialogEntry {
        message: string;
        title: string;
        icon?: string;
        type: DialogType;
    }

    const pendingErrors: DialogEntry[] = [];
    let pendingNotice: DialogEntry | null = null;
    // Success messages waiting for the error on screen to be dismissed, since a toast would be hidden under the error dialog's backdrop
    const pendingToasts: string[] = [];
    let current: DialogEntry | null = null;
    let dialog: Dialog | null = null;

    function getDialog() {
        dialog ??= createDialog({
            title: '',
            message: '',
            onClose: () => {
                current = null;
                const next = pendingErrors.shift() ?? pendingNotice;
                if (next === pendingNotice) pendingNotice = null;
                if (next) renderDialog(next);
                else pendingToasts.splice(0).forEach(message => showToast(message, { title: 'Success', type: 'success' }));
            },
        });
        return dialog;
    }

    function toDialogContent(entry: DialogEntry): DialogContent {
        const waiting = pendingErrors.length + (pendingNotice ? 1 : 0);
        return {
            ...entry,
            buttons: [{ label: waiting > 0 ? `Next (${waiting} more)` : 'OK' }],
        };
    }

    function renderDialog(entry: DialogEntry) {
        current = entry;
        const appDialog = getDialog();
        appDialog.setContent(toDialogContent(entry));
        appDialog.open();
    }

    function showDialog(message: string, options: { title?: string; icon?: string; type?: DialogType } = {}) {
        const { title = 'Alert', icon, type = 'info' } = options;
        const entry: DialogEntry = { message, title, icon, type };

        // An error on screen must never be overwritten, so anything that arrives while one is showing waits its turn. Every error is kept; only the latest non-error message is kept, since those are transient status updates.
        if (current?.type === 'error') {
            if (type === 'error') pendingErrors.push(entry);
            else pendingNotice = entry;
            getDialog().setContent(toDialogContent(current));
            return;
        }

        renderDialog(entry);
    }

    function showToast(message: string, options: { title?: string; icon?: string; type?: DialogType } = {}) {
        const { title = 'Notice', icon, type = 'info' } = options;
        const toast = createDialog({
            display: 'toast',
            title,
            message,
            icon,
            type,
            onClose: () => toast.element.remove(),
        });
        toast.open();
    }

    function showSuccessToast(message: string) {
        // A success message ends whatever was in progress, so a status update on screen or waiting (e.g. "Uploading...") is no longer needed. Errors are kept.
        pendingNotice = null;
        if (current && current.type !== 'error') getDialog().close();
        else if (current) {
            getDialog().setContent(toDialogContent(current));
            pendingToasts.push(message);
            return;
        }

        showToast(message, { title: 'Success', type: 'success' });
    }

    // Success message carried across a navigation, shown once the next page loads
    const pendingSuccessKey = 'pending-success-toast';

    // Show a success toast on the next page the user lands on, for actions that navigate away right after succeeding (e.g. deleting a chat)
    window.showSuccessAfterNavigation = (message: string) => {
        try {
            sessionStorage.setItem(pendingSuccessKey, message);
        } catch {
            // Storage unavailable (e.g. blocked site data), so show it now instead
            showSuccessToast(message);
        }
    };

    try {
        const pendingSuccess = sessionStorage.getItem(pendingSuccessKey);
        if (pendingSuccess) {
            sessionStorage.removeItem(pendingSuccessKey);
            showSuccessToast(pendingSuccess);
        }
    } catch {
        // Storage unavailable, so nothing can be waiting
    }

    window.showError = (message: string, title?: string) => showDialog(message, { title: `Error${title ? `: ${title}` : ''}`, type: 'error' });

    window.showWarning = (message: string, title?: string) => showDialog(message, { title: `Warning${title ? `: ${title}` : ''}`, type: 'warning' });

    window.showInfo = (message: string, title?: string) => showDialog(message, { title: `Information${title ? `: ${title}` : ''}`, type: 'info' });

    window.showConfirm = (
        message: string,
        options: { title?: string; confirmLabel?: string; cancelLabel?: string; icon?: string; type?: DialogType } = {},
    ): Promise<boolean> => {
        const { title = 'Are you sure?', confirmLabel = 'Confirm', cancelLabel = 'Cancel', icon, type = 'warning' } = options;

        return new Promise(resolve => {
            let confirmed = false;
            const confirmDialog = createDialog({
                title,
                message,
                icon,
                type,
                buttons: [
                    { label: cancelLabel, variant: 'secondary' },
                    { label: confirmLabel, onClick: () => confirmed = true },
                ],
                onClose: () => {
                    confirmDialog.element.remove();
                    resolve(confirmed);
                },
            });
            confirmDialog.open();
        });
    };

    window.showPrompt = (
        message: string,
        options: {
            title?: string;
            confirmLabel?: string;
            cancelLabel?: string;
            icon?: string;
            type?: DialogType;
            inputLabel?: string;
            placeholder?: string;
            maxLength?: number;
        } = {},
    ): Promise<string | null> => {
        const { title = 'Are you sure?', confirmLabel = 'Confirm', cancelLabel = 'Cancel', icon, type = 'warning', inputLabel = 'Details (optional)', placeholder, maxLength } = options;

        return new Promise(resolve => {
            let answer: string | null = null;
            const input = document.createElement('textarea');
            const promptDialog = createDialog({
                title,
                message,
                icon,
                type,
                buttons: [
                    { label: cancelLabel, variant: 'secondary' },
                    {
                        label: confirmLabel,
                        onClick: () => { answer = input.value.trim() },
                    },
                ],
                onClose: () => {
                    promptDialog.element.remove();
                    resolve(answer);
                },
            });

            const inputId = `${promptDialog.element.getAttribute('aria-labelledby')}-input`;
            const label = document.createElement('label');
            label.className = 'dialog__input-label';
            label.htmlFor = inputId;
            label.textContent = inputLabel;
            input.id = inputId;
            input.className = 'dialog__input';
            input.rows = 3;
            if (placeholder) input.placeholder = placeholder;
            if (maxLength) input.maxLength = maxLength;
            promptDialog.element.querySelector('.dialog__body')?.append(label, input);

            promptDialog.open();
            input.focus();
        });
    };

    // Make functions available globally, including to is:inline scripts
    window.showDialog = showDialog;
    window.showToast = showToast;
    window.showSuccess = showSuccessToast;
</script>
