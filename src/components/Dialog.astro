---
import '@/styles/components/dialog.scss';
---

<dialog id="app-dialog" class="app-dialog">
    <div class="dialog-content">
        <div class="dialog-header">
            <span class="material-symbols-outlined dialog-icon" aria-hidden="true">info</span>
            <h2 class="dialog-title"></h2>
        </div>
        <div class="dialog-body">
            <p class="dialog-message"></p>
        </div>
        <div class="dialog-footer">
            <button class="dialog-button dialog-button-primary" type="button">
                OK
            </button>
        </div>
    </div>
</dialog>

<script is:inline>
    /**
     * Show a dialog with a message
     * @param {string} message - The message to display
     * @param {object} options - Optional configuration
     * @param {string} options.title - Dialog title (default: 'Alert')
     * @param {string} options.icon - Material icon name (default: 'info')
     * @param {string} options.type - Dialog type: "info", "error", "warning", "success" (default: 'info')
     */
    function showDialog(message, options = {}) {
        const {
            title = 'Alert',
            icon = 'info',
            type = 'info'
        } = options;

        const dialog = document.getElementById('app-dialog');
        if (!dialog) {
            console.error('Dialog element not found');
            return;
        }

        const entry = { message, title, icon, type };

        // An error on screen must never be overwritten, so anything that
        // arrives while one is showing waits its turn. Every error is kept;
        // only the latest non-error message is kept, since those are
        // transient status updates.
        if (dialog.open && currentDialogType === 'error') {
            if (type === 'error') {
                pendingErrors.push(entry);
            } else {
                pendingNotice = entry;
            }
            updateDialogButton(dialog);
            return;
        }

        renderDialog(dialog, entry);
    }

    // Messages waiting for the error currently on screen to be dismissed
    const pendingErrors = [];
    let pendingNotice = null;
    let currentDialogType = null;

    function renderDialog(dialog, { message, title, icon, type }) {
        const dialogContent = dialog.querySelector('.dialog-content');
        const dialogIcon = dialog.querySelector('.dialog-icon');
        const dialogTitle = dialog.querySelector('.dialog-title');
        const dialogMessage = dialog.querySelector('.dialog-message');
        const dialogButton = dialog.querySelector('.dialog-button-primary');

        // Set content
        dialogTitle.textContent = title;
        dialogMessage.textContent = message;
        dialogIcon.textContent = icon;

        // Reset classes and apply type
        dialogContent.className = 'dialog-content';
        dialogContent.classList.add(`dialog-${type}`);

        currentDialogType = type;
        updateDialogButton(dialog);

        // Show dialog
        if (!dialog.open) {
            dialog.showModal();
        }

        // Focus the OK button
        dialogButton.focus();
    }

    /**
     * Label the button "Next" while more messages are waiting
     * @param {HTMLDialogElement} dialog - The app dialog
     */
    function updateDialogButton(dialog) {
        const dialogButton = dialog.querySelector('.dialog-button-primary');
        const waiting = pendingErrors.length + (pendingNotice ? 1 : 0);
        dialogButton.textContent = waiting > 0 ? `Next (${waiting} more)` : 'OK';
    }

    /**
     * Show the next waiting message, errors first
     * @param {HTMLDialogElement} dialog - The app dialog
     */
    function showNextDialog(dialog) {
        currentDialogType = null;
        const next = pendingErrors.shift() ?? pendingNotice;
        if (next === pendingNotice) {
            pendingNotice = null;
        }
        if (next) {
            renderDialog(dialog, next);
        }
    }

    /**
     * Show an error dialog
     * @param {string} message - The error message to display
     */
    function showError(message) {
        showDialog(message, {
            title: 'Error',
            icon: 'error',
            type: 'error'
        });
    }

    /**
     * Show a warning dialog
     * @param {string} message - The warning message to display
     */
    function showWarning(message) {
        showDialog(message, {
            title: 'Warning',
            icon: 'warning',
            type: 'warning'
        });
    }

    /**
     * Show a success dialog
     * @param {string} message - The success message to display
     */
    function showSuccess(message) {
        showDialog(message, {
            title: 'Success',
            icon: 'check_circle',
            type: 'success'
        });
    }

    /**
     * Show an info dialog
     * @param {string} message - The info message to display
     */
    function showInfo(message) {
        showDialog(message, {
            title: 'Information',
            icon: 'info',
            type: 'info'
        });
    }

    // Close dialog when clicking OK button or backdrop
    document.addEventListener('DOMContentLoaded', () => {
        const dialog = document.getElementById('app-dialog');
        if (!dialog) return;

        const closeButton = dialog.querySelector('.dialog-button-primary');

        closeButton?.addEventListener('click', () => {
            dialog.close();
        });

        // Close on backdrop click
        dialog.addEventListener('click', (e) => {
            if (e.target === dialog) {
                dialog.close();
            }
        });

        // Close on Escape key
        dialog.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                dialog.close();
            }
        });

        // Once a message is dismissed, show the next one that was waiting
        dialog.addEventListener('close', () => {
            showNextDialog(dialog);
        });
    });

    // Make functions available globally
    window.showDialog = showDialog;
    window.showError = showError;
    window.showWarning = showWarning;
    window.showSuccess = showSuccess;
    window.showInfo = showInfo;
</script>
