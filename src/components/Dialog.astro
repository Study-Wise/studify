---
import '@/styles/components/modal.scss';
---

<script>
    import { createModal, type Modal, type ModalContent, type ModalType } from '@/lib/modal';

    interface DialogEntry {
        message: string;
        title: string;
        icon?: string;
        type: ModalType;
    }

    // Messages waiting for the error currently on screen to be dismissed
    const pendingErrors: DialogEntry[] = [];
    let pendingNotice: DialogEntry | null = null;
    // Success messages waiting for the error on screen to be dismissed, since
    // a toast would be hidden under the error dialog's backdrop
    const pendingToasts: string[] = [];
    let current: DialogEntry | null = null;
    let modal: Modal | null = null;

    function getModal() {
        modal ??= createModal({
            title: '',
            message: '',
            // Once a message is dismissed, show the next one that was waiting
            onClose: showNextDialog,
        });
        return modal;
    }

    /**
     * Label the button "Next" while more messages are waiting
     * @param entry - The message on screen
     * @returns The modal content for the entry
     */
    function toModalContent(entry: DialogEntry): ModalContent {
        const waiting = pendingErrors.length + (pendingNotice ? 1 : 0);
        return {
            ...entry,
            buttons: [{ label: waiting > 0 ? `Next (${waiting} more)` : 'OK' }],
        };
    }

    function renderDialog(entry: DialogEntry) {
        current = entry;
        const appModal = getModal();
        appModal.setContent(toModalContent(entry));
        appModal.open();
    }

    /**
     * Show the next waiting message, errors first
     */
    function showNextDialog() {
        current = null;
        const next = pendingErrors.shift() ?? pendingNotice;
        if (next === pendingNotice) {
            pendingNotice = null;
        }
        if (next) {
            renderDialog(next);
        }
        else {
            pendingToasts.splice(0).forEach(openToast);
        }
    }

    /**
     * Show a dialog with a message
     * @param message - The message to display
     * @param options - Optional title (default 'Alert'), Material icon name and type (default 'info')
     */
    function showDialog(message: string, options: { title?: string; icon?: string; type?: ModalType } = {}) {
        const { title = 'Alert', icon, type = 'info' } = options;
        const entry: DialogEntry = { message, title, icon, type };

        // An error on screen must never be overwritten, so anything that
        // arrives while one is showing waits its turn. Every error is kept;
        // only the latest non-error message is kept, since those are
        // transient status updates.
        if (current?.type === 'error') {
            if (type === 'error') {
                pendingErrors.push(entry);
            }
            else {
                pendingNotice = entry;
            }
            getModal().setContent(toModalContent(current));
            return;
        }

        renderDialog(entry);
    }

    /**
     * Open a success toast, which takes itself off the page once closed
     * @param message - The message to display
     */
    function openToast(message: string) {
        const toast = createModal({
            title: 'Success',
            message,
            type: 'success',
            display: 'toast',
            onClose: () => toast.element.remove(),
        });
        toast.open();
    }

    /**
     * Show a success message as a non-blocking toast. It never replaces an
     * error dialog; while one is showing, the toast waits for it to close.
     * @param message - The message to display
     */
    function showSuccessToast(message: string) {
        // A success message ends whatever was in progress, so a status update
        // on screen or waiting (e.g. "Uploading...") is no longer needed.
        // Errors are kept.
        pendingNotice = null;
        if (current && current.type !== 'error') {
            getModal().close();
        }
        else if (current) {
            // Drop the waiting status update from the "Next" count
            getModal().setContent(toModalContent(current));
            pendingToasts.push(message);
            return;
        }

        openToast(message);
    }

    // Make functions available globally, including to is:inline scripts
    window.showDialog = showDialog;
    window.showError = (message) => showDialog(message, { title: 'Error', type: 'error' });
    window.showWarning = (message) => showDialog(message, { title: 'Warning', type: 'warning' });
    window.showSuccess = showSuccessToast;
    window.showInfo = (message) => showDialog(message, { title: 'Information', type: 'info' });
</script>
