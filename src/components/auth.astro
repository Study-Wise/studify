---
import Layout from '../layouts/Layout.astro';
import { SignIn, SignUp } from '@clerk/astro/components';
import '../styles/pages/auth.scss'

const { page } = Astro.props;

// Get the redirect URL from query parameters, returnBackUrl, or referrer, fallback to home
const redirectUrl = Astro.url.searchParams.get('redirect_url')  || 
                    Astro.url.searchParams.get('returnBackUrl') || 
                    Astro.request.headers .get('referer')       || 
                    '/';

const appearance = {
    elements: {
        formButtonPrimary: 'auth-button',
        card: 'auth-card',
        headerTitle: 'auth-title',
        headerSubtitle: 'auth-subtitle',
        socialButtonsBlockButton: 'social-button',
        socialButtonsBlockButtonText: 'social-button-text',
        formFieldInput: 'form-input',
        formFieldLabel: 'form-label',
        footerActionLink: 'footer-link'
    }
};

const pathName = page.toLowerCase().replaceAll(' ', '-');

// Dynamically select the component
const Component = page === 'Sign In' ? SignIn : SignUp;

// Component props
const componentProps = {
    appearance,
    routing: "path" as const,
    path: `/user/${pathName}`,
    signUpUrl: "/user/sign-up",
    signInUrl: "/user/sign-in",
    forceRedirectUrl: `/user/sign-in/sso-callback?redirect_url=${encodeURIComponent(redirectUrl)}`
};
---

<Layout title={page} className="auth-page">
    <Component {...componentProps} />
</Layout>