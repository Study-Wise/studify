---
import '../../styles/components/header.scss';

import Nav from '../Nav.astro';
import getAllSitePages from '../../lib/getAllSitePages';

const user = Astro.locals.user;
const userId = user?.id || null;
const pages = getAllSitePages(userId);
---
<!-- Container wraps text and nav -->
<div class="header-content-wrapper lite">
    <div class="header-text-container">
        <h1><span class="material-symbols-outlined">school</span> StudyWise</h1>
    </div>
    <Nav mode="lite" pages={pages} />
</div>
