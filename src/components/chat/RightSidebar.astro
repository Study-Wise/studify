---
import '../../styles/components/chat/right-sidebar.scss';
import type { ChatRightSidebarProps } from '../../lib/types';

const { hasReferenceSheet, hasStudyGuide, hasInfographic, hasWebpage, threadId, category, mode } = Astro.props as ChatRightSidebarProps;

const referenceSheetUrl = `/${category}/${mode}/reference-sheet/${threadId}`;
const studyGuideUrl = `/${category}/${mode}/study-guide/${threadId}`;
const infographicUrl = `/${category}/${mode}/infographic/${threadId}`;
const webpageUrl = `/${category}/${mode}/webpage/${threadId}`;
---
<aside class="chat-right-sidebar">
    <div class="chat-right-sidebar-content">
        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">description</span>
                    <h3>Reference Sheet</h3>
                </div>
                {hasReferenceSheet && (
                    <button class="regenerate-btn" id="regenerate-reference-sheet-btn" title="Regenerate reference sheet" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasReferenceSheet ? (
                    <a href={referenceSheetUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Full Reference Sheet</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No reference sheet generated yet.</p>
                        <button class="generate-btn" id="generate-reference-sheet-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">description</span>
                            <span>Generate Reference Sheet</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">menu_book</span>
                    <h3>Study Guide</h3>
                </div>
                {hasStudyGuide && (
                    <button class="regenerate-btn" id="regenerate-study-guide-btn" title="Regenerate study guide" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasStudyGuide ? (
                    <a href={studyGuideUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Full Study Guide</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No study guide generated yet.</p>
                        <button class="generate-btn" id="generate-study-guide-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">menu_book</span>
                            <span>Generate Study Guide</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">image</span>
                    <h3>Infographic</h3>
                </div>
                {hasInfographic && (
                    <button class="regenerate-btn" id="regenerate-infographic-btn" title="Regenerate infographic" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasInfographic ? (
                    <a href={infographicUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Infographic</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No infographic generated yet.</p>
                        <button class="generate-btn" id="generate-infographic-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">add_photo_alternate</span>
                            <span>Generate Infographic</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">web</span>
                    <h3>Webpage</h3>
                </div>
                {hasWebpage && (
                    <button class="regenerate-btn" id="regenerate-webpage-btn" title="Regenerate webpage" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasWebpage ? (
                    <a href={webpageUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Webpage</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No webpage generated yet.</p>
                        <button class="generate-btn" id="generate-webpage-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">web</span>
                            <span>Generate Webpage</span>
                        </button>
                    </div>
                )}
            </div>
        </div>
    </div>
</aside>

<script>
    const generateInfographicBtn = document.getElementById('generate-infographic-btn');
    const generateReferenceSheetBtn = document.getElementById('generate-reference-sheet-btn');
    const generateStudyGuideBtn = document.getElementById('generate-study-guide-btn');
    const generateWebpageBtn = document.getElementById('generate-webpage-btn');
    const regenerateInfographicBtn = document.getElementById('regenerate-infographic-btn');
    const regenerateReferenceSheetBtn = document.getElementById('regenerate-reference-sheet-btn');
    const regenerateStudyGuideBtn = document.getElementById('regenerate-study-guide-btn');
    const regenerateWebpageBtn = document.getElementById('regenerate-webpage-btn');

    async function generateInfographic(threadId: string, isRegenerate: boolean = false) {
        const btn = isRegenerate ? regenerateInfographicBtn : generateInfographicBtn;
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/infographic/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new infographic
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate infographic');
            }
        } catch (error) {
            console.error('Error generating infographic:', error);
            alert(error instanceof Error ? error.message : 'Failed to generate infographic. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    async function generateReferenceSheet(threadId: string, isRegenerate: boolean = false) {
        const btnId = isRegenerate ? 'regenerate-reference-sheet-btn' : 'generate-reference-sheet-btn';
        const btn = document.getElementById(btnId);
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/reference-sheet/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new reference sheet
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate reference sheet');
            }
        } catch (error) {
            console.error('Error generating reference sheet:', error);
            alert(error instanceof Error ? error.message : 'Failed to generate reference sheet. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    async function generateStudyGuide(threadId: string, isRegenerate: boolean = false) {
        const btnId = isRegenerate ? 'regenerate-study-guide-btn' : 'generate-study-guide-btn';
        const btn = document.getElementById(btnId);
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/study-guide/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new study guide
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate study guide');
            }
        } catch (error) {
            console.error('Error generating study guide:', error);
            alert(error instanceof Error ? error.message : 'Failed to generate study guide. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    async function generateWebpage(threadId: string, isRegenerate: boolean = false) {
        const btnId = isRegenerate ? 'regenerate-webpage-btn' : 'generate-webpage-btn';
        const btn = document.getElementById(btnId);
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/webpage/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new webpage
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate webpage');
            }
        } catch (error) {
            console.error('Error generating webpage:', error);
            alert(error instanceof Error ? error.message : 'Failed to generate webpage. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    // Generate buttons
    if (generateInfographicBtn) {
        generateInfographicBtn.addEventListener('click', () => {
            const threadId = generateInfographicBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateInfographic(threadId, false);
            }
        });
    }

    if (generateReferenceSheetBtn) {
        generateReferenceSheetBtn.addEventListener('click', () => {
            const threadId = generateReferenceSheetBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateReferenceSheet(threadId, false);
            }
        });
    }

    if (generateStudyGuideBtn) {
        generateStudyGuideBtn.addEventListener('click', () => {
            const threadId = generateStudyGuideBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateStudyGuide(threadId, false);
            }
        });
    }

    if (generateWebpageBtn) {
        generateWebpageBtn.addEventListener('click', () => {
            const threadId = generateWebpageBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateWebpage(threadId, false);
            }
        });
    }

    // Regenerate buttons
    if (regenerateInfographicBtn) {
        regenerateInfographicBtn.addEventListener('click', () => {
            const threadId = regenerateInfographicBtn.getAttribute('data-thread-id');
            if (threadId) {
                if (confirm('Are you sure you want to regenerate the infographic? This will replace the existing one.')) {
                    generateInfographic(threadId, true);
                }
            }
        });
    }

    if (regenerateReferenceSheetBtn) {
        regenerateReferenceSheetBtn.addEventListener('click', () => {
            const threadId = regenerateReferenceSheetBtn.getAttribute('data-thread-id');
            if (threadId) {
                if (confirm('Are you sure you want to regenerate the reference sheet?')) {
                    generateReferenceSheet(threadId, true);
                }
            }
        });
    }

    if (regenerateStudyGuideBtn) {
        regenerateStudyGuideBtn.addEventListener('click', () => {
            const threadId = regenerateStudyGuideBtn.getAttribute('data-thread-id');
            if (threadId) {
                if (confirm('Are you sure you want to regenerate the study guide?')) {
                    generateStudyGuide(threadId, true);
                }
            }
        });
    }

    if (regenerateWebpageBtn) {
        regenerateWebpageBtn.addEventListener('click', () => {
            const threadId = regenerateWebpageBtn.getAttribute('data-thread-id');
            if (threadId) {
                if (confirm('Are you sure you want to regenerate the webpage? This will replace the existing one.')) {
                    generateWebpage(threadId, true);
                }
            }
        });
    }
</script>

<style>
    .generate-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: var(--primary-color, #007bff);
        color: white;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.2s ease;
        margin-top: 0.5rem;
        width: 100%;
        justify-content: center;
    }

    .generate-btn:hover:not([disabled]) {
        background: var(--primary-hover, #0056b3);
    }

    .generate-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .spinning {
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>
