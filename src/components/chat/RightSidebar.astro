---
import SidebarSection from '@/components/chat/SidebarSection.astro';
import '@/styles/components/chat/sidebar.scss';
import '@/styles/components/chat/right-sidebar.scss';

import { getThreadContentStatus } from '@/lib/content/latest';

export interface ChatRightSidebarProps {
    threadId: string;
    category: string;
    mode: string;
    isAuthorized: boolean;
    isPublic: boolean;
}

const {
    threadId,
    category,
    mode,
    isAuthorized,
    isPublic
} = Astro.props as ChatRightSidebarProps;

const {
    hasReferenceSheet,
    hasStudyGuide,
    hasInfographic,
    hasWebpage,
    hasMindMap,
    hasAdditionalResources,
    hasFlashcards,
    hasPracticeQuestions,
    hasSlideshow,
    hasSummary,
} = await getThreadContentStatus(threadId, isAuthorized, isPublic);

const referenceSheetUrl = `/${category}/${mode}/reference-sheet/${threadId}`;
const studyGuideUrl = `/${category}/${mode}/study-guide/${threadId}`;
const infographicUrl = `/${category}/${mode}/infographic/${threadId}`;
const webpageUrl = `/${category}/${mode}/webpage/${threadId}`;
const mindMapUrl = `/${category}/${mode}/mind-map/${threadId}`;
const additionalResourcesUrl = `/${category}/${mode}/additional-resources/${threadId}`;
const flashcardUrl = `/${category}/${mode}/flashcards/${threadId}`;
const practiceQuestionsUrl = `/${category}/${mode}/practice-questions/${threadId}`;
const slideshowUrl = `/${category}/${mode}/slideshow/${threadId}`;
const summaryUrl = `/${category}/${mode}/summary/${threadId}`;
---
<aside class="chat-sidebar right">
    <div class="chat-sidebar-content right">
        <SidebarSection
            title="Chat Summary"
            icon="summarize"
            hasContent={hasSummary}
            threadId={threadId}
            viewUrl={summaryUrl}
            viewButtonText="View Summary"
            emptyMessage="No summary generated yet."
            id="summary"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Study Guide"
            icon="menu_book"
            hasContent={hasStudyGuide}
            threadId={threadId}
            viewUrl={studyGuideUrl}
            viewButtonText="View Full Study Guide"
            emptyMessage="No study guide generated yet."
            id="study-guide"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Reference Sheet"
            icon="description"
            hasContent={hasReferenceSheet}
            threadId={threadId}
            viewUrl={referenceSheetUrl}
            viewButtonText="View Full Reference Sheet"
            emptyMessage="No reference sheet generated yet."
            id="reference-sheet"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Infographic"
            icon="image"
            hasContent={hasInfographic}
            threadId={threadId}
            viewUrl={infographicUrl}
            viewButtonText="View Infographic"
            emptyMessage="No infographic generated yet."
            id="infographic"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Flashcards"
            icon="style"
            hasContent={hasFlashcards}
            threadId={threadId}
            viewUrl={flashcardUrl}
            viewButtonText="View Flashcards"
            emptyMessage="No flashcards generated yet."
            id="flashcards"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Practice Questions"
            icon="quiz"
            hasContent={hasPracticeQuestions}
            threadId={threadId}
            viewUrl={practiceQuestionsUrl}
            viewButtonText="View Practice Questions"
            emptyMessage="No practice questions generated yet."
            id="practice-questions"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Webpage"
            icon="web"
            hasContent={hasWebpage}
            threadId={threadId}
            viewUrl={webpageUrl}
            viewButtonText="View Webpage"
            emptyMessage="No webpage generated yet."
            id="webpage"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Mind Map"
            icon="hub"
            hasContent={hasMindMap}
            threadId={threadId}
            viewUrl={mindMapUrl}
            viewButtonText="View Mind Map"
            emptyMessage="No mind map generated yet."
            id="mind-map"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Additional Resources"
            icon="travel_explore"
            hasContent={hasAdditionalResources}
            threadId={threadId}
            viewUrl={additionalResourcesUrl}
            viewButtonText="View Resources"
            emptyMessage="No resources found yet."
            id="additional-resources"
            generateVerb="Find"
            regenerateVerb="Find New"
            isAuthorized={isAuthorized}
        />

        <SidebarSection
            title="Slideshow"
            icon="slideshow"
            hasContent={hasSlideshow}
            threadId={threadId}
            viewUrl={slideshowUrl}
            viewButtonText="View Slideshow"
            emptyMessage="No slideshow generated yet."
            id="slideshow"
            isAuthorized={isAuthorized}
        />
    </div>
</aside>
