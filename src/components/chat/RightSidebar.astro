        } catch (error) {
            console.error('Error generating webpage:', error);
            (window as any).showError(error instanceof Error ? error.message : 'Failed to generate webpage. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    // Generate buttons
    if (generateInfographicBtn) {
        generateInfographicBtn.addEventListener('click', () => {
            const threadId = generateInfographicBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateInfographic(threadId, false);
            }
        });
    }

    if (generateReferenceSheetBtn) {
        generateReferenceSheetBtn.addEventListener('click', () => {
            const threadId = generateReferenceSheetBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateReferenceSheet(threadId, false);
            }
        });
    }

    if (generateStudyGuideBtn) {
        generateStudyGuideBtn.addEventListener('click', () => {
            const threadId = generateStudyGuideBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateStudyGuide(threadId, false);
            }
        });
    }

    if (generateWebpageBtn) {
        generateWebpageBtn.addEventListener('click', () => {
            const threadId = generateWebpageBtn.getAttribute('data-thread-id');
            if (threadId) {
                generateWebpage(threadId, false);
            }
        });
    }

    // Regenerate buttons
    if (regenerateInfographicBtn) {
        regenerateInfographicBtn.addEventListener('click', () => {
            const threadId = regenerateInfographicBtn.getAttribute('data-thread-id');
            if (threadId) {
                if (confirm('Are you sure you want to regenerate the infographic? This will replace the existing one.')) {
                    generateInfographic(threadId, true);
                }
            }
        });
    }

    if (regenerateReferenceSheetBtn) {
        regenerateReferenceSheetBtn.addEventListener('click', () => {
            const threadId = regenerateReferenceSheetBtn.getAttribute('data-thread-id');
            if (threadId) {
