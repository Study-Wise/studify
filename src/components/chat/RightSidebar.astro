---
import '../../styles/components/chat/right-sidebar.scss';
import type { ChatRightSidebarProps } from '../../lib/types';

const { hasReferenceSheet, hasStudyGuide, hasInfographic, hasWebpage, hasMindMap, hasResources, hasFlashcard, hasPracticeQuestions, threadId, category, mode, isPublic, isAuthorized } = Astro.props as ChatRightSidebarProps;

const referenceSheetUrl = `/${category}/${mode}/reference-sheet/${threadId}`;
const studyGuideUrl = `/${category}/${mode}/study-guide/${threadId}`;
const infographicUrl = `/${category}/${mode}/infographic/${threadId}`;
const webpageUrl = `/${category}/${mode}/webpage/${threadId}`;
const mindMapUrl = `/${category}/${mode}/mind-map/${threadId}`;
const resourcesUrl = `/${category}/${mode}/resources/${threadId}`;
const flashcardUrl = `/${category}/${mode}/flashcard/${threadId}`;
const practiceQuestionsUrl = `/${category}/${mode}/practice-questions/${threadId}`;
---
<aside class="chat-right-sidebar">
    <div class="chat-right-sidebar-content">
        {isAuthorized && (
            <div class="sidebar-section">
                <div class="section-header">
                    <div class="section-title">
                        <span class="material-symbols-outlined">share</span>
                        <h3>Share Settings</h3>
                    </div>
                </div>
                <div class="section-body">
                    <div class="share-settings">
                        <div class="share-status">
                            <div class="status-info">
                                <span class="status-label">Thread Visibility</span>
                                <span class="status-value" id="share-status-text">{isPublic ? 'Public' : 'Private'}</span>
                            </div>
                            <label class="toggle-switch">
                                <input
                                    type="checkbox"
                                    id="public-toggle"
                                    checked={isPublic}
                                    data-thread-id={threadId}
                                />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        <p class="share-description">
                            {isPublic
                                ? 'This thread is visible to anyone with the link.'
                                : 'This thread is private and only visible to you.'}
                        </p>
                    </div>
                </div>
            </div>
        )}
        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">menu_book</span>
                    <h3>Study Guide</h3>
                </div>
                {hasStudyGuide && (
                    <button class="regenerate-btn" id="regenerate-study-guide-btn" title="Regenerate study guide" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasStudyGuide ? (
                    <a href={studyGuideUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Full Study Guide</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No study guide generated yet.</p>
                        <button class="generate-btn" id="generate-study-guide-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">menu_book</span>
                            <span>Generate Study Guide</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">description</span>
                    <h3>Reference Sheet</h3>
                </div>
                {hasReferenceSheet && (
                    <button class="regenerate-btn" id="regenerate-reference-sheet-btn" title="Regenerate reference sheet" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasReferenceSheet ? (
                    <a href={referenceSheetUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Full Reference Sheet</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No reference sheet generated yet.</p>
                        <button class="generate-btn" id="generate-reference-sheet-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">description</span>
                            <span>Generate Reference Sheet</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">image</span>
                    <h3>Infographic</h3>
                </div>
                {hasInfographic && (
                    <button class="regenerate-btn" id="regenerate-infographic-btn" title="Regenerate infographic" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasInfographic ? (
                    <a href={infographicUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Infographic</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No infographic generated yet.</p>
                        <button class="generate-btn" id="generate-infographic-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">add_photo_alternate</span>
                            <span>Generate Infographic</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">style</span>
                    <h3>Flashcards</h3>
                </div>
                {hasFlashcard && (
                    <button class="regenerate-btn" id="regenerate-flashcard-btn" title="Regenerate flashcards" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasFlashcard ? (
                    <a href={flashcardUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Flashcards</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No flashcards generated yet.</p>
                        <button class="generate-btn" id="generate-flashcard-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">style</span>
                            <span>Generate Flashcards</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">quiz</span>
                    <h3>Practice Questions</h3>
                </div>
                {hasPracticeQuestions && (
                    <button class="regenerate-btn" id="regenerate-practice-questions-btn" title="Regenerate practice questions" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasPracticeQuestions ? (
                    <a href={practiceQuestionsUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Practice Questions</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No practice questions generated yet.</p>
                        <button class="generate-btn" id="generate-practice-questions-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">quiz</span>
                            <span>Generate Practice Questions</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">web</span>
                    <h3>Webpage</h3>
                </div>
                {hasWebpage && (
                    <button class="regenerate-btn" id="regenerate-webpage-btn" title="Regenerate webpage" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasWebpage ? (
                    <a href={webpageUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Webpage</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No webpage generated yet.</p>
                        <button class="generate-btn" id="generate-webpage-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">web</span>
                            <span>Generate Webpage</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">hub</span>
                    <h3>Mind Map</h3>
                </div>
                {hasMindMap && (
                    <button class="regenerate-btn" id="regenerate-mind-map-btn" title="Regenerate mind map" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasMindMap ? (
                    <a href={mindMapUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Mind Map</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No mind map generated yet.</p>
                        <button class="generate-btn" id="generate-mind-map-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">hub</span>
                            <span>Generate Mind Map</span>
                        </button>
                    </div>
                )}
            </div>
        </div>

        <div class="sidebar-section">
            <div class="section-header">
                <div class="section-title">
                    <span class="material-symbols-outlined">travel_explore</span>
                    <h3>Learning Resources</h3>
                </div>
                {hasResources && (
                    <button class="regenerate-btn" id="regenerate-resources-btn" title="Regenerate resources" data-thread-id={threadId}>
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                )}
            </div>
            <div class="section-body">
                {hasResources ? (
                    <a href={resourcesUrl} class="view-full-btn" target="_blank">
                        <span class="material-symbols-outlined">open_in_new</span>
                        <span>View Resources</span>
                    </a>
                ) : (
                    <div class="empty-state">
                        <p class="empty-message">No resources found yet.</p>
                        <button class="generate-btn" id="generate-resources-btn" data-thread-id={threadId}>
                            <span class="material-symbols-outlined">travel_explore</span>
                            <span>Find Resources</span>
                        </button>
                    </div>
                )}
            </div>
        </div>
    </div>
</aside>

<script>
    const generateInfographicBtn = document.getElementById('generate-infographic-btn');
    const generateReferenceSheetBtn = document.getElementById('generate-reference-sheet-btn');
    const generateStudyGuideBtn = document.getElementById('generate-study-guide-btn');
    const generateWebpageBtn = document.getElementById('generate-webpage-btn');
    const generateMindMapBtn = document.getElementById('generate-mind-map-btn');
    const generateResourcesBtn = document.getElementById('generate-resources-btn');
    const generateFlashcardBtn = document.getElementById('generate-flashcard-btn');
    const generatePracticeQuestionsBtn = document.getElementById('generate-practice-questions-btn');
    const regenerateInfographicBtn = document.getElementById('regenerate-infographic-btn');
    const regenerateReferenceSheetBtn = document.getElementById('regenerate-reference-sheet-btn');
    const regenerateStudyGuideBtn = document.getElementById('regenerate-study-guide-btn');
    const regenerateWebpageBtn = document.getElementById('regenerate-webpage-btn');
    const regenerateMindMapBtn = document.getElementById('regenerate-mind-map-btn');
    const regenerateResourcesBtn = document.getElementById('regenerate-resources-btn');
    const regenerateFlashcardBtn = document.getElementById('regenerate-flashcard-btn');
    const regeneratePracticeQuestionsBtn = document.getElementById('regenerate-practice-questions-btn');

    async function generateInfographic(threadId: string, isRegenerate: boolean = false) {
        const btn = isRegenerate ? regenerateInfographicBtn : generateInfographicBtn;
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/infographic/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new infographic
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate infographic');
            }
        } catch (error) {
            console.error('Error generating infographic:', error);
            (window as any).showError(error instanceof Error ? error.message : 'Failed to generate infographic. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    async function generateReferenceSheet(threadId: string, isRegenerate: boolean = false) {
        const btnId = isRegenerate ? 'regenerate-reference-sheet-btn' : 'generate-reference-sheet-btn';
        const btn = document.getElementById(btnId);
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
