---
import '../../styles/components/chat/sidebar.scss';
import '../../styles/components/chat/right-sidebar.scss';
import type { ChatRightSidebarProps } from '../../lib/types';
import SidebarSection from './SidebarSection.astro';

const { hasReferenceSheet, hasStudyGuide, hasInfographic, hasWebpage, hasMindMap, hasResources, hasFlashcard, hasPracticeQuestions, threadId, category, mode } = Astro.props as ChatRightSidebarProps;

const referenceSheetUrl = `/${category}/${mode}/reference-sheet/${threadId}`;
const studyGuideUrl = `/${category}/${mode}/study-guide/${threadId}`;
const infographicUrl = `/${category}/${mode}/infographic/${threadId}`;
const webpageUrl = `/${category}/${mode}/webpage/${threadId}`;
const mindMapUrl = `/${category}/${mode}/mind-map/${threadId}`;
const resourcesUrl = `/${category}/${mode}/resources/${threadId}`;
const flashcardUrl = `/${category}/${mode}/flashcard/${threadId}`;
const practiceQuestionsUrl = `/${category}/${mode}/practice-questions/${threadId}`;
---
<aside class="chat-right-sidebar">
    <div class="chat-right-sidebar-content">
        <SidebarSection
            title="Study Guide"
            icon="menu_book"
            hasContent={hasStudyGuide}
            threadId={threadId}
            viewUrl={studyGuideUrl}
            viewButtonText="View Full Study Guide"
            emptyMessage="No study guide generated yet."
            id="study-guide"
        />

        <SidebarSection
            title="Reference Sheet"
            icon="description"
            hasContent={hasReferenceSheet}
            threadId={threadId}
            viewUrl={referenceSheetUrl}
            viewButtonText="View Full Reference Sheet"
            emptyMessage="No reference sheet generated yet."
            id="reference-sheet"
        />

        <SidebarSection
            title="Infographic"
            icon="image"
            hasContent={hasInfographic}
            threadId={threadId}
            viewUrl={infographicUrl}
            viewButtonText="View Infographic"
            emptyMessage="No infographic generated yet."
            id="infographic"
        />

        <SidebarSection
            title="Flashcards"
            icon="style"
            hasContent={hasFlashcard}
            threadId={threadId}
            viewUrl={flashcardUrl}
            viewButtonText="View Flashcards"
            emptyMessage="No flashcards generated yet."
            id="flashcard"
        />

        <SidebarSection
            title="Practice Questions"
            icon="quiz"
            hasContent={hasPracticeQuestions}
            threadId={threadId}
            viewUrl={practiceQuestionsUrl}
            viewButtonText="View Practice Questions"
            emptyMessage="No practice questions generated yet."
            id="practice-questions"
        />

        <SidebarSection
            title="Webpage"
            icon="web"
            hasContent={hasWebpage}
            threadId={threadId}
            viewUrl={webpageUrl}
            viewButtonText="View Webpage"
            emptyMessage="No webpage generated yet."
            id="webpage"
            ="Generate Webpage"
        />

        <SidebarSection
            title="Mind Map"
            icon="hub"
            hasContent={hasMindMap}
            threadId={threadId}
            viewUrl={mindMapUrl}
            viewButtonText="View Mind Map"
            emptyMessage="No mind map generated yet."
            id="mind-map"
        />

        <SidebarSection
            title="Learning Resources"
            icon="travel_explore"
            hasContent={hasResources}
            threadId={threadId}
            viewUrl={resourcesUrl}
            viewButtonText="View Resources"
            emptyMessage="No resources found yet."
            id="resources"
        />
    </div>
</aside>
