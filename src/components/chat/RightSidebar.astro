        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/reference-sheet/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new reference sheet
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate reference sheet');
            }
        } catch (error) {
            console.error('Error generating reference sheet:', error);
            (window as any).showError(error instanceof Error ? error.message : 'Failed to generate reference sheet. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
