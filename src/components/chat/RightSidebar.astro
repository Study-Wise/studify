    async function generatePracticeQuestions(threadId: string, isRegenerate: boolean = false) {
        const btnId = isRegenerate ? 'regenerate-practice-questions-btn' : 'generate-practice-questions-btn';
        const btn = document.getElementById(btnId);
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${isRegenerate ? 'Regenerating...' : 'Generating...'}</span>`;

        try {
            const response = await fetch('/api/practice-questions/generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Reload the page to show the new practice questions
                window.location.reload();
            } else {
                throw new Error(data.error || 'Failed to generate practice questions');
            }
        } catch (error) {
            console.error('Error generating practice questions:', error);
            (window as any).showError(error instanceof Error ? error.message : 'Failed to generate practice questions. Please try again.');

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    // Generate practice questions button
    if (generatePracticeQuestionsBtn) {
        generatePracticeQuestionsBtn.addEventListener('click', () => {
            const threadId = generatePracticeQuestionsBtn.getAttribute('data-thread-id');
            if (threadId) {
                generatePracticeQuestions(threadId, false);
            }
        });
    }

    // Regenerate practice questions button
    if (regeneratePracticeQuestionsBtn) {
        regeneratePracticeQuestionsBtn.addEventListener('click', () => {
            const threadId = regeneratePracticeQuestionsBtn.getAttribute('data-thread-id');
            if (threadId) {
                if (confirm('Are you sure you want to regenerate the practice questions? This will replace the existing ones.')) {
                    generatePracticeQuestions(threadId, true);
                }
            }
        });
    }

    // Public toggle functionality
    const publicToggle = document.getElementById('public-toggle') as HTMLInputElement;
    const shareStatusText = document.getElementById('share-status-text');

    if (publicToggle) {
        publicToggle.addEventListener('change', async () => {
            const threadId = publicToggle.getAttribute('data-thread-id');
            const isPublic = publicToggle.checked;

            if (!threadId) return;

            // Disable toggle during request
            publicToggle.disabled = true;

            try {
                const response = await fetch('/api/thread/toggle-public', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ threadId, isPublic }),
                });

                const data = await response.json();

                if (data.status === 'success') {
                    // Update the status text
                    if (shareStatusText) {
                        shareStatusText.textContent = isPublic ? 'Public' : 'Private';
                    }

                    // Update the description
                    const shareDescription = document.querySelector('.share-description');
                    if (shareDescription) {
                        shareDescription.textContent = isPublic
                            ? 'This thread is visible to anyone with the link.'
                            : 'This thread is private and only visible to you.';
                    }

                    // Show success message
                    (window as any).showSuccess?.(
                        isPublic
                            ? 'Thread is now public. Anyone with the link can view it.'
                            : 'Thread is now private. Only you can view it.'
                    );
                } else {
                    throw new Error(data.error || 'Failed to update sharing settings');
                }
            } catch (error) {
                console.error('Error toggling public status:', error);
                (window as any).showError?.(
                    error instanceof Error ? error.message : 'Failed to update sharing settings. Please try again.'
                );

                // Revert toggle state on error
                publicToggle.checked = !isPublic;
            } finally {
                // Re-enable toggle
                publicToggle.disabled = false;
            }
        });
    }
</script>
