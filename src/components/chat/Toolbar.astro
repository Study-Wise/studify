---
import '../../styles/components/chat/toolbar.scss';

const { additionalClasses = [] } = Astro.props;
---
<div class={`chat-toolbar ${additionalClasses.join(' ')}`}>
    <div id="error-message" class="error-box" style="display: none" role="alert"></div>

    <div class="chat-input-container">
        <div id="chat-form" class="chat-form">
            <div class="input-wrapper">
                <textarea id="message-input" name="message" placeholder="Type your message here..." rows="1" class="message-input" required />
                <button class="send-button" aria-label="Send message" disabled>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>
