---
interface Props {
    title: string;
    icon: string;
    hasContent: boolean;
    threadId: string;
    viewUrl?: string;
    viewButtonText?: string;
    emptyMessage?: string;
    id: string;
    generateVerb?: string; // e.g., "Generate", "Find", "Create" (default: 'Generate')
    regenerateVerb?: string; // e.g., "Regenerate", "Find New", "Recreate" (default: 'Regenerate')
    isAuthorized?: boolean;
    canRegenerate?: boolean; // false for sections whose content isn't generated (default: true)
}

const {
    title,
    icon,
    hasContent,
    threadId,
    viewUrl,
    viewButtonText,
    emptyMessage,
    id,
    generateVerb = 'Generate',
    regenerateVerb = 'Regenerate',
    isAuthorized = true,
    canRegenerate = true,
} = Astro.props;

const generateButtonId = `generate-${id}-btn`;
const regenerateButtonId = `regenerate-${id}-btn`;

---
<div class="sidebar-section">
    <div class="section-header">
        <div class="section-title">
            <span class="material-symbols-outlined" aria-hidden="true">{icon}</span>
            <h3>{title}</h3>
        </div>
        {hasContent && isAuthorized && canRegenerate && (
            <button type="button" class="regenerate-btn" id={regenerateButtonId} title={`Regenerate ${title}`} aria-label={`Regenerate ${title}`} data-thread-id={threadId}>
                <span class="material-symbols-outlined" aria-hidden="true">refresh</span>
            </button>
        )}
    </div>
    <div class="section-body">
        {Astro.slots.has('content') ? (
            <slot name="content" />
        ) : hasContent ? (
            <a href={viewUrl} class="view-full-btn" target="_blank">
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                <span>{viewButtonText}</span>
            </a>
        ) : (
            <div class="empty-state">
                {emptyMessage && <p class="empty-message">{emptyMessage}</p>}
                {isAuthorized && (
                    <button type="button" class="generate-btn" id={generateButtonId} data-thread-id={threadId} disabled={threadId === 'new'}>
                        <span class="material-symbols-outlined" aria-hidden="true">{icon}</span>
                        <span>{`${generateVerb} ${title}`}</span>
                    </button>
                )}
                {isAuthorized && threadId === 'new' && (
                    <p class="empty-message">Send a message first.</p>
                )}
            </div>
        )}
    </div>
</div>

<script is:inline define:vars={{ generateButtonId, regenerateButtonId, title, id, generateVerb, regenerateVerb, viewUrl, viewButtonText, threadId, canRegenerate }}>
    // Extract the feature type from the button ID (e.g., "generate-study-guide-btn" -> "study-guide")
    const apiEndpoint = `/api/${id}/generate`;

    const generateBtn = document.getElementById(generateButtonId);
    let regenerateBtn = document.getElementById(regenerateButtonId);

    function updateSectionToShowContent() {
        const section = generateBtn?.closest('.sidebar-section') || regenerateBtn?.closest('.sidebar-section');
        if (!section) return;

        const sectionBody = section.querySelector('.section-body');
        const sectionHeader = section.querySelector('.section-header');

        if (sectionBody) {
            sectionBody.innerHTML = `
                <a href="${viewUrl}" class="view-full-btn" target="_blank">
                    <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                    <span>${viewButtonText}</span>
                </a>
            `;
        }

        if (canRegenerate && sectionHeader && !section.querySelector('.regenerate-btn')) {
            const newRegenerateBtn = document.createElement('button');
            newRegenerateBtn.type = 'button';
            newRegenerateBtn.className = 'regenerate-btn';
            newRegenerateBtn.id = regenerateButtonId;
            newRegenerateBtn.title = `Regenerate ${title}`;
            newRegenerateBtn.setAttribute('aria-label', `Regenerate ${title}`);
            newRegenerateBtn.setAttribute('data-thread-id', threadId);
            newRegenerateBtn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">refresh</span>';
            sectionHeader.appendChild(newRegenerateBtn);

            newRegenerateBtn.addEventListener('click', async () => {
                const confirmMessage = `Are you sure you want to ${regenerateVerb.toLowerCase()} the ${title.toLowerCase()}? This will replace the existing one.`;
                const userPrompt = await window.showPrompt(confirmMessage, { title: `${regenerateVerb} ${title}?`, confirmLabel: regenerateVerb, icon: 'refresh', inputLabel: 'What should change? (optional)', placeholder: 'For example: make it shorter, or add more examples', maxLength: 500 });
                if (userPrompt !== null) {
                    generateContent(threadId, true, newRegenerateBtn, userPrompt);
                }
            });

            regenerateBtn = newRegenerateBtn;
        }
    }

    async function generateContent(tid, isRegenerate = false, btnOverride = null, userPrompt = '') {
        const btn = btnOverride || (isRegenerate ? regenerateBtn : generateBtn);
        if (!btn) return;

        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        const loadingText = `${(isRegenerate ? regenerateVerb : generateVerb).replace(/^(\w+?)e?\b/, '$1ing')}…`;

        btn.innerHTML = `<span class="material-symbols-outlined spinning" aria-hidden="true">progress_activity</span><span>${loadingText}</span>`;

        const startedAt = Date.now();
        const timerLabel = btn.lastElementChild;
        const timer = window.setInterval(() => {
            const seconds = Math.floor((Date.now() - startedAt) / 1000);
            timerLabel.textContent = `${loadingText} ${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
        }, 1000);

        // Generation can take a while, so let the user know the chat stays usable
        window.showToast?.(`You can keep chatting while it runs. It will appear here in the sidebar when it's ready.`, {
            title: `${loadingText.slice(0, -1)} ${title}`,
            icon: 'chat',
        });

        try {
            const response = await fetch(apiEndpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId: tid, userPrompt }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                updateSectionToShowContent();

                // If regenerating, restore the button state
                if (isRegenerate && btn) {
                    btn.removeAttribute('disabled');
                    btn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true">refresh</span>';
                }
            }
            else {
                throw new Error(data.error || `Failed to generate ${title.toLowerCase()}`);
            }
        } catch (error) {
            console.error(`Error generating ${title.toLowerCase()}:`, error);
            window.showError?.(error instanceof Error ? error.message : `Failed to generate ${title.toLowerCase()}. Please try again.`);

            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        } finally {
            window.clearInterval(timer);
        }
    }

    if (generateBtn) {
        generateBtn.addEventListener('click', () => {
            const tid = generateBtn.getAttribute('data-thread-id');
            if (tid) generateContent(tid, false);
        });
    }

    if (regenerateBtn) {
        regenerateBtn.addEventListener('click', async () => {
            const tid = regenerateBtn.getAttribute('data-thread-id');
            if (tid) {
                const confirmMessage = `Are you sure you want to ${regenerateVerb.toLowerCase()} the ${title.toLowerCase()}? This will replace the existing one.`;
                const userPrompt = await window.showPrompt(confirmMessage, { title: `${regenerateVerb} ${title}?`, confirmLabel: regenerateVerb, icon: 'refresh', inputLabel: 'What should change? (optional)', placeholder: 'For example: make it shorter, or add more examples', maxLength: 500 });
                if (userPrompt !== null) {
                    generateContent(tid, true, null, userPrompt);
                }
            }
        });
    }
</script>
