---
export interface SidebarSectionProps {
    title: string;
    icon: string;
    hasContent: boolean;
    threadId: string;
    viewUrl?: string;
    viewButtonText?: string;
    emptyMessage?: string;
    id: string;
    generateVerb?: string; // e.g., "Generate", "Find", "Create" (default: "Generate")
    regenerateVerb?: string; // e.g., "Regenerate", "Find New", "Recreate" (default: "Regenerate")
    isAuthorized?: boolean;
}

const {
    title,
    icon,
    hasContent,
    threadId,
    viewUrl,
    viewButtonText,
    emptyMessage,
    id,
    generateVerb = 'Generate',
    regenerateVerb = 'Regenerate',
    isAuthorized = true,
} = Astro.props as SidebarSectionProps;

const generateButtonId = `generate-${id}-btn`;
const regenerateButtonId = `regenerate-${id}-btn`;

---
<div class="sidebar-section">
    <div class="section-header">
        <div class="section-title">
            <span class="material-symbols-outlined">{icon}</span>
            <h3>{title}</h3>
        </div>
        {hasContent && isAuthorized && (
            <button class="regenerate-btn" id={regenerateButtonId} title={`Regenerate ${title}`} data-thread-id={threadId}>
                <span class="material-symbols-outlined">refresh</span>
            </button>
        )}
    </div>
    <div class="section-body">
        {Astro.slots.has('content') ? (
            <slot name="content" />
        ) : hasContent ? (
            <a href={viewUrl} class="view-full-btn" target="_blank">
                <span class="material-symbols-outlined">open_in_new</span>
                <span>{viewButtonText}</span>
            </a>
        ) : (
            <div class="empty-state">
                {emptyMessage && <p class="empty-message">{emptyMessage}</p>}
                {isAuthorized && (
                    <button class="generate-btn" id={generateButtonId} data-thread-id={threadId}>
                        <span class="material-symbols-outlined">{icon}</span>
                        <span>{`${generateVerb} ${title}`}</span>
                    </button>
                )}
            </div>
        )}
    </div>
</div>

<script is:inline define:vars={{ generateButtonId, regenerateButtonId, title, id, generateVerb, regenerateVerb, viewUrl, viewButtonText, threadId }}>
    // @ts-nocheck - Variables are injected by Astro's define:vars
    // Extract the feature type from the button ID (e.g., "generate-study-guide-btn" -> "study-guide")
    const apiEndpoint = `/api/${id}/generate`;

    const generateBtn = document.getElementById(generateButtonId);
    let regenerateBtn = document.getElementById(regenerateButtonId);

    // Update the section UI to show content exists
    function updateSectionToShowContent() {
        const section = generateBtn?.closest('.sidebar-section') || regenerateBtn?.closest('.sidebar-section');
        if (!section) return;

        const sectionBody = section.querySelector('.section-body');
        const sectionHeader = section.querySelector('.section-header');

        if (sectionBody) {
            // Replace with view button
            sectionBody.innerHTML = `
                <a href="${viewUrl}" class="view-full-btn" target="_blank">
                    <span class="material-symbols-outlined">open_in_new</span>
                    <span>${viewButtonText}</span>
                </a>
            `;
        }

        // Add regenerate button if not present
        if (sectionHeader && !section.querySelector('.regenerate-btn')) {
            const newRegenerateBtn = document.createElement('button');
            newRegenerateBtn.className = 'regenerate-btn';
            newRegenerateBtn.id = regenerateButtonId;
            newRegenerateBtn.title = `Regenerate ${title}`;
            newRegenerateBtn.setAttribute('data-thread-id', threadId);
            newRegenerateBtn.innerHTML = '<span class="material-symbols-outlined">refresh</span>';
            sectionHeader.appendChild(newRegenerateBtn);

            // Attach event listener to new button
            newRegenerateBtn.addEventListener('click', () => {
                const confirmMessage = `Are you sure you want to ${regenerateVerb.toLowerCase()} the ${title.toLowerCase()}? This will replace the existing one.`;
                if (confirm(confirmMessage)) {
                    generateContent(threadId, true, newRegenerateBtn);
                }
            });

            regenerateBtn = newRegenerateBtn;
        }
    }

    async function generateContent(tid, isRegenerate = false, btnOverride = null) {
        const btn = btnOverride || (isRegenerate ? regenerateBtn : generateBtn);
        if (!btn) return;

        // Disable button and show loading state
        btn.setAttribute('disabled', 'true');
        const originalContent = btn.innerHTML;
        const loadingText = isRegenerate ? `${regenerateVerb}...` : `${generateVerb}...`;

        btn.innerHTML = `<span class="material-symbols-outlined spinning">progress_activity</span><span>${loadingText}</span>`;

        try {
            const response = await fetch(apiEndpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ threadId: tid }),
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Update UI
                updateSectionToShowContent();

                // If regenerating, restore the button state
                if (isRegenerate && btn) {
                    btn.removeAttribute('disabled');
                    btn.innerHTML = '<span class="material-symbols-outlined">refresh</span>';
                }
            }
            else {
                throw new Error(data.error || `Failed to generate ${title.toLowerCase()}`);
            }
        } catch (error) {
            console.error(`Error generating ${title.toLowerCase()}:`, error);
            (window).showError?.(error instanceof Error ? error.message : `Failed to generate ${title.toLowerCase()}. Please try again.`);

            // Restore button state
            btn.removeAttribute('disabled');
            btn.innerHTML = originalContent;
        }
    }

    // Generate button
    if (generateBtn) {
        generateBtn.addEventListener('click', () => {
            const tid = generateBtn.getAttribute('data-thread-id');
            if (tid) {
                generateContent(tid, false);
            }
        });
    }

    // Regenerate button
    if (regenerateBtn) {
        regenerateBtn.addEventListener('click', () => {
            const tid = regenerateBtn.getAttribute('data-thread-id');
            if (tid) {
                const confirmMessage = `Are you sure you want to ${regenerateVerb.toLowerCase()} the ${title.toLowerCase()}? This will replace the existing one.`;

                if (confirm(confirmMessage)) {
                    generateContent(tid, true);
                }
            }
        });
    }
</script>
