---
import type { UploadedFile } from '@/lib/threads';

import SidebarSection from '@/components/chat/SidebarSection.astro';
import '@/styles/components/chat/left-sidebar.scss';
import '@/styles/components/chat/sidebar.scss';

interface Props {
    isPublic: boolean;
    isAuthorized: boolean;
    threadId: string;
    uploadedFiles: UploadedFile[];
    email: string;
    category: string;
    mode: string;
}

const {
    isPublic,
    isAuthorized,
    threadId,
    uploadedFiles = [],
    email = '',
    category = '',
    mode = ''
} = Astro.props;

const hasSavedThread = Boolean(threadId) && threadId !== 'new';
const shareUrl = hasSavedThread ? new URL(`/${category}/${mode}/chat/${threadId}`, Astro.url.origin).href : '';
---
<section class="chat-sidebar left" id="chat-sidebar-left" aria-label="Files and sharing">
    <div class="chat-sidebar-content left">
        <button type="button" class="sidebar-drawer-close" aria-label="Close files and sharing">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        {isAuthorized && (
            <div class="sidebar-section">
                <div class="section-header">
                    <div class="section-title">
                        <span class="material-symbols-outlined" aria-hidden="true">share</span>
                        <h3>Share Settings</h3>
                    </div>
                </div>
                <div class="section-body">
                    <div class="share-settings">
                        <div class="share-status">
                            <div class="status-info">
                                <span class="status-label">Thread Visibility</span>
                                <span class="status-value" id="share-status-text">{isPublic ? 'Public' : 'Private'}</span>
                            </div>
                            <label class="toggle-switch">
                                <input
                                    type="checkbox"
                                    id="public-toggle"
                                    role="switch"
                                    aria-label="Make thread public"
                                    checked={isPublic}
                                />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        <p class="share-description">
                            {isPublic
                                ? 'This thread is visible to anyone signed in with the link.'
                                : 'This thread is private and only visible to you.'}
                        </p>
                        <div class="share-link" id="share-link" hidden={!(isPublic && hasSavedThread)}>
                            <input
                                type="text"
                                id="share-link-input"
                                class="share-link-input"
                                aria-label="Share link"
                                value={shareUrl}
                                readonly
                            />
                            <button type="button" class="share-link-copy" id="share-link-copy">
                                <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
                                <span class="share-link-copy-text">Copy</span>
                            </button>
                        </div>
                        <button type="button" class="delete-chat-button" id="delete-chat-button">
                            <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                            <span>Delete Chat</span>
                        </button>
                    </div>
                </div>
            </div>
        )}
        <SidebarSection
            title="Uploaded Files"
            icon="folder"
            hasContent={uploadedFiles.length > 0}
            threadId={threadId}
            id="files"
            canRegenerate={false}
        >
            <Fragment slot="content">
                {isAuthorized && (
                    <>
                        <label class="upload-button" for="file-upload">
                            <span class="material-symbols-outlined" aria-hidden="true">upload</span>
                            <span>Upload Files</span>
                            <input
                                type="file"
                                id="file-upload"
                                accept=".jpg,.jpe,.jpeg,.png,.gif,.webp,.svg,.bmp,.tif,.tiff,.apng,.pdf,.doc,.docx,.docm,.ppt,.pptx,.pptm,.xls,.xlsx,.xlsm,.vsd,.vsdx,.pub,.eml,.txt,.csv,.html,.md"
                                multiple
                                aria-describedby="upload-limits"
                                style="display: none;"
                            />
                        </label>
                        <p class="upload-limits" id="upload-limits">
                            Images, PDF, Word, PowerPoint, Excel and text files. Max 10 MB per file.
                        </p>
                    </>
                )}
                <div class="file-list" id="file-list">
                    {uploadedFiles.length === 0 ? (
                        <p class="empty-message">No files uploaded yet. Upload files to see them here.</p>
                    ) : (
                        uploadedFiles.map((file) => (
                        <div class="file-item" data-file-key={file.key}>
                            <div class="file-icon">
                                {file.type.startsWith('image/') ? (
                                    <span class="material-symbols-outlined" aria-hidden="true">image</span>
                                ) : file.type === 'application/pdf' ? (
                                    <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
                                ) : file.type.includes('spreadsheet') || file.type.includes('excel') ? (
                                    <span class="material-symbols-outlined" aria-hidden="true">table_chart</span>
                                ) : file.type.includes('presentation') || file.type.includes('powerpoint') ? (
                                    <span class="material-symbols-outlined" aria-hidden="true">slideshow</span>
                                ) : file.type.includes('word') ? (
                                    <span class="material-symbols-outlined" aria-hidden="true">description</span>
                                ) : (
                                    <span class="material-symbols-outlined" aria-hidden="true">insert_drive_file</span>
                                )}
                            </div>
                            <div class="file-info">
                                <div class="file-name">{file.name}</div>
                                <div class="file-size">{(file.size / 1024).toFixed(1)} KB</div>
                            </div>
                            {isAuthorized && (
                                <button type="button" class="file-delete" data-file-key={file.key} title="Delete file" aria-label="Delete file">
                                    <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                </button>
                            )}
                        </div>
                        ))
                    )}
                </div>
            </Fragment>
        </SidebarSection>
    </div>
</section>

<script is:inline define:vars={{ threadId, email, category, mode }}>
    let currentThreadId = threadId;

    let uploadQueue = [];
    let isUploading = false;

    const publicToggle = document.getElementById('public-toggle');
    const shareStatusText = document.getElementById('share-status-text');
    const shareLink = document.getElementById('share-link');
    const shareLinkInput = document.getElementById('share-link-input');
    const shareLinkCopy = document.getElementById('share-link-copy');

    // Show the share URL only for a saved, public thread
    function updateShareLink() {
        if (!shareLink || !shareLinkInput) return;

        const hasSavedThread = Boolean(currentThreadId) && currentThreadId !== 'new';
        if (hasSavedThread) {
            shareLinkInput.value = `${window.location.origin}/${category}/${mode}/chat/${currentThreadId}`;
        }
        shareLink.hidden = !(hasSavedThread && publicToggle?.checked);
    }

    shareLinkInput?.addEventListener('focus', () => shareLinkInput.select());

    shareLinkCopy?.addEventListener('click', async () => {
        if (!shareLinkInput?.value) return;

        try {
            await globalThis.navigator.clipboard.writeText(shareLinkInput.value);

            const copyIcon = shareLinkCopy.querySelector('.material-symbols-outlined');
            const copyText = shareLinkCopy.querySelector('.share-link-copy-text');
            if (copyIcon) copyIcon.textContent = 'check';
            if (copyText) copyText.textContent = 'Copied';

            globalThis.setTimeout(() => {
                if (copyIcon) copyIcon.textContent = 'content_copy';
                if (copyText) copyText.textContent = 'Copy';
            }, 2000);

            window.showSuccess?.('Share link copied to clipboard');
        } catch (error) {
            console.error('Error copying share link:', error);
            shareLinkInput.select();
            window.showError?.('Could not copy the link. Please copy it manually.');
        }
    });

    if (publicToggle) {
        publicToggle.addEventListener('change', async () => {
            const isPublic = publicToggle.checked;

            // Unsaved thread: only update the label; the first message saves the visibility
            if (!currentThreadId || currentThreadId === 'new') {
                if (shareStatusText) {
                    shareStatusText.textContent = isPublic ? 'Public' : 'Private';
                }

                const shareDescription = document.querySelector('.share-description');
                if (shareDescription) {
                    shareDescription.textContent = isPublic
                        ? 'This thread is visible to anyone signed in with the link.'
                        : 'This thread is private and only visible to you.';
                }
                return;
            }

            publicToggle.disabled = true;

            try {
                const response = await fetch('/api/thread/toggle-public', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ threadId: currentThreadId, isPublic }),
                });

                const data = await response.json();

                if (data.status === 'success') {
                    if (shareStatusText) {
                        shareStatusText.textContent = isPublic ? 'Public' : 'Private';
                    }

                    const shareDescription = document.querySelector('.share-description');
                    if (shareDescription) {
                        shareDescription.textContent = isPublic
                            ? 'This thread is visible to anyone signed in with the link.'
                            : 'This thread is private and only visible to you.';
                    }

                    updateShareLink();

                    window.showSuccess?.(
                        isPublic
                            ? 'Thread is now public. Anyone signed in with the link can view it.'
                            : 'Thread is now private. Only you can view it.'
                    );
                }
                else {
                    throw new Error(data.error || 'Failed to update sharing settings');
                }
            } catch (error) {
                console.error('Error toggling public status:', error);
                window.showError?.(
                    error instanceof Error ? error.message : 'Failed to update sharing settings. Please try again.'
                );

                publicToggle.checked = !isPublic;
                updateShareLink();
            } finally {
                publicToggle.disabled = false;
            }
        });
    }

    // Adopt a thread created by the chat script (e.g. first message sent before uploading)
    window.addEventListener('thread-created', (event) => {
        const { id: createdId, source } = event.detail || {};
        if (source !== 'sidebar' && createdId && currentThreadId === 'new') {
            currentThreadId = createdId;
            updateShareLink();
        }
    });

    const deleteChatButton = document.getElementById('delete-chat-button');

    if (deleteChatButton) {
        deleteChatButton.addEventListener('click', async () => {
            const newChatUrl = `/${category}/${mode}/chat/new`;

            // Nothing persisted yet for an unsaved chat, so just start over
            if (!currentThreadId || currentThreadId === 'new') {
                window.showSuccessAfterNavigation?.('Chat deleted');
                globalThis.location.href = newChatUrl;
                return;
            }

            const chatTitle = document.querySelector('.chat-title-text')?.textContent?.trim() || 'this chat';
            const confirmed = await window.showConfirm(
                'This cannot be undone.',
                { title: `Delete "${chatTitle}"?`, confirmLabel: 'Delete', icon: 'delete' },
            );
            if (!confirmed) return;

            deleteChatButton.disabled = true;
            const originalContent = deleteChatButton.innerHTML;
            deleteChatButton.innerHTML = '<span class="material-symbols-outlined spinning" aria-hidden="true">progress_activity</span><span>Deleting…</span>';

            try {
                const response = await fetch('/api/thread/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ threadId: currentThreadId }),
                });

                const data = await response.json();

                if (data.status === 'success') {
                    window.showSuccessAfterNavigation?.('Chat deleted');
                    globalThis.location.href = newChatUrl;
                }
                else {
                    throw new Error(data.error || 'Failed to delete chat');
                }
            } catch (error) {
                console.error('Error deleting chat:', error);
                window.showError?.(
                    error instanceof Error ? error.message : 'Failed to delete chat. Please try again.'
                );
                deleteChatButton.innerHTML = originalContent;
                deleteChatButton.disabled = false;
            }
        });
    }

    const fileUpload = document.getElementById('file-upload');
    const fileList = document.getElementById('file-list');

    async function ensureThreadExists() {
        if (currentThreadId === 'new') {
            // Use the provider and tier saved on /settings, like the chat script does
            let settings;
            try {
                settings = JSON.parse(globalThis.localStorage.getItem('settings') || '{}') || {};
            } catch {
                settings = {};
            }
            const provider = settings.provider || 'openai';
            const tier = settings.tier || 'default';

            window.showInfo?.('Creating new chat...');

            try {
                const response = await fetch('/api/thread/initialize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ category, mode, provider, tier, isPublic: publicToggle?.checked === true })
                });

                const data = await response.json();

                if (data.status === 'success' && data.id) {
                    currentThreadId = data.id;
                    updateShareLink();

                    // Let the chat script use this thread instead of creating another one
                    window.dispatchEvent(new globalThis.CustomEvent('thread-created', {
                        detail: { id: data.id, source: 'sidebar' }
                    }));

                    const newUrl = `/${category}/${mode}/chat/${data.id}`;
                    window.history.replaceState({}, '', newUrl);
                }
                else {
                    throw new Error(data.error || 'Failed to create thread');
                }
            } catch (error) {
                console.error('Error creating thread:', error);
                window.showError?.(
                    error instanceof Error ? error.message : 'Failed to create chat. Please try again.'
                );
                return null;
            }
        }

        return currentThreadId || null;
    }

    async function processUploadQueue() {
        if (isUploading || uploadQueue.length === 0) return;

        isUploading = true;

        const activeThreadId = await ensureThreadExists();

        if (!activeThreadId || !email || !fileList) {
            isUploading = false;
            uploadQueue = [];
            return;
        }

        while (uploadQueue.length > 0) {
            const file = uploadQueue.shift();
            const remainingCount = uploadQueue.length;

            try {
                const progressMsg = remainingCount > 0
                    ? `Uploading ${file.name}... (${remainingCount} remaining)`
                    : `Uploading ${file.name}...`;
                window.showInfo?.(progressMsg);

                const CHUNK_THRESHOLD = 3.5 * 1024 * 1024; // 3.5MB - under Vercel's 4.5MB limit with overhead
                let data;

                if (file.size <= CHUNK_THRESHOLD) {
                    const formData = new globalThis.FormData();
                    formData.append('file', file);
                    formData.append('threadId', activeThreadId);

                    const response = await fetch('/api/files/upload', {
                        method: 'POST',
                        body: formData
                    });

                    const responseText = await response.text();
                    try {
                        data = JSON.parse(responseText);
                    } catch (error) {
                        throw new Error(`Server error (${response.status}): ${responseText.substring(0, 200)}`, { cause: error });
                    }
                }
                else {
                    const CHUNK_SIZE = 3 * 1024 * 1024; // 3MB chunks
                    const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
                    const uploadId = globalThis.crypto.randomUUID();

                    for (let i = 0; i < totalChunks; i++) {
                        const start = i * CHUNK_SIZE;
                        const end = Math.min(start + CHUNK_SIZE, file.size);
                        const chunk = file.slice(start, end);

                        window.showInfo?.(`Uploading ${file.name}... chunk ${i + 1}/${totalChunks}`);

                        const chunkForm = new globalThis.FormData();
                        chunkForm.append('chunk', chunk);
                        chunkForm.append('uploadId', uploadId);
                        chunkForm.append('chunkIndex', String(i));
                        chunkForm.append('totalChunks', String(totalChunks));
                        chunkForm.append('fileName', file.name);
                        chunkForm.append('fileType', file.type);
                        chunkForm.append('fileSize', String(file.size));
                        chunkForm.append('threadId', activeThreadId);

                        const chunkRes = await fetch('/api/files/upload-chunk', {
                            method: 'POST',
                            body: chunkForm
                        });

                        const chunkText = await chunkRes.text();
                        let chunkData;
                        try {
                            chunkData = JSON.parse(chunkText);
                        } catch (error) {
                            throw new Error(`Server error (${chunkRes.status}): ${chunkText.substring(0, 200)}`, { cause: error });
                        }

                        if (chunkData.status !== 'success') {
                            throw new Error(chunkData.error || 'Chunk upload failed');
                        }
                    }

                    window.showInfo?.(`Processing ${file.name}...`);
                    const completeRes = await fetch('/api/files/upload-complete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ uploadId })
                    });

                    const completeText = await completeRes.text();
                    try {
                        data = JSON.parse(completeText);
                    } catch (error) {
                        throw new Error(`Server error (${completeRes.status}): ${completeText.substring(0, 200)}`, { cause: error });
                    }
                }

                if (data.status === 'success') {
                    const emptyMessage = fileList.querySelector('.empty-message');
                    if (emptyMessage) {
                        emptyMessage.remove();
                    }

                    const fileItem = createFileElement(data.file);
                    fileList.appendChild(fileItem);

                    if (remainingCount === 0) {
                        window.showSuccess?.(`${file.name} uploaded successfully`);
                    }
                }
                else {
                    throw new Error(data.error || 'Upload failed');
                }
            } catch (error) {
                console.error('File upload error:', error);
                window.showError?.(
                    `Failed to upload ${file.name}: ${error instanceof Error ? error.message : 'Unknown error'}`
                );
            }
        }

        isUploading = false;

        if (fileUpload) fileUpload.value = '';
    }

    if (fileUpload && fileList) {
        fileUpload.addEventListener('change', async (e) => {
            const target = e.target;
            const files = target.files;

            if (!files || files.length === 0) return;
            if (!email) return;

            for (let i = 0; i < files.length; i++) {
                uploadQueue.push(files[i]);
            }

            const totalFiles = uploadQueue.length;
            if (totalFiles > 1) {
                window.showInfo?.(`Queued ${totalFiles} files for upload...`);
            }

            processUploadQueue();
        });
    }

    fileList?.addEventListener('click', async (e) => {
        const target = e.target;
        const deleteButton = target.closest('.file-delete');

        if (!deleteButton) return;

        const fileKey = deleteButton.getAttribute('data-file-key');

        if (!fileKey || !currentThreadId || currentThreadId === 'new' || !email) return;

        const fileName = deleteButton.closest('.file-item')?.querySelector('.file-name')?.textContent?.trim() || 'this file';
        const confirmed = await window.showConfirm(
            'This cannot be undone.',
            { title: `Delete "${fileName}"?`, confirmLabel: 'Delete', icon: 'delete' },
        );
        if (!confirmed) return;

        deleteButton.disabled = true;
        const originalContent = deleteButton.innerHTML;
        deleteButton.innerHTML = '<span class="material-symbols-outlined spinning" aria-hidden="true">progress_activity</span>';

        try {
            const response = await fetch('/api/files/delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ threadId: currentThreadId, fileKey })
            });

            const data = await response.json();

            if (data.status === 'success') {
                const fileItem = deleteButton.closest('.file-item');
                fileItem?.remove();

                if (fileList && fileList.children.length === 0) {
                    const emptyMessage = document.createElement('p');
                    emptyMessage.className = 'empty-message';
                    emptyMessage.textContent = 'No files uploaded yet. Upload files to see them here.';
                    fileList.appendChild(emptyMessage);
                }

                window.showSuccess?.('File deleted');
            }
            else {
                throw new Error(data.error || 'Deletion failed');
            }
        } catch (error) {
            console.error('File deletion error:', error);
            window.showError?.(
                error instanceof Error ? error.message : 'Failed to delete file. Please try again.'
            );
            deleteButton.innerHTML = originalContent;
            deleteButton.disabled = false;
        }
    });

    function createFileElement(file) {
        const fileItem = document.createElement('div');
        fileItem.className = 'file-item';
        fileItem.setAttribute('data-file-key', file.key);

        let iconName = 'insert_drive_file';
        if (file.type.startsWith('image/')) {
            iconName = 'image';
        }
        else if (file.type === 'application/pdf') {
            iconName = 'picture_as_pdf';
        }
        else if (file.type.includes('spreadsheet') || file.type.includes('excel')) {
            iconName = 'table_chart';
        }
        else if (file.type.includes('presentation') || file.type.includes('powerpoint')) {
            iconName = 'slideshow';
        }
        else if (file.type.includes('word')) {
            iconName = 'description';
        }

        fileItem.innerHTML = `
            <div class="file-icon">
                <span class="material-symbols-outlined" aria-hidden="true">${iconName}</span>
            </div>
            <div class="file-info">
                <div class="file-name">${file.name}</div>
                <div class="file-size">${(file.size / 1024).toFixed(1)} KB</div>
            </div>
            <button type="button" class="file-delete" data-file-key="${file.key}" title="Delete file" aria-label="Delete file">
                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
            </button>
        `;

        return fileItem;
    }
</script>
