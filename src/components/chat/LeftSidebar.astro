---
import '@/styles/components/chat/sidebar.scss';
import '@/styles/components/chat/left-sidebar.scss';
import type { ChatLeftSidebarProps } from '@/lib/types';
import SidebarSection from './SidebarSection.astro';

const {
    isPublic,
    isAuthorized,
    threadId,
    uploadedFiles = [],
    email = '',
    category = '',
    mode = ''
} = Astro.props as ChatLeftSidebarProps;
---
<section class="chat-sidebar left">
    <div class="chat-sidebar-content left">
        {isAuthorized && (
            <div class="sidebar-section">
                <div class="section-header">
                    <div class="section-title">
                        <span class="material-symbols-outlined">share</span>
                        <h3>Share Settings</h3>
                    </div>
                </div>
                <div class="section-body">
                    <div class="share-settings">
                        <div class="share-status">
                            <div class="status-info">
                                <span class="status-label">Thread Visibility</span>
                                <span class="status-value" id="share-status-text">{isPublic ? 'Public' : 'Private'}</span>
                            </div>
                            <label class="toggle-switch">
                                <input
                                    type="checkbox"
                                    id="public-toggle"
                                    checked={isPublic}
                                />
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        <p class="share-description">
                            {isPublic
                                ? 'This thread is visible to anyone with the link.'
                                : 'This thread is private and only visible to you.'}
                        </p>
                    </div>
                </div>
            </div>
        )}
        <SidebarSection
            title="Uploaded Files"
            icon="folder"
            hasContent={uploadedFiles.length > 0}
            threadId={threadId}
            id="files"
        >
            <Fragment slot="content">
                {isAuthorized && (
                    <label class="upload-button" for="file-upload">
                        <span class="material-symbols-outlined">upload</span>
                        <span>Upload Files</span>
                        <input
                            type="file"
                            id="file-upload"
                            accept=".jpg,.jpe,.jpeg,.png,.gif,.webp,.svg,.bmp,.tif,.tiff,.apng,.pdf,.doc,.docx,.docm,.ppt,.pptx,.pptm,.xls,.xlsx,.xlsm,.vsd,.vsdx,.pub,.eml,.txt,.csv,.html,.md"
                            multiple
                            style="display: none;"
                        />
                    </label>
                )}
                <div class="file-list" id="file-list">
                    {uploadedFiles.length === 0 ? (
                        <p class="empty-message">No files uploaded yet. Upload files to see them here.</p>
                    ) : (
                        uploadedFiles.map((file) => (
                        <div class="file-item" data-file-key={file.key}>
                            <div class="file-icon">
                                {file.type.startsWith('image/') ? (
                                    <span class="material-symbols-outlined">image</span>
                                ) : file.type === 'application/pdf' ? (
                                    <span class="material-symbols-outlined">picture_as_pdf</span>
                                ) : file.type.includes('spreadsheet') || file.type.includes('excel') ? (
                                    <span class="material-symbols-outlined">table_chart</span>
                                ) : file.type.includes('presentation') || file.type.includes('powerpoint') ? (
                                    <span class="material-symbols-outlined">slideshow</span>
                                ) : file.type.includes('word') ? (
                                    <span class="material-symbols-outlined">description</span>
                                ) : (
                                    <span class="material-symbols-outlined">insert_drive_file</span>
                                )}
                            </div>
                            <div class="file-info">
                                <div class="file-name">{file.name}</div>
                                <div class="file-size">{(file.size / 1024).toFixed(1)} KB</div>
                            </div>
                            {isAuthorized && (
                                <button class="file-delete" data-file-key={file.key} title="Delete file">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            )}
                        </div>
                        ))
                    )}
                </div>
            </Fragment>
        </SidebarSection>
    </div>
</section>

<script is:inline define:vars={{ threadId, email, category, mode }}>
    // State that can be updated
    let currentThreadId = threadId;

    // Upload queue state
    let uploadQueue = [];
    let isUploading = false;

    // Public toggle functionality
    const publicToggle = document.getElementById('public-toggle');
    const shareStatusText = document.getElementById('share-status-text');

    if (publicToggle) {
        publicToggle.addEventListener('change', async () => {
            const isPublic = publicToggle.checked;

            if (!currentThreadId || currentThreadId === 'new') return;

            // Disable toggle during request
            publicToggle.disabled = true;

            try {
                const response = await fetch('/api/thread/toggle-public', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ threadId: currentThreadId, isPublic }),
                });

                const data = await response.json();

                if (data.status === 'success') {
                    // Update the status text
                    if (shareStatusText) {
                        shareStatusText.textContent = isPublic ? 'Public' : 'Private';
                    }

                    // Update the description
                    const shareDescription = document.querySelector('.share-description');
                    if (shareDescription) {
                        shareDescription.textContent = isPublic
                            ? 'This thread is visible to anyone with the link.'
                            : 'This thread is private and only visible to you.';
                    }

                    // Show success message
                    window.showSuccess?.(
                        isPublic
                            ? 'Thread is now public. Anyone with the link can view it.'
                            : 'Thread is now private. Only you can view it.'
                    );
                } else {
                    throw new Error(data.error || 'Failed to update sharing settings');
                }
            } catch (error) {
                console.error('Error toggling public status:', error);
                window.showError?.(
                    error instanceof Error ? error.message : 'Failed to update sharing settings. Please try again.'
                );

                // Revert toggle state on error
                publicToggle.checked = !isPublic;
            } finally {
                // Re-enable toggle
                publicToggle.disabled = false;
            }
        });
    }

    // File upload functionality
    const fileUpload = document.getElementById('file-upload');
    const fileList = document.getElementById('file-list');

    async function ensureThreadExists() {
        // If threadId is "new", create a new thread first
        if (currentThreadId === 'new') {
            const model = localStorage.getItem('model') || 'gpt-4.1';

            window.showInfo?.('Creating new chat...');

            try {
                const response = await fetch('/api/thread/initialize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ category, mode, model })
                });

                const data = await response.json();

                if (data.status === 'success' && data.id) {
                    currentThreadId = data.id;

                    // Update the URL without reloading
                    const newUrl = `/${category}/${mode}/chat/${data.id}`;
                    window.history.replaceState({}, '', newUrl);
                } else {
                    throw new Error(data.error || 'Failed to create thread');
                }
            } catch (error) {
                console.error('Error creating thread:', error);
                window.showError?.(
                    error instanceof Error ? error.message : 'Failed to create chat. Please try again.'
                );
                return null;
            }
        }

        return currentThreadId || null;
    }

    async function processUploadQueue() {
        if (isUploading || uploadQueue.length === 0) return;

        isUploading = true;

        // Ensure thread exists before uploading
        const activeThreadId = await ensureThreadExists();

        if (!activeThreadId || !email || !fileList) {
            isUploading = false;
            uploadQueue = [];
            return;
        }

        while (uploadQueue.length > 0) {
            const file = uploadQueue.shift();
            const remainingCount = uploadQueue.length;

            try {
                // Show progress
                const progressMsg = remainingCount > 0
                    ? `Uploading ${file.name}... (${remainingCount} remaining)`
                    : `Uploading ${file.name}...`;
                window.showInfo?.(progressMsg);

                const formData = new FormData();
                formData.append('file', file);
                formData.append('threadId', activeThreadId);
                formData.append('email', email);

                const response = await fetch('/api/files/upload', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.status === 'success') {
                    // Remove empty message if it exists
                    const emptyMessage = fileList.querySelector('.empty-message');
                    if (emptyMessage) {
                        emptyMessage.remove();
                    }

                    // Add new file to the list
                    const fileItem = createFileElement(data.file);
                    fileList.appendChild(fileItem);

                    // Show success for this file
                    if (remainingCount === 0) {
                        window.showSuccess?.(`${file.name} uploaded successfully`);
                    }
                } else {
                    throw new Error(data.error || 'Upload failed');
                }
            } catch (error) {
                console.error('File upload error:', error);
                window.showError?.(
                    `Failed to upload ${file.name}: ${error instanceof Error ? error.message : 'Unknown error'}`
                );
            }
        }

        isUploading = false;

        // Reset input
        if (fileUpload) {
            fileUpload.value = '';
        }
    }

    if (fileUpload && fileList) {
        fileUpload.addEventListener('change', async (e) => {
            const target = e.target;
            const files = target.files;

            if (!files || files.length === 0) return;
            if (!email) return;

            // Add all files to the queue
            for (let i = 0; i < files.length; i++) {
                uploadQueue.push(files[i]);
            }

            // Show initial message
            const totalFiles = uploadQueue.length;
            if (totalFiles > 1) {
                window.showInfo?.(`Queued ${totalFiles} files for upload...`);
            }

            // Start processing the queue
            processUploadQueue();
        });
    }

    // File delete functionality
    fileList?.addEventListener('click', async (e) => {
        const target = e.target;
        const deleteButton = target.closest('.file-delete');

        if (!deleteButton) return;

        const fileKey = deleteButton.getAttribute('data-file-key');

        if (!fileKey || !currentThreadId || currentThreadId === 'new' || !email) return;

        // Confirm deletion
        if (!confirm('Are you sure you want to delete this file?')) return;

        // Disable button during request
        deleteButton.disabled = true;

        try {
            const response = await fetch('/api/files/delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ threadId: currentThreadId, email, fileKey })
            });

            const data = await response.json();

            if (data.status === 'success') {
                // Remove file from UI
                const fileItem = deleteButton.closest('.file-item');
                fileItem?.remove();

                // Show empty message if no files left
                if (fileList && fileList.children.length === 0) {
                    const emptyMessage = document.createElement('p');
                    emptyMessage.className = 'empty-message';
                    emptyMessage.textContent = 'No files uploaded yet. Upload files to see them here.';
                    fileList.appendChild(emptyMessage);
                }

                window.showSuccess?.('File deleted successfully');
            } else {
                throw new Error(data.error || 'Deletion failed');
            }
        } catch (error) {
            console.error('File deletion error:', error);
            window.showError?.(
                error instanceof Error ? error.message : 'Failed to delete file. Please try again.'
            );
            deleteButton.disabled = false;
        }
    });

    // Helper function to create file element
    function createFileElement(file) {
        const fileItem = document.createElement('div');
        fileItem.className = 'file-item';
        fileItem.setAttribute('data-file-key', file.key);

        let iconName = 'insert_drive_file';
        if (file.type.startsWith('image/')) {
            iconName = 'image';
        } else if (file.type === 'application/pdf') {
            iconName = 'picture_as_pdf';
        } else if (file.type.includes('spreadsheet') || file.type.includes('excel')) {
            iconName = 'table_chart';
        } else if (file.type.includes('presentation') || file.type.includes('powerpoint')) {
            iconName = 'slideshow';
        } else if (file.type.includes('word')) {
            iconName = 'description';
        }

        fileItem.innerHTML = `
            <div class="file-icon">
                <span class="material-symbols-outlined">${iconName}</span>
            </div>
            <div class="file-info">
                <div class="file-name">${file.name}</div>
                <div class="file-size">${(file.size / 1024).toFixed(1)} KB</div>
            </div>
            <button class="file-delete" data-file-key="${file.key}" title="Delete file">
                <span class="material-symbols-outlined">delete</span>
            </button>
        `;

        return fileItem;
    }
</script>
