---
const contentTypeName = Astro.routePattern.split('/')[3].replace(/-/g, ' ');
---
<div class="empty-state">
    <span class="material-symbols-outlined" aria-hidden="true">lock</span>
    <h2>Access Denied</h2>
    <p>You don't have permission to view the {contentTypeName}.</p>
    <a href="/" class="btn" data-variant="primary">Go Home</a>
</div>
